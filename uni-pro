function inspectorStatusText(row){
  if(row.parseOk === false) return "Imported amount needs correction";
  if(rowNeedsTaxReconcileAdjustment(row)) return "Federal tax amount or Tax less Book adjustment required";
  if(rowNeedsFsaTaxAmount(row)) return fsaBookTaxResponseIssue(row) || fsaManualSupplementIssue(row) || "Federal tax support required";
  if(fsaAdditionalCostCharacterizationIssue(row)) return "Additional-cost characterization required";
  if(rowNeedsFsaNegativeConfirmation(row)) return "Negative tax-less-book difference confirmation required";
  if(rowNeedsMspmBreakout(row)) return "MSPM breakout required";
  if(rowNeedsMspmReview(row)) return "MSPM treatment confirmation required";
  if(rowRequiresOverlapConfirmation(row) && row.notIn471Confirmed !== true) return "Duplicate-cost check required";
  if(isSuspenseInputId(row.inputId)) return "Breakout required";
  if(rowIsUnresolved(row)) return "Classification confirmation required";
  return "Review complete";
}

