    }
    if(id === "mixedNoDepartmentsConfirmed"){
      state.mixedNoDepartmentsConfirmationFingerprint = state.mixedNoDepartmentsConfirmed ? calculationFingerprint() : "";
    }
    if(id === "srmSharedDepartmentStatus"){
      state.srmSharedDepartmentStatusFingerprint = ["included","none"].includes(state.srmSharedDepartmentStatus) ? calculationFingerprint() : "";
    }
    renderCalcOnly();
  });
});

document.querySelectorAll('input[name="amountBasis"]').forEach(input => {
  input.addEventListener("change", () => changeAmountBasis(input.value));
});

document.querySelectorAll('input[name="activityType"],input[name="srmRatioMode"]').forEach(input => {
  input.addEventListener("change", () => {
    invalidateCalculationApprovals();
    if(input.name === "activityType"){
      state.selectedMethod = "";
      state.selectedMethodConfirmed = false;
    }
    renderAll();
  });
});

function resetUnicapMethodPath(){
  state.firstUnicapYearReason = "";
  state.unicapChangeComponents = [];
  state.priorSelectedMethod = "";
  state.priorMixedServiceMethod = "";
  state.priorMixedMspmSplitMethod = "";
  state.methodTransitionSupportConfirmed = false;
  state.methodTransitionSupportFingerprint = "";
  state.selectedMethod = "";
  state.selectedMethodConfirmed = false;
  state.mixedServiceMethod = "";
  state.mixedMspmSplitMethod = "";
  state.mixedMspmNinetyElection = "none";
  state.mixedPopulationConfirmed = false;
  state.mixedPopulationConfirmationFingerprint = "";
  state.mixedDepartmentNinetyElection = "";
  if($("mixedServiceMethod")) $("mixedServiceMethod").value = "";
  if($("mixedMspmSplitMethod")) $("mixedMspmSplitMethod").value = "";
  if($("mixedMspmNinetyElection")) $("mixedMspmNinetyElection").value = "none";
  if($("mixedDepartmentNinetyElection")) $("mixedDepartmentNinetyElection").value = "";
  if($("mixedPopulationConfirmed")) $("mixedPopulationConfirmed").checked = false;
  if($("methodTransitionSupportConfirmed")) $("methodTransitionSupportConfirmed").checked = false;
  document.querySelectorAll('input[name="firstUnicapYearReason"],input[name="unicapChangeComponent"],input[name="priorSelectedMethodChoice"],input[name="priorMixedServiceMethodChoice"],input[name="priorMixedSplitBasisChoice"],input[name="selectedMethodChoice"],input[name="mixedServiceMethodChoice"],input[name="mixedSplitBasisChoice"]').forEach(item => { item.checked = false; });
}

document.querySelectorAll('input[name="unicapPriorYearApplied"]').forEach(input => {
  input.addEventListener("change", () => {
    invalidateCalculationApprovals();
    state.unicapPriorYearApplied = input.value;
    state.unicapMethodContinuity = "";
    state.unicapHistory = deriveUnicapHistory();
    document.querySelectorAll('input[name="unicapMethodContinuity"]').forEach(item => { item.checked = false; });
    resetUnicapMethodPath();
    renderAll();
  });
});

document.querySelectorAll('input[name="unicapMethodContinuity"]').forEach(input => {
  input.addEventListener("change", () => {
    invalidateCalculationApprovals();
    state.unicapMethodContinuity = input.value;
    state.unicapHistory = deriveUnicapHistory();
    resetUnicapMethodPath();
    renderAll();
  });
});

document.querySelectorAll('input[name="firstUnicapYearReason"]').forEach(input => {
  input.addEventListener("change", () => {
    invalidateCalculationApprovals();
    state.firstUnicapYearReason = input.value;
    state.methodTransitionSupportConfirmed = false;
    state.methodTransitionSupportFingerprint = "";
    if($("methodTransitionSupportConfirmed")) $("methodTransitionSupportConfirmed").checked = false;
    renderAll();
  });
});

document.querySelectorAll('input[name="unicapChangeComponent"]').forEach(input => {
  input.addEventListener("change", () => {
    invalidateCalculationApprovals();
    state.unicapChangeComponents = Array.from(document.querySelectorAll('input[name="unicapChangeComponent"]:checked')).map(item => item.value);
    state.methodTransitionSupportConfirmed = false;
    state.methodTransitionSupportFingerprint = "";
    if($("methodTransitionSupportConfirmed")) $("methodTransitionSupportConfirmed").checked = false;
    renderAll();
  });
});

[
  ["priorSelectedMethodChoice","priorSelectedMethod"],
  ["priorMixedServiceMethodChoice","priorMixedServiceMethod"],
  ["priorMixedSplitBasisChoice","priorMixedMspmSplitMethod"]
].forEach(([name,key]) => {
  document.querySelectorAll(`input[name="${name}"]`).forEach(input => {
    input.addEventListener("change", () => {
      invalidateReviewSignoffs();
      state[key] = input.value;
      state.methodTransitionSupportConfirmed = false;
      state.methodTransitionSupportFingerprint = "";
      if($("methodTransitionSupportConfirmed")) $("methodTransitionSupportConfirmed").checked = false;
      renderAll();
    });
  });
});

if($("methodTransitionSupportConfirmed")) $("methodTransitionSupportConfirmed").addEventListener("change", () => {
  invalidateReviewSignoffs();
  state.methodTransitionSupportConfirmed = $("methodTransitionSupportConfirmed").checked;
  state.methodTransitionSupportFingerprint = state.methodTransitionSupportConfirmed ? methodTransitionFingerprint() : "";
  renderCalcOnly();
});

document.querySelectorAll('input[name="inventoryMethod"]').forEach(input => {
  input.addEventListener("change", () => {
    invalidateCalculationApprovals();
    state.inventoryMethod = input.value;
    if(input.value === "LIFO" && !normalizeLifoPools().length) state.lifoPools.push(newLifoPool());
    renderAll();
  });
});

document.querySelectorAll('input[name="lifoActualRatioConfirmed"],input[name="lifoCoverage"]').forEach(input => {
  input.addEventListener("change", () => {
    invalidateCalculationApprovals();
    renderAll();
  });
});

document.querySelectorAll('input[name="bookTreatment"]').forEach(input => {
  input.addEventListener("change", () => changeBookTreatment(input.value));
});

document.querySelectorAll('input[name="financialStatementQualified"],input[name="financialStatementMethodAdopted"],input[name="financialStatementValuationExcluded"],input[name="financialStatementGrossReceiptsEligible"],input[name="bookTaxMethodConfirmed"],input[name="indirectCostRule"]').forEach(input => {
  input.addEventListener("change", () => {
    invalidateCalculationApprovals();
    renderAll();
  });
});

document.querySelectorAll('input[name="fsaOpeningBasisConfirmed"],input[name="fsaMethodChange"],input[name="fsaEndingBasisConfirmed"]').forEach(input => {
  input.addEventListener("change", () => {
    invalidateCalculationApprovals();
    renderAll();
  });
});

document.querySelectorAll('input[name="suggestionBasis"]').forEach(input => {
  input.addEventListener("change", () => changeSuggestionBasis(input.value));
});

document.addEventListener("change",releaseWorkflowAutoAdvanceForDiscreteChange);
document.addEventListener("click",releaseWorkflowAutoAdvanceForDiscreteChange);

document.addEventListener("keydown",event => {
  if(event.key !== "Enter" || !event.target || !["clientName","taxYear"].includes(event.target.id)) return;
  event.preventDefault();
  event.target.blur();
});

document.addEventListener("focusout",event => {
  if(!workflowAutoAdvancePending || workflowAutoAdvancePending.holdElement !== event.target) return;
  workflowAutoAdvancePending.holdElement = null;
  setTimeout(flushWorkflowAutoAdvance,0);
});

["staffReviewChecked","managerReviewChecked","seniorManagerReviewChecked","partnerReviewChecked"].forEach(id => {
  if($(id)){
    $(id).addEventListener("input", renderCalcOnly);
    $(id).addEventListener("change", renderCalcOnly);
  }
});

["staffReviewName","managerReviewName","seniorManagerReviewName","partnerReviewName"].forEach(id => {
  if($(id)){
    const handleReviewNameChange = () => {
      const role = id.replace("ReviewName","");
      if(state[role + "ReviewChecked"]) invalidateReviewFrom(role);
      renderCalcOnly();
    };
    $(id).addEventListener("input", handleReviewNameChange);
    $(id).addEventListener("change", handleReviewNameChange);
  }
});

resetWorkflowAutoAdvanceTracking();
setControls();
renderAll();
</script>
</body>
</html>
