function mixedServiceCalculationIssues(c){
  const issues = [];
  if(!hasMixedServiceCosts()) return issues;
  const baseStats = c.baseMappingStats || baseMappingStats();
  const method = c.mixedCalculationMethod || (isSimplifiedMixedMethod(c.mixedServiceMethod) ? c.mixedServiceMethod : (!c.mixedServiceMethod ? "production" : ""));

  const requireLaborBase = () => {
    const detailCount = allocationBaseRows().filter(row => row.laborTreatment === "detail").length;
    if(detailCount) issues.push(`Replace ${detailCount} summarized labor account(s) with detailed source rows in Step 2.`);
    const otherCount = Math.max(0,baseStats.laborReview - detailCount) + baseStats.laborUnconfirmed;
    if(otherCount) issues.push(`${otherCount} labor account(s) still need a choice.`);
    if(c.mixedTotalLabor <= 0) issues.push("No labor total was found for the labor-based method.");
    if(c.mixedSec263ALabor < 0 || c.mixedPreProductionLabor < 0 || c.mixedSec263ALabor > c.mixedTotalLabor || c.mixedPreProductionLabor > c.mixedSec263ALabor) issues.push("The labor accounts do not produce a usable ratio.");
  };

  const requireCostBase = () => {
    const detailCount = allocationBaseRows().filter(row => row.costTreatment === "detail").length;
    if(detailCount) issues.push(`Replace ${detailCount} summarized cost account(s) with detailed source rows in Step 2.`);
    const otherCount = Math.max(0,baseStats.costReview - detailCount) + baseStats.costUnconfirmed;
    if(otherCount) issues.push(`${otherCount} cost account(s) still need a choice.`);
    if(c.mixedTotalCosts <= 0) issues.push("No business-cost total was found for the cost-based method.");
    if(c.mixedSec263AProductionCosts < 0 || c.mixedSec263AProductionCosts > c.mixedTotalCosts) issues.push("The classified accounts do not produce a usable cost ratio.");
  };

  if(c.mixedServicePool < 0) issues.push("The mixed service cost total is negative. Check the source signs.");
  if(state.mixedDepartmentNinetyElection === "yes") issues.push("The department-level 90% election requires a separate department schedule before this allocation can be calculated.");
  if(isDetailedMixedMethod(c.mixedServiceMethod)) issues.push("This method requires a separate departmental allocation schedule. UNIPRO will not approximate it from Account, Description, and Amount.");
  if(method === "labor") requireLaborBase();
  if(method === "production") requireCostBase();
  if(state.methodRun !== "SPM" && !isDetailedMixedMethod(c.mixedServiceMethod)){
    const splitMethod = c.mixedMspmSplitMethod || c.mixedCalculationSplitMethod || "materials";
    if(splitMethod === "labor") requireLaborBase();
    if(!c.indirectCostRuleApplies && c.cy471 <= 0) issues.push("Current-year inventory costs must be greater than zero.");
    if(splitMethod === "materials" && (c.cyRaw < 0 || c.cyRaw > c.cy471)) issues.push("The direct-material amount does not produce a usable purchasing share.");
  }

  return [...new Set(issues)];
}

function mixedServiceCalculated(c){
  return !hasMixedServiceCosts() || mixedServiceCalculationIssues(c).length === 0;
}

function mixedServiceInputIssues(c){
  const issues = mixedServiceCalculationIssues(c);
  if(!hasMixedServiceCosts()) return issues;
  if(state.activityType === "reseller"){
    issues.push("A reseller's mixed service costs require a separate labor-based schedule. Add its allocated purchasing and storage or handling amounts as source rows; do not leave them in the mixed service bucket.");
    return [...new Set(issues)];
  }
  const method = c.mixedServiceMethod;
  if(unicapComponentChanging("mixedService") && !["labor","production","direct","step","reasonable","none"].includes(state.priorMixedServiceMethod)) issues.push("Choose the mixed service calculation used last year.");
  if(!MIXED_METHODS[method]){
    issues.push("Choose the taxpayer's mixed service cost method.");
    return [...new Set(issues)];
  }
  if(isDetailedMixedMethod(method)) return [...new Set(issues)];
  if(!mixedPopulationConfirmationIsCurrent()) issues.push("Review the accounts used for the mixed service calculation and confirm the population is complete.");
  const continuingSpm = state.unicapHistory === "priorUnchanged" && state.priorSelectedMethod === "SPM";
  if(state.methodRun !== "SPM" && !continuingSpm){
    if(unicapComponentChanging("modifiedSplit") && !["labor","materials"].includes(state.priorMixedMspmSplitMethod)) issues.push("Choose last year's MSPM mixed-service allocation method.");
    if(!["labor","materials"].includes(c.mixedMspmSplitMethod)) issues.push("Choose the MSPM mixed-service allocation method for this tax year.");
  }
  return [...new Set(issues)];
}

function mixedServiceInputsValid(c){
  return mixedServiceInputIssues(c).length === 0;
}

