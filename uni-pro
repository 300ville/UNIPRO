      {cells:["Current-year additional Section 263A costs", resultCell(spm.add), resultCell(mspm.add), diffCell(mspm.add - spm.add)]},
      {cells:[baseLabel, resultCell(spm.base), resultCell(mspm.base), diffCell(mspm.base - spm.base)], cls:"subtotal-row"},
      {cells:["Additional Section 263A capitalized", resultCell(spm.cap), resultCell(mspm.cap), diffCell(mspm.cap - spm.cap)], cls:"subtotal-row"},
      {cells:[endingLabel, resultCell(spm.ending), resultCell(mspm.ending), diffCell(mspm.ending - spm.ending)], cls:"total-row"},
      {cells:["Additional Section 263A costs to COGS", resultCell(spm.cogs), resultCell(mspm.cogs), diffCell(mspm.cogs - spm.cogs)]},
      {cells:["Final ending add-on rate", resultCell(spm.rate,"pct"), resultCell(mspm.rate,"pct"), resultCell(mspm.rate - spm.rate,"pct")], cls:"ratio-row"}
    ],"Both calculations use the same confirmed source population and detailed inventory inputs."));
  } else if(state.methodRun === "SPM"){
    pieces.push(resultsTable("2. Simplified Production Method Result",["Result","Amount"],[
      {cells:["Section 471 cost denominator", resultCell(c.cy471)]},
      {cells:["Current-year additional Section 263A costs", resultCell(c.add263A)]},
      {cells:["Simplified Production Method absorption ratio", resultCell(c.spmRatioCalc,"pct")], cls:"ratio-row"},
      {cells:[baseLabel, resultCell(c.spmBase)], cls:"subtotal-row"},
      {cells:["Additional Section 263A capitalized", resultCell(c.spmCap)], cls:"subtotal-row"},
      {cells:[endingLabel, resultCell(c.spmEnding)], cls:"total-row"},
      {cells:["Additional Section 263A costs to COGS", resultCell(c.spmCogs)]}
    ]));
  } else {
    pieces.push(resultsTable("2. Modified Simplified Production Method Result",["Result","Amount"],[
      {cells:["Pre-production add-on", resultCell(c.v)]},
      {cells:["Production add-on", resultCell(c.z)]},
      {cells:[baseLabel, resultCell(c.mspmBase)], cls:"subtotal-row"},
      {cells:["Additional Section 263A capitalized", resultCell(c.mspmCap)], cls:"subtotal-row"},
      {cells:[endingLabel, resultCell(c.mspmEnding)], cls:"total-row"},
      {cells:["Additional Section 263A costs to COGS", resultCell(c.mspmCogs)]}
    ]));
  }

  pieces.push(allocationsDisclosure);
  pieces.push(collapsibleResults(state.methodRun === "Both" ? "4. Simplified Production Method and Modified Simplified Production Method Details" : `4. ${labelSelectedMethod(state.methodRun)} Detail`,methodDetailsHtml(c)));

  $("resultsBox").innerHTML = pieces.join("");
}

function buildValidationItems(c){
  const items = [];
  const stats = rowStats();
  const hasMixedRows = hasMixedServiceCosts();

  if(!state.rows.length) return items;

  if(!validTaxYearEnding(state.taxYear)) items.push(["bad","Enter a valid tax year ending date in MM/DD/YYYY format."]);
  if(!methodTransitionSupportIsCurrent() && state.unicapHistory === "firstYear" && state.firstUnicapYearReason === "newlySubject") items.push(["warn","This existing activity is applying UNICAP for the first time. Confirm the separate beginning-inventory revaluation, Section 481(a), and Form 3115 support in Step 6."]);
  if(!methodTransitionSupportIsCurrent() && state.unicapHistory === "firstYear" && state.firstUnicapYearReason === "priorNoncompliance") items.push(["warn","UNICAP may have been required in an earlier year. Confirm the separate accounting-method correction and beginning-inventory support in Step 6."]);
  if(!methodTransitionSupportIsCurrent() && state.unicapHistory === "priorChanging") items.push(["warn",`Confirm the separate prior and proposed method support for: ${labelUnicapChangeComponents()}.`]);
  if(state.amountBasis === "unknown" || !state.amountBasis) items.push(["bad","Select Federal tax or Book for this workpaper."]);
  if(state.indirectCostRule === "notDetermined" || !state.indirectCostRule) items.push(["bad","Answer the $200,000 producer-rule question in Step 1."]);
  if(stats.duplicateGroups) items.push(["warn",`${stats.duplicateGroups} exact duplicate source account group(s) were identified. The rows remain in the source population. Confirm that each source line is legitimate or distinguish it with an account, description, or reviewer note.`]);
  if(state.lastImport && Array.isArray(state.lastImport.rejected) && state.lastImport.rejected.length) items.push(["bad",`${state.lastImport.rejected.length} source line(s) from the last import were rejected. Correct and re-import the complete source population before relying on the calculation.`,"hard"]);
  if(stats.reviewCount) items.push(["warn",`${stats.reviewCount} row(s) still need a UNICAP bucket assignment.`]);
  if(stats.unconfirmedCount) items.push(["warn",`${stats.unconfirmedCount} row(s) still need a selection.`]);
  if(stats.suspenseCount) items.push(["warn",`${stats.suspenseCount} row(s), totaling ${moneyWp(stats.suspenseAbsAmount)} in source dollars, are in Breakout / Suspense and are excluded from the calculation. Obtain detail, split into mapped rows, or document exclusion before final reliance.`]);
  if(needsMspmDetail() && stats.mspmReviewCount) items.push(["bad",`${stats.mspmReviewCount} account row(s) have not been affirmatively reconfirmed for MSPM.`]);
  if(needsMspmDetail() && stats.mspmBreakoutCount) items.push(["bad",`${stats.mspmBreakoutCount} aggregate SPM ending inventory row(s) must be broken out before an MSPM result can be calculated.`]);
  INVENTORY_CONFIRMATION_DEFS.forEach(def => {
    if(inventoryRole(def.id) !== "required" && inventoryState(def.id).mode === "breakout") items.push(["warn",`${def.label} is support-only for this scope but remains marked as requiring a breakout.`]);
  });
  if(lifoActive()) lifoCompletionIssues(c).forEach(message => items.push(["bad",message,"hard"]));
  if(stats.parseIssues) items.push(["bad",`${stats.parseIssues} imported amount(s) could not be parsed. Correct the source amount before relying on the output.`]);
  const basisMismatches = basisSourceMismatchRows();
  if(basisMismatches.length) items.push(["bad",`${basisMismatches.length} imported source row(s) use an amount column that does not match the selected ${state.amountBasis === "book" ? "book or financial-statement" : "tax-adjusted"} basis. Re-import those rows with the matching amount column.`,"hard"]);
  const unavailableRows = unavailableInputRows();
  if(unavailableRows.length) items.push(["bad",`${unavailableRows.length} row(s) use financial-statement-method adjustment buckets that are unavailable for the selected source basis or book treatment. Reclassify those rows before relying on the calculation.`,"hard"]);
  const requiredMissing = missingRequiredCategories();
  if(requiredMissing.length) items.push(["bad",`Enter an amount for each required category: ${requiredMissing.map(requiredCategoryLabel).join("; ")}. Enter 0 when there is no amount.`]);
  const overlapMissing = overlapRowsNeedingConfirmation();
  if(overlapMissing.length) items.push(["bad",`Confirm that ${overlapMissing.length} additional Section 263A cost row(s) are not already included in the mapped Section 471 costs.`]);
  bookTaxReconciliationIssues().forEach(message => items.push(["bad",message,"hard"]));
  if(state.activityType === "reseller"){
    if(!["exclusive","deMinimis","contract"].includes(state.srmEligibility)) items.push(["bad","Confirm that the property and activities are eligible for the Simplified Resale Method under Treas. Reg. Section 1.263A-3(d).","hard"]);
    if(state.srmRatioMode === "historic"){
      if(!(srmHistoricRatioValue() > 0)) items.push(["bad","Enter a valid positive historic SRM absorption ratio.","hard"]);
      if(!String(state.srmHistoricSupport || "").trim()) items.push(["bad","Enter the workpaper reference supporting the elected historic SRM absorption ratio.","hard"]);
    }
    if(isZeroMoney(c.cyResale) && !isZeroMoney(c.srmPurchasingCosts)) items.push(["bad","Current-year purchases are zero, but purchasing costs are present, so the purchasing-cost ratio cannot be calculated.","hard"]);
    if(isZeroMoney(c.srmStorageHandlingDenominator) && !isZeroMoney(c.srmStorageHandlingCosts)) items.push(["bad","Beginning resale inventory plus current-year purchases is zero, but storage and handling costs are present.","hard"]);
    if(!lifoActive() && c.endResale > c.cyResale + 0.005) items.push(["bad","Ending resale inventory exceeds current-year purchases under the FIFO current-year-layer convention.","hard"]);
    if(c.srmAppliedRatio < 0) items.push(["bad","The applied SRM absorption ratio is negative. Review the mapped cost reductions and allocation support.","hard"]);
    return items;
  }
  if(financialStatementAlternativeActive() && !spmAvailable()) items.push(["warn","SPM is unavailable with the financial statement alternative because the prior-three-year average annual gross receipts exceeded $50 million. MSPM remains available and is the only released result."]);
  if(state.amountBasis === "book" && !bookTaxReconciliationIssues().length) items.push(["warn",`${labelBookTreatment(state.bookTreatment)} is selected and the signed tax-less-book adjustment control is reconciled to ${moneyWp(bookTaxMappedAdjustmentTotal())}.`]);
  const reserveTreatmentRows = state.rows.filter(row => row.suggestedInputId === "breakoutBookTaxReserve" && row.confirmed === true && !isSuspenseInputId(row.inputId) && !(inputById[row.inputId] && inputById[row.inputId].group === "Excluded costs"));
  const unsupportedReserveRows = reserveTreatmentRows.filter(row => !String(row.notes || "").trim());
  if(unsupportedReserveRows.length) items.push(["bad",`${unsupportedReserveRows.length} reserve, write-down, or valuation-adjustment row(s) mapped into the calculation need a reviewer note documenting the treatment and book-to-tax reconciliation.`,"hard"]);
  else if(reserveTreatmentRows.length) items.push(["warn",`${reserveTreatmentRows.length} reserve, write-down, or valuation-adjustment row(s) are supported by reviewer notes. Review their calculation treatment before signoff.`]);

  const soldOnlyRows = state.rows.filter(row => row.confirmed === true && row.inputId === "excludedSoldOnly");
  const unsupportedSoldOnlyRows = soldOnlyRows.filter(row => !String(row.notes || "").trim());
  if(unsupportedSoldOnlyRows.length) items.push(["bad",`${unsupportedSoldOnlyRows.length} sold-property exclusion row(s) need a reviewer note identifying the eligible indirect cost or Section 471 cost reduction, authority, and allocation support.`]);
  else if(soldOnlyRows.length) items.push(["warn",`${soldOnlyRows.length} sold-property exclusion row(s) are supported by reviewer notes. Confirm the limited cost category and allocation before signoff.`]);

  const negativeInventoryRows = state.rows.filter(row => row.confirmed === true
    && ["begraw","begresale","begprod","begadd","endraw","endresale","endprod","spmend471"].includes(row.inputId)
    && !(lifoActive() && row.inputId === "begadd")
    && mapped(row) < 0);
  if(negativeInventoryRows.length) items.push(["bad",`${negativeInventoryRows.length} beginning or ending inventory balance row(s) are negative. Inventory balances must be nonnegative.`,"hard"]);
  const negativeInventoryInputs = INVENTORY_CONFIRMATION_DEFS.filter(def => {
    const item = inventoryState(def.id);
    return ["linked","manual","detailed"].includes(item.mode) && inventoryModeValue(def.id) < -0.005 && !(lifoActive() && def.id === "begadd");
  });
  if(negativeInventoryInputs.length) items.push(["bad",`${negativeInventoryInputs.length} confirmed inventory input balance(s) are negative. Inventory balances must be nonnegative.`,"hard"]);
  if(lifoActive() && inventoryModeValue("begadd") < -0.005) items.push(["warn","The independently supported prior-year ending additional Section 263A control is negative and is retained as a signed historical layer. Confirm the source reference and pool tie-out before signoff."]);

  const negativeCurrentYearComponents = state.rows.filter(row => row.confirmed === true
    && ["raw","resale","prod471"].includes(row.inputId)
    && mapped(row) < 0);
  const unsupportedContraRows = negativeCurrentYearComponents.filter(row => !String(row.notes || "").trim());
  if(unsupportedContraRows.length) items.push(["bad",`${unsupportedContraRows.length} negative current-year Section 471 component row(s) need a reviewer note identifying the supported contra-cost, discount, return, allowance, rebate, or other cost reduction.`]);
  else if(negativeCurrentYearComponents.length) items.push(["warn",`${negativeCurrentYearComponents.length} negative current-year Section 471 component row(s) are retained as supported contra-costs. Review their notes and aggregate category balance.`]);

  const negativeAdditionalCostRows = state.rows.filter(row => row.confirmed === true
    && ["preadd","prodadd","mixedservice"].includes(row.inputId)
    && mapped(row) < 0);
  const unsupportedNegativeCostRows = negativeAdditionalCostRows.filter(row => !String(row.notes || "").trim());
  if(unsupportedNegativeCostRows.length) items.push(["bad",`${unsupportedNegativeCostRows.length} negative additional Section 263A or mixed-service cost row(s) need a reviewer note confirming the source sign, federal tax amount, and supported cost reduction.`]);
  else if(negativeAdditionalCostRows.length) items.push(["warn",`${negativeAdditionalCostRows.length} negative additional Section 263A or mixed-service cost row(s) are retained as supported signed cost reductions. Review the federal tax amounts and reviewer notes before signoff.`]);

  if(!c.indirectCostRuleApplies && isZeroMoney(c.cy471) && !isZeroMoney(c.add263A)) items.push(["bad","Current-year Section 471 costs are zero, but current-year additional Section 263A costs are present.","hard"]);
  if(!c.indirectCostRuleApplies && state.methodRun !== "SPM" && isZeroMoney(c.cyPre471) && !isZeroMoney(c.preAdd)) items.push(["bad","MSPM pre-production Section 471 costs are zero, but pre-production additional Section 263A costs are present.","hard"]);
  if(!c.indirectCostRuleApplies && state.methodRun !== "SPM" && isZeroMoney(c.prodDenominator) && !isZeroMoney(c.prodAdd + c.residualPreAdd)) items.push(["bad","MSPM production denominator is zero, but the production numerator is present.","hard"]);
  if(c.totalEndRaw < 0) items.push(["bad","Total ending raw materials cannot be negative.","hard"]);
  if(needsMspmDetail() && c.totalEndRaw > c.begRaw + c.cyRaw) items.push(["bad","Total ending raw materials exceed beginning raw materials plus current-year raw-material purchases.","hard"]);
  if(!lifoActive() && c.endResale > c.cyResale) items.push(["bad","Current-year resale costs remaining on hand exceed current-year property acquired for resale.","hard"]);
  if(!lifoActive() && (state.methodRun === "SPM" || state.methodRun === "Both") && c.spmBase > c.cy471 + 0.005) items.push(["bad","The SPM current-year ending Section 471 base exceeds current-year Section 471 costs.","hard"]);
  if(!lifoActive() && needsMspmDetail() && c.end471 > c.cy471 + 0.005) items.push(["bad","Aggregate current-year ending Section 471 costs exceed current-year Section 471 costs.","hard"]);
  if(state.methodRun !== "SPM" && c.prodDenominator < 0) items.push(["bad","The MSPM production denominator is negative. Review production Section 471 costs and the direct materials adjustment.","hard"]);
  const currentYearRawEntered = Math.max(0,c.cyRaw - c.currentYearEndRaw);
  const currentYearProductionAvailable = c.cyProd471 + currentYearRawEntered;
  if(!lifoActive() && state.methodRun !== "SPM" && c.endProd > currentYearProductionAvailable + 0.005) items.push(["bad","Current-year ending production Section 471 costs exceed current-year production costs plus current-year raw materials entered into production.","hard"]);
  const activeEndingBase = state.methodRun === "SPM" ? c.spmBase : c.end471;
  if(isZeroMoney(activeEndingBase) && !isZeroMoney(c.add263A)) items.push(["warn",`Ending Section 471 costs are zero. No current-year additional Section 263A costs capitalize to ending inventory under the ${lifoActive() ? "non-LIFO ratio-support" : "FIFO"} inputs.`]);

  if(lifoActive() && c.lifo){
    if(c.lifo.release263A && c.indirectCostRuleApplies) items.push(["warn",`The $200,000 producer rule sets current-year LIFO additions to zero, but ${moneyWp(c.lifo.release263A)} of historical Section 263A is still released by LIFO liquidations.`]);
    if(c.lifo.spmEndingAdditional < -SOURCE_CONTROL_EPSILON || c.lifo.mspmEndingAdditional < -SOURCE_CONTROL_EPSILON) items.push(["warn","A supported signed LIFO Section 263A layer ends negative. Review the historical layer support and signed financial-statement-method adjustments before signoff."]);
  }

  if(hasMixedRows && !c.indirectCostRuleApplies){
    mixedServiceInputIssues(c).forEach(message => items.push(["bad",message]));
    if(c.mixedServiceMethod === "labor" && c.baseMappingStats.laborComplete && c.mixedSec263ALabor === 0){
      items.push(["warn","Confirmed Section 263A labor classifications total zero, so the labor-based method allocates none of the mixed service pool to additional Section 263A costs."]);
    }
    if(c.mixedServiceMethod === "production" && c.baseMappingStats.costComplete && c.mixedSec263AProductionCosts === 0){
      items.push(["warn","Confirmed Section 263A production-cost classifications total zero, so the production-cost method allocates none of the mixed service pool to additional Section 263A costs."]);
    }
  }

  const capChecks = [];
  if(state.methodRun === "Both" || state.methodRun === "SPM") capChecks.push(["SPM",c.spmCap,c.spmCogs]);
  if(state.methodRun === "Both" || state.methodRun === "MSPM") capChecks.push(["MSPM",c.mspmCap,c.mspmCogs]);
  capChecks.forEach(([method,cap,cogs]) => {
    if(cap < -0.005) items.push(financialStatementAlternativeActive()
      ? ["warn",`${method} capitalized additional Section 263A costs are negative because signed financial-statement-method adjustments are retained. Review the account-level support and resulting inventory reduction.`]
      : ["bad",`${method} capitalized additional Section 263A costs are negative. Review negative inputs and signed tax-less-book adjustments.`,"hard"]);
    if(c.add263A >= 0 && cap - c.add263A > 0.005) items.push(["bad",`${method} capitalized additional Section 263A costs exceed current-year additional Section 263A costs.`,"hard"]);
    if(c.add263A >= 0 && cogs < -0.005) items.push(["bad",`${method} current-year additional Section 263A costs allocated to property sold are negative.`,"hard"]);
  });

  if(c.add263A < -0.005) items.push(financialStatementAlternativeActive()
    ? ["warn","Current-year additional Section 263A costs are net negative after retaining the supported signed financial-statement-method amounts. Review the account-level support and resulting allocation."]
    : ["bad","Current-year additional Section 263A costs are negative. Correct or support the signed source amounts and tax-less-book adjustments before proceeding."]);
  const selectedEndingBase = state.methodRun === "SPM" ? c.spmBase : c.end471;
  if(c.cy471 < -0.005 || selectedEndingBase < -0.005) items.push(["bad","One or more aggregate Section 471 inventory cost totals are negative. Correct the signs or classifications.","hard"]);

  return items;
}

function redValidationItems(items){
  return items.filter(item => item[0] === "bad");
}

function isRedFlagOverrideValid(redItems){
  return redItems.length > 0
    && !redItems.some(item => item[2] === "hard")
    && rowStats().parseIssues === 0
    && missingRequiredCategories().length === 0
    && overlapRowsNeedingConfirmation().length === 0
    && validTaxYearEnding(state.taxYear)
    && ["tax","book"].includes(state.amountBasis)
    && ["applies","doesNotApply"].includes(state.indirectCostRule)
    && state.redFlagOverrideChecked === true
    && !!String(state.redFlagOverrideExplanation || "").trim()
    && !!state.redFlagOverrideFingerprint
    && state.redFlagOverrideFingerprint === calculationFingerprint();
}

function renderRedFlagOverride(redItems){
  const panel = $("redFlagOverridePanel");
  const printDisclosure = $("redFlagOverridePrint");
  if(!panel || !printDisclosure) return;

  if(!redItems.length){
    panel.classList.add("hidden");
    printDisclosure.classList.add("hidden");
    printDisclosure.innerHTML = "";
    return;
  }

  panel.classList.remove("hidden");
  const overrideEligible = rowStats().parseIssues === 0
    && !redItems.some(item => item[2] === "hard")
    && missingRequiredCategories().length === 0
    && overlapRowsNeedingConfirmation().length === 0
    && validTaxYearEnding(state.taxYear)
    && ["tax","book"].includes(state.amountBasis)
    && ["applies","doesNotApply"].includes(state.indirectCostRule);
  if($("redFlagOverrideChecked")){
    $("redFlagOverrideChecked").checked = !!state.redFlagOverrideChecked;
    $("redFlagOverrideChecked").disabled = !overrideEligible;
  }
  if($("redFlagOverrideExplanation") && document.activeElement !== $("redFlagOverrideExplanation")){
    $("redFlagOverrideExplanation").value = state.redFlagOverrideExplanation || "";
  }
  if($("redFlagOverrideExplanation")) $("redFlagOverrideExplanation").disabled = !overrideEligible;

  const valid = isRedFlagOverrideValid(redItems);
  if($("redFlagOverrideStatus")){
    $("redFlagOverrideStatus").textContent = !overrideEligible
      ? redItems.some(item => item[2] === "hard")
        ? "Arithmetic and data-integrity blockers cannot be overridden. Correct the source amounts or classifications before proceeding."
        : "Malformed imported amounts and undetermined required selections cannot be overridden. Correct them before proceeding."
      : valid
        ? "Override active. The red flags and explanation will be disclosed in the exported workpaper."
        : state.redFlagOverrideChecked
          ? "Enter an override explanation before the workpaper can proceed or export."
          : "Red flags block results, Workpaper ready status, and exporting unless explicitly overridden.";
  }

  if(valid){
    printDisclosure.classList.remove("hidden");
    printDisclosure.innerHTML = `<strong>RED FLAG OVERRIDE.</strong><ul>${redItems.map(item => `<li>${esc(item[1])}</li>`).join("")}</ul><p><strong>Override explanation:</strong> ${esc(String(state.redFlagOverrideExplanation).trim())}</p>`;
  } else {
    printDisclosure.classList.add("hidden");
    printDisclosure.innerHTML = "";
  }
}

function renderValidation(c){
  const items = buildValidationItems(c);

  if(!state.rows.length){
    $("validationBox").innerHTML = `<div class="note">Validation begins after source accounts are imported.</div>`;
    renderRedFlagOverride([]);
    return items;
  }

  if(!items.length){
    $("validationBox").innerHTML = `<span class="pill ok">Automated checks found no red flags or warnings</span><p class="small-note">This status does not determine legal eligibility, method-change procedure, or facts outside the entered workpaper.</p>`;
    renderRedFlagOverride([]);
    return items;
  }

  $("validationBox").innerHTML = `<ul class="validation-list">${items.map(([cls,msg,kind]) => `
    <li><span class="pill ${cls}">${kind === "hard" ? "Integrity blocker" : cls === "bad" ? "Red flag" : "Warning"}</span> ${esc(msg)}</li>
  `).join("")}</ul>`;
  renderRedFlagOverride(redValidationItems(items));
  return items;
}

function labelAmountBasis(value){
  if(value === "tax") return "Federal tax";
  if(value === "book") return "Book";
  return "Not selected";
}

function labelBookTreatment(value){
  if(value === "taxReconcile") return "Reconcile to existing federal tax amounts";
  if(value === "financialStatement") return "Financial statement alternative method";
  return "Not selected";
}

function labelSuggestionBasis(value){
  if(value === "account") return "Account numbers";
  if(value === "description") return "Account descriptions";
  if(value === "both") return "Account numbers and descriptions";
  return "Not selected";
}

function labelMethodRun(value){
  if(value === "Both") return "SPM and MSPM";
  if(value === "SPM") return "SPM only";
  if(value === "MSPM") return "MSPM only";
  return "Not selected";
}

function labelIndirectCostRule(value){
  if(value === "applies") return "Yes: $200,000 producer rule applies; eligible ending add-on is $0";
  if(value === "doesNotApply") return "No: total indirect costs exceeded $200,000";
  return "Not selected";
}


function renderDecisionSummary(c){
  if(!completionState(c).calculationReady){
    $("decisionSummary").innerHTML = `<div class="note">Workpaper support unlocks when Steps 1 through 5 are complete.</div>`;
    return;
  }
  const stats = rowStats();
  const assignedCount = state.rows.length - stats.reviewCount;

  const rows = [
    ["Taxpayer name", state.clientName || "Not entered"],
    ["Taxpayer type", labelActivityProfile()],
    ["Tax year ending", state.taxYear || "Not entered"],
    ["UNICAP history", labelUnicapHistory()],
    ...(state.unicapHistory === "firstYear" ? [["First-year reason",labelFirstUnicapYearReason()]] : []),
    ...(state.unicapHistory === "priorChanging" ? [
      ["Changing components",labelUnicapChangeComponents()],
      ["Prior production method",state.priorSelectedMethod ? labelSelectedMethod(state.priorSelectedMethod) : "Not applicable or not recorded"],
      ["Prior mixed service method",state.priorMixedServiceMethod ? mixedMethodLabel(state.priorMixedServiceMethod) : "Not applicable or not recorded"],
      ["Prior MSPM mixed-service allocation",state.priorMixedMspmSplitMethod === "materials" ? "Direct material costs" : state.priorMixedMspmSplitMethod === "labor" ? "Preproduction labor costs" : "Not applicable or not recorded"]
    ] : []),
    ...(methodTransitionSupportRequired() ? [["Method-change support",methodTransitionSupportIsCurrent() ? "Confirmed" : "Not confirmed"]] : []),
    ["Tool version", APP_VERSION],
    ["Amount basis", labelAmountBasis(state.amountBasis)],
    ...(state.amountBasis === "book" ? [
      ["Cost-amount method", labelBookTreatment(state.bookTreatment)],
      ["Book-to-tax adjustment control", `${moneyWp(bookTaxMappedAdjustmentTotal())} mapped; ${bookTaxReconciliationIssues().length ? "not reconciled" : "reconciled"}`],
      ["Book-to-tax support", state.bookTaxReference || "Not entered"],
      ...(financialStatementAlternativeActive() ? [
        ["Qualifying financial statement", state.financialStatementQualified === "yes" ? "Confirmed" : "Not confirmed"],
        ["Adopted or consented method", state.financialStatementMethodAdopted === "yes" ? "Confirmed" : "Not confirmed"],
        ["Write-downs, reserves, and valuation adjustments", state.financialStatementValuationExcluded === "yes" ? "Excluded" : "Not confirmed"],
        ["Prior-three-year average gross receipts", state.financialStatementGrossReceiptsEligible === "yes" ? "$50 million or less" : state.financialStatementGrossReceiptsEligible === "no" ? "Above $50 million" : "Not determined"],
