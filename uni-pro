  const srm = values.activityType === "reseller";
  const srmHistoric = srm && values.srmRatioMode === "historic";
  const unicapContinuity = values.unicapPriorYearApplied === "yes";
  const firstUnicapYear = values.unicapPriorYearApplied === "no";
  const changeComponents = unicapContinuity && values.unicapMethodContinuity === "changing";
  const priorMethodProfile = unicapContinuity && ["unchanged","changing"].includes(values.unicapMethodContinuity) && values.activityType === "producer";
