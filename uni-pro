/* Two-second UNIPRO cold open: darkness, a graphic electric strike, then a soft landing reveal. */
.brand-intro{
  position:fixed;
  inset:0;
  z-index:1000;
  overflow:hidden;
  background:
    radial-gradient(circle at 50% 46%,#140b2b 0,#0b0718 25%,#07050e 58%,#040308 100%);
  opacity:1;
  visibility:visible;
  pointer-events:auto;
  isolation:isolate;
}
.brand-intro[hidden]{display:none!important}
.brand-intro::before{
  content:"";
  position:absolute;
  inset:-18%;
  z-index:1;
  background:
    radial-gradient(ellipse at 69% 48%,rgba(255,255,255,1) 0,rgba(235,228,255,.94) 8%,rgba(184,159,255,.55) 22%,rgba(103,65,207,.2) 42%,transparent 68%),
    linear-gradient(112deg,transparent 31%,rgba(151,119,255,.10) 43%,rgba(237,231,255,.38) 49%,rgba(126,89,230,.08) 56%,transparent 67%);
  opacity:0;
  mix-blend-mode:screen;
}
.brand-intro::after{
  content:"";
  position:absolute;
  left:-15%;
  right:-15%;
  bottom:0;
  z-index:4;
  height:3px;
  background:linear-gradient(90deg,transparent,rgba(145,104,255,.38) 20%,#fff 49%,rgba(183,157,255,.58) 72%,transparent);
  box-shadow:0 0 12px #fff,0 0 38px rgba(150,108,255,.9),0 -24px 90px rgba(105,61,217,.46);
  opacity:0;
  transform:scaleX(.02);
  transform-origin:68% 50%;
}
.brand-intro-lightning{
  position:absolute;
  inset:-3% -2%;
  z-index:3;
  width:104%;
  height:106%;
  overflow:visible;
  opacity:0;
  transform:scale(1.025);
  transform-origin:68% 52%;
}
.bolt-aura{fill:none;stroke:#7764dd;stroke-width:22;stroke-linecap:round;stroke-linejoin:round;opacity:0;filter:url(#uniproBoltBloom);vector-effect:non-scaling-stroke}
.bolt-face{fill:none;stroke:url(#uniproBoltFace);stroke-width:7;stroke-linecap:round;stroke-linejoin:round;opacity:0;clip-path:inset(0 0 100% 0);filter:drop-shadow(0 0 3px #fff) drop-shadow(0 0 13px rgba(182,163,255,.82)) drop-shadow(0 0 34px rgba(111,72,255,.5));vector-effect:non-scaling-stroke}
.bolt-edge{fill:none;stroke:#fff;stroke-width:2;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke;opacity:0;filter:drop-shadow(0 0 5px #fff)}
.bolt-shard{fill:none;stroke:#cfc5ff;stroke-width:3;stroke-linecap:round;stroke-linejoin:round;opacity:0;filter:drop-shadow(0 0 10px rgba(157,130,255,.76));vector-effect:non-scaling-stroke;transform-box:fill-box;transform-origin:center}
.intro-impact{
  position:absolute;
  left:68%;
  bottom:-16vmin;
  z-index:2;
  width:44vmin;
  height:44vmin;
  border-radius:50%;
  background:radial-gradient(circle,#fff 0,rgba(229,218,255,.96) 7%,rgba(153,103,255,.58) 22%,rgba(89,46,177,.22) 46%,transparent 70%);
  opacity:0;
  transform:translateX(-50%) scale(.08);
  mix-blend-mode:screen;
}
.brand-intro.is-running::before{animation:uniproIntroFlash 2s linear forwards}
.brand-intro.is-running::after{animation:uniproIntroGroundWave 2s cubic-bezier(.16,.72,.18,1) forwards}
.brand-intro.is-running .brand-intro-lightning{animation:uniproIntroBoltFrame 2s linear forwards}
.brand-intro.is-running .bolt-face{animation:uniproIntroBoltFace 2s cubic-bezier(.16,.75,.18,1) forwards}
.brand-intro.is-running .bolt-aura{animation:uniproIntroBoltAura 2s linear forwards}
.brand-intro.is-running .bolt-edge{animation:uniproIntroBoltEdge 2s linear forwards}
.brand-intro.is-running .bolt-shard{animation:uniproIntroBoltShard 2s cubic-bezier(.15,.8,.25,1) forwards}
.brand-intro.is-running .shard-two{animation-delay:.025s}
.brand-intro.is-running .shard-three{animation-delay:.05s}
.brand-intro.is-running .intro-impact{animation:uniproIntroImpact 2s cubic-bezier(.12,.74,.16,1) forwards}
.brand-intro.is-running{animation:uniproIntroExit 2s cubic-bezier(.42,0,.18,1) forwards}

@keyframes uniproIntroFlash{
  0%,12%{opacity:0}
  15%{opacity:.16}
  18%{opacity:1}
  21%{opacity:.08}
  24%{opacity:.82}
  28%{opacity:.05}
  32%{opacity:.46}
  37%,100%{opacity:0}
}
@keyframes uniproIntroBoltFrame{
  0%,13%{opacity:0;transform:scale(1.025)}
  17%,34%{opacity:1;transform:scale(1)}
  37%,100%{opacity:0;transform:scale(.995)}
}
@keyframes uniproIntroBoltFace{
  0%,14%{opacity:0;clip-path:inset(0 0 100% 0)}
  20%{opacity:1;clip-path:inset(0)}
  25%{opacity:.04;clip-path:inset(0)}
  29%{opacity:1;clip-path:inset(0)}
  35%,100%{opacity:0;clip-path:inset(0)}
}
@keyframes uniproIntroBoltAura{
  0%,14%{opacity:0}
  18%{opacity:.76}
  25%{opacity:.03}
  29%{opacity:.94}
  36%,100%{opacity:0}
}
@keyframes uniproIntroBoltEdge{
  0%,17%{opacity:0}
  20%{opacity:1}
  25%{opacity:.05}
  29%{opacity:.95}
  35%,100%{opacity:0}
}
@keyframes uniproIntroBoltShard{
  0%,25%{opacity:0;transform:translate(-10px,12px) scale(.82)}
  29%{opacity:1;transform:none}
  35%,100%{opacity:0;transform:translate(18px,-12px) scale(1.08)}
}
@keyframes uniproIntroImpact{
  0%,18%{opacity:0;transform:translateX(-50%) scale(.08)}
  23%{opacity:1;transform:translateX(-50%) scale(1)}
  29%{opacity:.12;transform:translateX(-50%) scale(1.46)}
  33%{opacity:.72;transform:translateX(-50%) scale(1.7)}
  41%,100%{opacity:0;transform:translateX(-50%) scale(2.25)}
}
@keyframes uniproIntroGroundWave{
  0%,19%{opacity:0;transform:scaleX(.02)}
  24%{opacity:1;transform:scaleX(.34)}
  33%{opacity:.5;transform:scaleX(1)}
  42%,100%{opacity:0;transform:scaleX(1.14)}
}
@keyframes uniproIntroExit{
  0%,46%{opacity:1;visibility:visible}
  54%{opacity:.98;visibility:visible}
  95%{opacity:0;visibility:visible}
  100%{opacity:0;visibility:hidden}
}
