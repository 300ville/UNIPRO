function fsaBookTaxResponseIssue(row){
  if(!fsaRowApplies(row)) return "";
  const imported = parseAmountResult(row.sourceTaxAmount);
  if(imported.ok) return "";
  if(!imported.blank) return "The imported Federal tax amount is invalid. Correct the source report, then replace the current account list in Step 2.";
  if(!["yes","no"].includes(row.fsaBookEqualsTax)) return "Answer whether the Book amount equals the Federal tax amount.";
  if(row.fsaBookEqualsTax === "no"){
    const entered = parseAmountResult(row.fsaTaxAmount);
    if(!entered.ok) return entered.blank ? "Enter the Federal tax amount, including zero." : "Enter a valid Federal tax amount.";
    if(isZeroMoney(entered.value - fsaBookAmount(row))) return "The entered Federal tax amount equals Book; select Yes instead.";
  }
  return "";
}

function fsaManualSupplementIssue(row){
