function step1MissingFields(){
  normalizeUnicapScreeningState();
  const missing = [];
  if(!String(state.clientName || "").trim()) missing.push("taxpayer name");
  if(!validTaxYearEnding(state.taxYear)) missing.push("a valid tax year ending date");
  if(!["producer","reseller","producerReseller"].includes(state.activityProfile)) missing.push("taxpayer type");
  if(!["yes","no"].includes(state.unicapPriorYearApplied)) missing.push("whether the taxpayer capitalized additional Section 263A costs last year");
  if(state.unicapPriorYearApplied === "yes" && !["unchanged","changing"].includes(state.unicapMethodContinuity)) missing.push("whether this year's UNICAP methods are changing");
  if(state.unicapHistory === "firstYear" && !["newActivity","newlySubject","priorNoncompliance"].includes(state.firstUnicapYearReason)) missing.push("why this is the first UNICAP year");
  if(state.unicapHistory === "priorChanging" && (!Array.isArray(state.unicapChangeComponents) || state.unicapChangeComponents.length === 0)) missing.push("the UNICAP method component changing this year");
  if(["priorUnchanged","priorChanging"].includes(state.unicapHistory) && state.activityType === "producer"){
    if(!["SPM","MSPM"].includes(state.priorSelectedMethod)) missing.push("last year's production calculation");
    if(!["labor","production","direct","step","reasonable","none"].includes(state.priorMixedServiceMethod)) missing.push("last year's mixed service method");
    if(state.priorSelectedMethod === "MSPM" && ["labor","production"].includes(state.priorMixedServiceMethod) && !["materials","labor"].includes(state.priorMixedMspmSplitMethod)) missing.push("last year's MSPM mixed-service allocation method");
  }
  if(state.activityType === "reseller"){
    if(!["exclusive","deMinimis","contract"].includes(state.srmEligibility)) missing.push("SRM eligibility");
    if(!["actual","historic"].includes(state.srmRatioMode)) missing.push("SRM ratio method");
    if(state.srmRatioMode === "historic" && (!(srmHistoricRatioValue() >= 0) || !String(state.srmHistoricSupport || "").trim())) missing.push("historic absorption ratio and support");
  }
  if(!["FIFO","LIFO"].includes(state.inventoryMethod)) missing.push("inventory valuation method");
  if(state.inventoryMethod === "LIFO" && state.lifoActualRatioConfirmed !== "yes") missing.push("actual current-year absorption ratios");
  else if(state.inventoryMethod === "LIFO" && state.lifoCoverage !== "all") missing.push("the complete LIFO inventory population");
  if(!["tax","book"].includes(state.amountBasis)) missing.push("amount basis");
  if(state.amountBasis === "book"){
    if(state.financialStatementQualified !== "yes") missing.push("qualifying financial statement");
    else if(state.financialStatementMethodAdopted !== "yes") missing.push("adopted or consented method");
    else if(state.financialStatementValuationExcluded !== "yes") missing.push("removal of write-downs, reserves, and valuation adjustments");
    else if(state.activityType !== "reseller" && !["yes","no"].includes(state.financialStatementGrossReceiptsEligible)) missing.push("three-year gross receipts test");
  }
  if(state.activityType !== "reseller" && !["applies","doesNotApply"].includes(state.indirectCostRule)) missing.push("the $200,000 producer-rule answer");
  return missing;
}

