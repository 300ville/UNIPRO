  if(state.suggestionBasis === "description") return description;
  return [account,description].filter(Boolean).join(" ");
}

function suggestLaborTreatment(inputId,account,description){
  if(["begraw","begresale","begprod","begadd","endraw","endresale","endprod"].includes(inputId)) return "none";
  if(["review","breakoutCogs","breakoutPurchases","breakoutProductionCost","breakoutInventoryVariance","breakoutBookTaxReserve","breakoutOther"].includes(inputId)) return "review";
  if(inputId === "mixedservice") return "none";
  const text = normalizeClassificationText(suggestionSignalText(account,description));
  const preProductionTerms = [
    "purchasing labor","purchasing payroll","procurement labor","procurement payroll","receiving labor","receiving payroll",
    "purchasing wages","purchasing salaries","purchasing department labor","purchasing department payroll","purchasing department wages","purchasing department salaries",
    "procurement wages","procurement salaries","procurement department labor","procurement department payroll","procurement department wages","procurement department salaries",
    "receiving wages","receiving salaries","receiving department labor","receiving department payroll","receiving department wages","receiving department salaries",
    "materials handling labor","materials handling payroll","materials handling wages","materials handling salaries",
    "material handling labor","material handling payroll","material handling wages","material handling salaries",
    "raw material handling labor","raw material handling payroll","raw material handling wages","raw material handling salaries",
    "raw material storage labor","raw material storage payroll","raw material storage wages","raw material storage salaries","buyer payroll","buyer wages","buyer salaries"
  ];
  const productionTerms = [
    "direct labor","production labor","production payroll","manufacturing labor","manufacturing payroll","factory labor","factory payroll",
    "direct production wages","direct production payroll","direct production salaries","production wages","production salaries",
    "manufacturing wages","manufacturing salaries","factory wages","factory salaries","assembly labor","assembly payroll","assembly wages","assembly salaries",
    "plant labor","plant payroll","plant wages","plant salaries","shop labor","shop payroll","shop wages","shop salaries",
    "factory supervision labor","factory supervision payroll","factory supervision wages","factory supervision salaries",
    "factory supervisor labor","factory supervisor payroll","factory supervisor wages","factory supervisor salaries",
    "quality control labor","quality control payroll","quality control wages","quality control salaries",
    "plant maintenance labor","plant maintenance payroll","plant maintenance wages","plant maintenance salaries",
    "factory maintenance labor","factory maintenance payroll","factory maintenance wages","factory maintenance salaries",
    "finished goods warehouse labor","finished goods warehouse payroll","finished goods warehouse wages","finished goods warehouse salaries",
    "production engineering labor","production engineering payroll","production engineering wages","production engineering salaries"
  ];
  const otherLaborTerms = [
    "sales payroll","selling payroll","marketing payroll","administrative payroll","admin payroll","office payroll","corporate payroll",
    "sales salaries","selling salaries","marketing salaries","administrative salaries","admin salaries","office salaries","corporate salaries",
    "employee sales commissions","sales commissions","sales commission","executive compensation","nonproduction labor","non production labor","general and administrative payroll"
  ];
  const genericLaborTerms = ["labor","payroll","wages","salary","salaries","compensation"];
  const explicitNonLaborTerms = [
    "depreciation","amortization","advertising","interest expense","interest cost","insurance","rent expense","lease expense",
    "utilities","utility expense","freight","property tax","income tax","materials and supplies","factory supplies","repair expense",
    "maintenance expense","royalty expense","license fee","licensing fee"
  ];

  if(textIncludesAny(text,preProductionTerms)) return "preproduction";
  if(textIncludesAny(text,productionTerms)) return "production";
  if(textIncludesAny(text,otherLaborTerms)) return "other";
  if(textIncludesAny(text,genericLaborTerms)) return "review";
  if(["raw","resale","excludedSales","excludedOtherIncome","excludedInterest","excludedIncomeTax"].includes(inputId)) return "none";
  if(textIncludesAny(text,explicitNonLaborTerms)) return "none";
  return "review";
}

function suggestCostTreatment(inputId,account,description){
  const text = normalizeClassificationText(suggestionSignalText(account,description));
  if(["begraw","begresale","begprod","begadd","endraw","endresale","endprod"].includes(inputId)) return "excluded";
  if(inputId === "mixedservice") return "excluded";
  if(textIncludesAny(text,["interest expense","interest cost","income tax","federal tax provision","state income tax","foreign income tax"])) return "excluded";
  if(["excludedSales","excludedOtherIncome","excludedInterest","excludedIncomeTax"].includes(inputId)) return "excluded";
  if(["raw","resale","prod471","preadd","prodadd","excludedSoldOnly"].includes(inputId)) return "sec263a";
  if(["excludedSelling","excludedMarketing","excludedDelivery"].includes(inputId)) return "other";
  if(["review","breakoutCogs","breakoutPurchases","breakoutProductionCost","breakoutInventoryVariance","breakoutBookTaxReserve","breakoutOther","excludedOther"].includes(inputId)) return "review";
  return "review";
}

function syncBaseSuggestions(item,resetSelection=false){
  if(!item) return item;
  item.suggestedLaborTreatment = suggestLaborTreatment(item.inputId,item.account,item.description);
  item.suggestedCostTreatment = suggestCostTreatment(item.inputId,item.account,item.description);
  if(resetSelection || !LABOR_BASE_BY_ID[item.laborTreatment]){
    item.laborTreatment = item.suggestedLaborTreatment;
    item.laborConfirmed = !["review","detail"].includes(item.laborTreatment);
  }
  if(resetSelection || !COST_BASE_BY_ID[item.costTreatment]){
    item.costTreatment = item.suggestedCostTreatment;
    item.costConfirmed = !["review","detail"].includes(item.costTreatment);
  }
  if(["review","detail"].includes(item.laborTreatment)) item.laborConfirmed = false;
  if(["review","detail"].includes(item.costTreatment)) item.costConfirmed = false;
  return item;
}

function applyAutomaticBaseClassifications(){
  let changed = false;
  allocationBaseRows().forEach(row => {
    const suggestedLabor = suggestLaborTreatment(row.inputId,row.account,row.description);
    const suggestedCost = suggestCostTreatment(row.inputId,row.account,row.description);
    if(row.suggestedLaborTreatment !== suggestedLabor || row.suggestedCostTreatment !== suggestedCost) changed = true;
    row.suggestedLaborTreatment = suggestedLabor;
    row.suggestedCostTreatment = suggestedCost;
    if(row.laborTreatment === "review" && row.suggestedLaborTreatment !== "review"){
      if(row.laborTreatment !== row.suggestedLaborTreatment || row.laborConfirmed !== true) changed = true;
      row.laborTreatment = row.suggestedLaborTreatment;
      row.laborConfirmed = true;
    }
    if(row.costTreatment === "review" && row.suggestedCostTreatment !== "review"){
      if(row.costTreatment !== row.suggestedCostTreatment || row.costConfirmed !== true) changed = true;
      row.costTreatment = row.suggestedCostTreatment;
      row.costConfirmed = true;
    }
  });
  if(changed) invalidateCalculationApprovals();
  return changed;
}

