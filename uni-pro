function skipTour(){
  $("tourOverlay").classList.add("hidden");
  const c = calc();
  renderWorkflow(c,buildValidationItems(c));
}

function nextTourStep(){
  tourIndex++;
  if(tourIndex >= tourSteps.length){
    skipTour();
    return;
  }
  positionTour();
}

function positionTour(){
  const step = tourSteps[tourIndex];
  const target = document.querySelector(step.selector) || $("app");
  const stage = target.classList && target.classList.contains("workflow-stage") ? target : target.closest && target.closest(".workflow-stage");
  if(stage){
    state.currentStage = Number(stage.dataset.step || 1);
    document.querySelectorAll(".workflow-stage").forEach(item => item.classList.toggle("stage-active",item === stage));
  }
  const r = target.getBoundingClientRect();
  const pad = 8;
  const h = $("tourHighlight");
  const card = $("tourCard");

  h.style.left = Math.max(8,r.left-pad) + "px";
  h.style.top = Math.max(8,r.top-pad) + "px";
  h.style.width = Math.max(80,Math.min(window.innerWidth-16,r.width+pad*2)) + "px";
  h.style.height = Math.max(50,Math.min(window.innerHeight-16,r.height+pad*2)) + "px";

  $("tourCount").textContent = `Step ${tourIndex+1} of ${tourSteps.length}`;
  $("tourTitle").textContent = step.title;
  $("tourBody").textContent = step.body;
  $("tourNext").textContent = tourIndex === tourSteps.length-1 ? "Done" : "Next";

  const w = Math.min(380,window.innerWidth-40);
  card.style.left = (r.right+24+w < window.innerWidth ? r.right+24 : Math.max(20,Math.min(window.innerWidth-w-20,r.left))) + "px";
  card.style.top = Math.max(20,Math.min(window.innerHeight-190,r.top)) + "px";
}

