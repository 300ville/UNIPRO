        <div class="command-metrics">
          <button type="button" onclick="showExceptionQueue('all')"><span>Imported</span><strong id="metricImported">0</strong></button>
          <button type="button" onclick="showExceptionQueue('all')"><span>Reviewed</span><strong id="metricReviewed">0</strong></button>
          <button type="button" onclick="showExceptionQueue('review')"><span>Balance to review</span><strong id="metricUnresolvedNet">None</strong></button>
          <button type="button" onclick="showExceptionQueue('review')"><span>Total dollars to review</span><strong id="metricUnresolvedDollars">None</strong></button>
