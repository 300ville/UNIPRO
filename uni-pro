function goToNextUnresolved(){
  const c = calc();
  const items = buildValidationItems(c);
  const model = workflowModel(c,items);
  if(partnerReviewIsCurrent()){
    exportExcel();
    return;
  }
  if(model.action.step === 3){
    const row = unresolvedAccountRows()[0];
    setActiveMappingView("review");
    openStage(3,true);
    renderRows();
    if(row) openAccountInspector(row.id);
    return;
  }
  openStage(model.action.step,true);
  const nextSignoffField = !staffReviewIsCurrent() ? "staffReviewName" : !managerReviewIsCurrent() ? "managerReviewName" : !seniorManagerReviewIsCurrent() ? "seniorManagerReviewName" : "partnerReviewName";
  const focusMap = {1:"clientName",2:"pasteBox",4:"inventoryInputBox",5:"mixedServiceMethodField",7:"validationBox",9:nextSignoffField};
  const target = $(focusMap[model.action.step]);
  if(target) setTimeout(() => target.focus ? target.focus() : target.scrollIntoView({behavior:"smooth"}),0);
}

