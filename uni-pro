    clearSetupAnswer("lifoActualRatioConfirmed");
    clearSetupAnswer("lifoCoverage");
  } else if(state.lifoActualRatioConfirmed !== "yes"){
    clearSetupAnswer("lifoCoverage");
  }
  if(state.amountBasis !== "book"){
    clearSetupAnswer("financialStatementQualified");
    clearSetupAnswer("financialStatementMethodAdopted");
    clearSetupAnswer("financialStatementValuationExcluded");
    clearSetupAnswer("financialStatementGrossReceiptsEligible");
