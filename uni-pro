function leadingAccountNumber(value){
  const match = String(value || "").match(/(?:^|\s)(\d{4,8})(?=\s|$|[-_.])/);
  return match ? Number(match[1]) : null;
}

function classifyAccountNumber(value){
  const normalized = normalizeClassificationText(value);
  const mnemonic = ACCOUNT_MNEMONIC_RULES.find(rule => rule.pattern.test(normalized));
  if(mnemonic) return {inputId:mnemonic.id,confidence:mnemonic.confidence,reason:`Account number: ${mnemonic.reason}`,review:false,matched:true,signalStrength:2};
  const number = leadingAccountNumber(value);
  if(number === null) return {inputId:"review",confidence:"Low",reason:"Account number did not contain a recognized code or mnemonic.",review:true,matched:false,signalStrength:0};
  const normalizedFiveDigit = number >= 100000 ? Number(String(number).slice(0,5)) : number;
  const rule = ACCOUNT_NUMBER_RANGE_RULES.find(item => normalizedFiveDigit >= item.min && normalizedFiveDigit <= item.max);
  if(!rule) return {inputId:"review",confidence:"Low",reason:`Account number ${number} is outside the supported conventional ranges.`,review:true,matched:false,signalStrength:0};
  if(rule.id === "review") return {inputId:"review",confidence:"Low",reason:`Account number ${number}: ${rule.reason}`,review:true,matched:false,signalStrength:0,rangeObserved:true};
  return {inputId:rule.id,confidence:rule.confidence,reason:`Account number ${number}: ${rule.reason}`,review:false,matched:true,signalStrength:rule.confidence === "Medium" ? 1 : .5};
}

function classifySignal(value,sourceLabel){
  const raw = String(value || "").toLowerCase();
  const normalized = normalizeClassificationText(raw);
  const d = `${raw} ${normalized}`.trim();
  const genericEndingLayer = /(ending resale|ending goods bought for resale|closing inventory, merchandise|ending wip|ending work in process|ending work-in-process|ending finished goods|ending production inventory|closing inventory, work in process|closing inventory, work-in-process|closing inventory, finished goods|closing inventory, production cost variance)/.test(d);
  const explicitlyCurrentYear = /(current[- ]year|current year|fifo layer)/.test(d);
  if(genericEndingLayer && !explicitlyCurrentYear){
    return {inputId:"breakoutInventoryVariance",confidence:"Medium",reason:`${sourceLabel} identifies a generic ending balance, not the required current-year FIFO layer.`,review:false,matched:true};
  }
  if(sourceLabel === "Account number"){
    return classifyAccountNumber(value);
  }
  const exactSalesDescriptions = new Set(["sales","gross sales","net sales","product sales","service sales"]);
  if(sourceLabel === "Account description" && exactSalesDescriptions.has(normalized)){
    return {inputId:"excludedSales",confidence:"High",reason:"Account description: Standalone Sales identifies sales revenue.",review:false,matched:true,signalStrength:3,standaloneSales:true};
  }
  for(const rule of orderedAutoRules){
    if(rule.terms.some(term => d.includes(term) || normalized.includes(normalizeClassificationText(term)))){
      return {inputId:rule.id,confidence:rule.confidence,reason:`${sourceLabel}: ${rule.reason}`,review:false,matched:true,signalStrength:rule.confidence === "High" ? 3 : 2};
    }
  }
  if(ambiguousTerms.some(term => d.includes(term) || normalized.includes(normalizeClassificationText(term)))){
    return {inputId:"review",confidence:"Low",reason:`${sourceLabel} is ambiguous and requires review.`,review:true,matched:false};
  }
  return {inputId:"review",confidence:"Low",reason:`${sourceLabel} did not match a classification rule.`,review:true,matched:false};
}

function classifySourceAccount(account,description,basis=(state && state.suggestionBasis) || "both"){
  const selectedBasis = ["account","description","both"].includes(basis) ? basis : "both";
  if(state && state.activityType === "reseller" && selectedBasis !== "account"){
    const srmText = normalizeClassificationText(description);
    const purchasingTerms = ["purchasing","procurement","buyer","buyers","assistant buyer","vendor selection","supplier selection","purchase order","merchandise selection"];
    const storageHandlingTerms = ["warehouse","warehousing","storage","receiving","unloading","unpacking","inspection","sorting","tagging","marking","stocking","handling","distribution center","fulfillment center","repackaging","assembling shipment"];
    if(purchasingTerms.some(term => srmText.includes(term))) return {inputId:"srmpurchasing",confidence:"Medium",reason:"Account description and source context identify an SRM purchasing activity. Confirm the amount excludes costs already included in Section 471 and includes only the properly allocable purchasing function.",review:false,matched:true,signalStrength:2};
    if(storageHandlingTerms.some(term => srmText.includes(term))) return {inputId:"srmstoragehandling",confidence:"Medium",reason:"Account description and source context identify an SRM storage or handling activity. Confirm the on-site, off-site, pick-and-pack, and dual-function facility treatment.",review:false,matched:true,signalStrength:2};
  }
  const accountResult = classifySignal(account,"Account number");
  const descriptionResult = classifySignal(description,"Account description");
  if(selectedBasis === "account") return accountResult;
  if(selectedBasis === "description") return descriptionResult;
  const normalizedDescription = normalizeClassificationText(description);
  const salesNonRevenueDescription = /\bsales (?:salary|salaries|payroll|wage|wages|expense|tax|taxes)\b/.test(normalizedDescription);
  if(accountResult.inputId === "excludedSales" && salesNonRevenueDescription){
    return {inputId:"review",confidence:"Low",reason:"The account-number range suggests revenue, but the description identifies a non-revenue sales-related item.",review:true,matched:false,signalStrength:0};
  }
  const explicitSalesDescription = descriptionResult.inputId === "excludedSales" && descriptionResult.confidence === "High";
  if(explicitSalesDescription && ((accountResult.matched && accountResult.inputId !== "excludedSales") || accountResult.rangeObserved)){
    return {inputId:"review",confidence:"Low",reason:"The description identifies sales, but the account-number convention points to a different account type.",review:true,matched:false,signalStrength:0};
  }
  if(explicitSalesDescription && accountResult.inputId === "excludedSales"){
    return {...descriptionResult,reason:"The sales description and revenue-range account number agree."};
  }
  if(descriptionResult.standaloneSales === true){
    if((!accountResult.matched && !accountResult.rangeObserved) || accountResult.inputId === "excludedSales"){
      return {...descriptionResult,reason:"Standalone Sales and the available account-number signal support revenue exclusion."};
    }
    return {inputId:"review",confidence:"Low",reason:"Standalone Sales conflicts with the account-number classification.",review:true,matched:false,signalStrength:0};
  }
  if(accountResult.matched && descriptionResult.matched){
    if(accountResult.inputId !== descriptionResult.inputId){
      const accountStrength = Number(accountResult.signalStrength || 1);
      const descriptionStrength = Number(descriptionResult.signalStrength || 1);
      if(descriptionStrength > accountStrength){
        return {...descriptionResult,reason:`Description supplied the stronger, more specific signal; the account-number convention was used as secondary context. ${descriptionResult.reason} ${accountResult.reason}`};
      }
      if(accountStrength > descriptionStrength){
        return {...accountResult,reason:`Account number supplied the stronger signal; the description was used as secondary context. ${accountResult.reason} ${descriptionResult.reason}`};
      }
      return {inputId:"review",confidence:"Low",reason:`Equally strong signals conflict. ${accountResult.reason} ${descriptionResult.reason}`,review:true,matched:false};
    }
    const confidenceRank = {Low:0,Medium:1,High:2};
    const confidence = confidenceRank[accountResult.confidence] <= confidenceRank[descriptionResult.confidence] ? accountResult.confidence : descriptionResult.confidence;
    return {inputId:accountResult.inputId,confidence,reason:`Account number and description agree. ${accountResult.reason} ${descriptionResult.reason}`,review:false,matched:true};
  }
  if(accountResult.matched) return {...accountResult,reason:`Account number supplied the recognized signal. ${accountResult.reason}`};
  if(descriptionResult.matched) return {...descriptionResult,reason:`Account description supplied the recognized signal. ${descriptionResult.reason}`};
  return {inputId:"review",confidence:"Low",reason:`No classification rule matched either signal. ${accountResult.reason} ${descriptionResult.reason}`,review:true,matched:false};
}

function classifySourceAccountWithContext(account,description,contextParts=[],basis=(state && state.suggestionBasis) || "both"){
  const directSuggestion = classifySourceAccount(account,description,basis);
  if(directSuggestion.matched && directSuggestion.confidence === "High") return directSuggestion;
  const contextText = [description,...contextParts].filter(Boolean).join(" ");
  return contextText === String(description || "")
    ? directSuggestion
    : classifySourceAccount(account,contextText,basis);
}

