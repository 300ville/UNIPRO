function readReviewSignoff(){
  if(!$("staffReviewChecked")) return;
  const priorStaffChecked = state.staffReviewChecked === true;
  const priorManagerChecked = state.managerReviewChecked === true;
  const priorSeniorManagerChecked = state.seniorManagerReviewChecked === true;
  const priorPartnerChecked = state.partnerReviewChecked === true;
  const nextStaffChecked = $("staffReviewChecked").checked;
  const nextManagerChecked = $("managerReviewChecked").checked && nextStaffChecked;
  const nextSeniorManagerChecked = $("seniorManagerReviewChecked").checked && nextManagerChecked;
  const nextPartnerChecked = $("partnerReviewChecked").checked && nextSeniorManagerChecked;
  state.staffReviewChecked = nextStaffChecked;
  state.staffReviewName = $("staffReviewName").value;
  state.managerReviewChecked = nextManagerChecked;
  state.managerReviewName = $("managerReviewName").value;
  state.seniorManagerReviewChecked = nextSeniorManagerChecked;
  state.seniorManagerReviewName = $("seniorManagerReviewName").value;
  state.partnerReviewChecked = nextPartnerChecked;
  state.partnerReviewName = $("partnerReviewName").value;
  const fingerprint = (nextStaffChecked || nextManagerChecked || nextSeniorManagerChecked || nextPartnerChecked) ? calculationFingerprint() : "";
  const now = new Date().toISOString();
  if(nextStaffChecked && (!priorStaffChecked || !state.staffReviewFingerprint)){ state.staffReviewFingerprint = fingerprint; state.staffReviewAt = now; }
  if(!nextStaffChecked){ state.staffReviewFingerprint = ""; state.staffReviewAt = ""; }
  if(nextManagerChecked && (!priorManagerChecked || !state.managerReviewFingerprint)){ state.managerReviewFingerprint = fingerprint; state.managerReviewAt = now; }
  if(!nextManagerChecked){ state.managerReviewChecked = false; state.managerReviewFingerprint = ""; state.managerReviewAt = ""; }
  if(nextSeniorManagerChecked && (!priorSeniorManagerChecked || !state.seniorManagerReviewFingerprint)){ state.seniorManagerReviewFingerprint = fingerprint; state.seniorManagerReviewAt = now; }
  if(!nextSeniorManagerChecked){ state.seniorManagerReviewChecked = false; state.seniorManagerReviewFingerprint = ""; state.seniorManagerReviewAt = ""; }
  if(nextPartnerChecked && (!priorPartnerChecked || !state.partnerReviewFingerprint)){ state.partnerReviewFingerprint = fingerprint; state.partnerReviewAt = now; }
  if(!nextPartnerChecked){ state.partnerReviewChecked = false; state.partnerReviewFingerprint = ""; state.partnerReviewAt = ""; }
  if(partnerReviewIsCurrent()) state.reviewInvalidated = false;
}

