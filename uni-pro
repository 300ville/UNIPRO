      {cells:[`MSPM allocation to preproduction before 90 percent election: ${mixedSplitLabel(c)}`,resultCell(c.mixedPreProductionRatioBaseExact,"pct")],cls:"ratio-row"},
      {cells:["MSPM 90 percent election",resultCell(!c.mixedMspmNinetyEligible ? "Not available at the calculated allocation" : c.mixedMspmNinetyApplied ? `Applied: 100 percent to ${c.mixedMspmNinetyCategory}` : "Calculated allocation retained","text")]},
      {cells:["Final MSPM allocation to preproduction",resultCell(c.mixedPreProductionRatioExact,"pct")],cls:"ratio-row"},
      {cells:["Allocated to pre-production additional Section 263A costs", resultCell(c.mixedPre)], cls:"subtotal-row"},
      {cells:["Allocated to production additional Section 263A costs", resultCell(c.mixedProd)], cls:"subtotal-row"}
