function renderLifoIntegration(c){
  const box = $("lifoIntegrationBox");
  if(!box) return;
  box.classList.toggle("hidden",!lifoActive());
  if(!lifoActive()){
    box.innerHTML = "";
    return;
  }
  const pools = normalizeLifoPools();
  const totals = lifoTotals(c);
  const issues = lifoCompletionIssues(c);
  const outside = "";
  const poolHtml = pools.map((pool,index) => {
