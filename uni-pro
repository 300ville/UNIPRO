      <div class="import-preview-stat"><span>Duplicate groups</span><strong>${esc(analysis.duplicateGroups)}</strong></div>
    </div>
    ${finalControlsHtml}
    ${normalizedSample}
    ${rejectList}
    ${ignoredSummary}
    ${analysis.duplicateGroups ? `<p class="note warn"><strong>Duplicates are not deleted.</strong> They will import with their source line IDs and remain visible as manager exceptions until reviewed.</p>` : ""}
    ${state.lastImport && Array.isArray(state.lastImport.rejected) && state.lastImport.rejected.length && !(analysis.rejected || []).length && analysis.previewMode === "append" ? `<label class="checkbox-label"><input id="resolvePriorRejections" type="checkbox"> This paste fixes all ${esc(state.lastImport.rejected.length)} unread line(s) from the previous import.</label>` : ""}
    <div class="row-tools import-preview-actions">
      <button class="primary" type="button" onclick="confirmPastedImport()" ${canImport ? "" : "disabled"}>${esc(importButtonText)}</button>
      <button class="secondary" type="button" onclick="cancelImportPreview()">Cancel</button>
