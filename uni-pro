    movement471:"",
    endingLifo471Control:"",
    decrementLayers:[]
  };
}

function normalizeLifoPools(){
  if(!Array.isArray(state.lifoPools)) state.lifoPools = [];
  const seen = new Set();
  state.lifoPools = state.lifoPools.map(pool => {
    const normalized = {...newLifoPool(),...(pool && typeof pool === "object" ? pool : {})};
    if(!normalized.id || seen.has(normalized.id)) normalized.id = cryptoRandomId();
    seen.add(normalized.id);
    normalized.decrementLayers = Array.isArray(normalized.decrementLayers) ? normalized.decrementLayers.map(layer => ({...newLifoDecrementLayer(),...(layer && typeof layer === "object" ? layer : {})})) : [];
    return normalized;
  });
  return state.lifoPools;
}

function lifoPoolById(poolId){
  return normalizeLifoPools().find(pool => pool.id === poolId);
}

function lifoLayerById(pool,layerId){
  return pool && Array.isArray(pool.decrementLayers) ? pool.decrementLayers.find(layer => layer.id === layerId) : null;
}

function lifoParsed(value){
  const parsed = parseAmountResult(value);
  return parsed.ok && !parsed.blank ? parsed.value : 0;
}

function lifoLayerRelease(layer){
  const section471 = lifoParsed(layer.layerSection471);
  const additional = lifoParsed(layer.layerAdditional263A);
  const decrement = lifoParsed(layer.decrement471);
  return section471 > MONEY_EPSILON ? additional * decrement / section471 : 0;
}

function lifoPoolCalculation(pool,c){
  const movement = lifoParsed(pool.movement471);
  const increment = Math.max(movement,0);
  const decrement = Math.max(-movement,0);
  const beginning471 = lifoParsed(pool.beginningLifo471);
  const beginningAdditional = lifoParsed(pool.beginningAdditional263A);
  const release = movement < -MONEY_EPSILON ? (pool.decrementLayers || []).reduce((sum,layer) => sum + lifoLayerRelease(layer),0) : 0;
  const ending471 = beginning471 + movement;
  const spmRatio = c && !c.indirectCostRuleApplies ? c.spmRatioRaw : 0;
  const mspmRatio = c && !c.indirectCostRuleApplies && !isZeroMoney(c.end471) ? c.mspmComputedCap / c.end471 : 0;
  const spmCurrentAddition = increment * spmRatio;
  const mspmCurrentAddition = increment * mspmRatio;
  return {
    movement,increment,decrement,beginning471,beginningAdditional,release,ending471,spmRatio,mspmRatio,
    spmCurrentAddition,mspmCurrentAddition,
    spmEndingAdditional:beginningAdditional + spmCurrentAddition - release,
    mspmEndingAdditional:beginningAdditional + mspmCurrentAddition - release
  };
}

function lifoPoolIssues(pool,index,c){
  const label = String(pool.name || "").trim() || `Pool ${index + 1}`;
  const issues = [];
  const requireText = (value,field) => { if(!String(value || "").trim()) issues.push(`${label}: enter ${field}.`); };
  const requireAmount = (value,field,{nonnegative=false,positive=false}={}) => {
    const parsed = parseAmountResult(value);
    if(!parsed.ok || parsed.blank){ issues.push(`${label}: enter a valid ${field}.`); return null; }
    if(nonnegative && parsed.value < -MONEY_EPSILON) issues.push(`${label}: ${field} cannot be negative.`);
    if(positive && parsed.value <= MONEY_EPSILON) issues.push(`${label}: ${field} must be greater than zero.`);
    return parsed.value;
  };
  requireText(pool.name,"pool or grouping name");
  if(!["dollarValue","specificGoods"].includes(pool.lifoType)) issues.push(`${label}: identify the LIFO method as dollar-value or specific-goods.`);
  requireText(pool.methodSource,"the adopted LIFO method or index source");
  requireText(pool.reference,"the LIFO schedule or workpaper reference");
  if(pool.excludesAdditional263A !== "yes") issues.push(`${label}: confirm that the LIFO schedule and Section 471 amounts exclude additional Section 263A costs.`);
  if(financialStatementAlternativeActive() && pool.fsaBasisConfirmed !== "yes") issues.push(`${label}: confirm that every Section 471 amount uses the same adopted financial-statement-alternative basis as the non-LIFO ratio support.`);
  requireAmount(pool.currentCostEnding471,"current-cost ending Section 471 amount",{nonnegative:true});
  const beginning471 = requireAmount(pool.beginningLifo471,"beginning LIFO Section 471 amount",{nonnegative:true});
  const beginningAdditional = requireAmount(pool.beginningAdditional263A,"beginning additional Section 263A layer");
  const movement = requireAmount(pool.movement471,"signed current-year Section 471 movement");
  const endingControl = requireAmount(pool.endingLifo471Control,"independent ending LIFO Section 471 control",{nonnegative:true});
  if(movement !== null && beginning471 !== null){
    const derivedEnding = beginning471 + movement;
    if(derivedEnding < -MONEY_EPSILON) issues.push(`${label}: the signed movement would make ending LIFO Section 471 inventory negative.`);
    if(endingControl !== null && Math.abs(derivedEnding - endingControl) >= SOURCE_CONTROL_EPSILON) issues.push(`${label}: derived ending LIFO Section 471 differs from the independent control by ${moneyWp(derivedEnding - endingControl)}.`);
    if(movement < -MONEY_EPSILON){
      const layers = Array.isArray(pool.decrementLayers) ? pool.decrementLayers : [];
      if(!layers.length) issues.push(`${label}: a decrement requires the invaded prior-layer schedule.`);
      if(pool.decrementLayersComplete !== "yes") issues.push(`${label}: confirm that every invaded layer is entered completely and in the order required by the adopted LIFO method.`);
      const years = new Set();
      let layerDecrement = 0;
      let released = 0;
      layers.forEach((layer,layerIndex) => {
        const layerLabel = `${label}, invaded layer ${layerIndex + 1}`;
        const year = String(layer.layerYear || "").trim();
        if(!year) issues.push(`${layerLabel}: enter the layer year.`);
        else if(pool.lifoType === "dollarValue" && years.has(year)) issues.push(`${label}: layer year ${year} is duplicated for this dollar-value pool.`);
        else years.add(year);
        requireText(layer.reference,`${layerLabel.toLowerCase()} reference`);
        const layer471 = requireAmount(layer.layerSection471,`${layerLabel.toLowerCase()} beginning Section 471 amount`,{positive:true});
        requireAmount(layer.layerAdditional263A,`${layerLabel.toLowerCase()} beginning additional Section 263A amount`);
        const decrement471 = requireAmount(layer.decrement471,`${layerLabel.toLowerCase()} Section 471 amount liquidated`,{positive:true});
        if(layer471 !== null && decrement471 !== null && decrement471 - layer471 >= SOURCE_CONTROL_EPSILON) issues.push(`${layerLabel}: the liquidation exceeds the beginning Section 471 layer.`);
        if(decrement471 !== null) layerDecrement += decrement471;
        released += lifoLayerRelease(layer);
      });
      if(Math.abs(layerDecrement + movement) >= SOURCE_CONTROL_EPSILON) issues.push(`${label}: invaded-layer Section 471 amounts differ from the pool decrement by ${moneyWp(layerDecrement + movement)}.`);
      if(beginningAdditional !== null && beginningAdditional >= 0 && released - beginningAdditional >= SOURCE_CONTROL_EPSILON) issues.push(`${label}: released additional Section 263A exceeds the pool's beginning additional Section 263A balance.`);
    }
  }
  return issues;
}

function lifoCompletionIssues(c){
  if(!lifoActive()) return [];
  const pools = normalizeLifoPools();
  const issues = [];
  if(state.lifoActualRatioConfirmed !== "yes") issues.push("Confirm that actual current-year absorption ratios, rather than a historic absorption ratio, apply to this workpaper.");
  if(state.lifoCoverage !== "all") issues.push("This version requires the full inventory population in the workpaper to use LIFO. Separate a mixed LIFO/non-LIFO population before continuing.");
  if(!pools.length) issues.push("Add at least one LIFO pool or specific-goods grouping.");
  pools.forEach((pool,index) => issues.push(...lifoPoolIssues(pool,index,c)));
  const outsidePre = 0;
  const outsideProd = 0;
  const currentCostPoolTotal = pools.reduce((sum,pool) => sum + lifoParsed(pool.currentCostEnding471),0);
  if(c && Math.abs(currentCostPoolTotal + outsidePre + outsideProd - c.end471) >= SOURCE_CONTROL_EPSILON){
    issues.push(`LIFO pool current-cost Section 471 amounts plus inventory outside LIFO differ from the non-LIFO ending Section 471 control by ${moneyWp(currentCostPoolTotal + outsidePre + outsideProd - c.end471)}.`);
  }
  const openingAdditionalControl = inventoryModeValue("begadd");
  const poolOpeningAdditional = pools.reduce((sum,pool) => sum + lifoParsed(pool.beginningAdditional263A),0);
  if(Math.abs(poolOpeningAdditional - openingAdditionalControl) >= SOURCE_CONTROL_EPSILON){
    issues.push(`LIFO pool beginning additional Section 263A differs from the independently supported prior-year ending additional Section 263A control by ${moneyWp(poolOpeningAdditional - openingAdditionalControl)}.`);
  }
  return issues;
}

function lifoTotals(c){
  const pools = normalizeLifoPools();
  const poolCalculations = pools.map(pool => ({pool,...lifoPoolCalculation(pool,c)}));
  const outsidePre = 0;
  const outsideProd = 0;
  const outside471 = outsidePre + outsideProd;
  const spmRatio = c && !c.indirectCostRuleApplies ? c.spmRatioRaw : 0;
  const mspmRatio = c && !c.indirectCostRuleApplies && !isZeroMoney(c.end471) ? c.mspmComputedCap / c.end471 : 0;
  const outsideSpmAddition = c && !c.indirectCostRuleApplies ? outside471 * c.spmRatioRaw : 0;
  const outsideMspmAddition = c && !c.indirectCostRuleApplies ? outsidePre * c.preRatioRaw + outsideProd * c.prodRatioRaw : 0;
  const total = key => poolCalculations.reduce((sum,item) => sum + Number(item[key] || 0),0);
  const ending471 = total("ending471") + outside471;
  const beginning471 = total("beginning471");
  const beginningAdditional = total("beginningAdditional");
  const increment471 = total("increment");
  const decrement471 = total("decrement");
  const release263A = total("release");
  const spmCurrentAddition = total("spmCurrentAddition") + outsideSpmAddition;
  const mspmCurrentAddition = total("mspmCurrentAddition") + outsideMspmAddition;
  const spmEndingAdditional = beginningAdditional + spmCurrentAddition - release263A;
  const mspmEndingAdditional = beginningAdditional + mspmCurrentAddition - release263A;
  return {
    pools:poolCalculations,outsidePre,outsideProd,outside471,
    currentCostEnding471:poolCalculations.reduce((sum,item) => sum + lifoParsed(item.pool.currentCostEnding471),0) + outside471,
    beginning471,beginningAdditional,increment471,decrement471,release263A,ending471,spmRatio,mspmRatio,
    outsideSpmAddition,outsideMspmAddition,spmCurrentAddition,mspmCurrentAddition,
    spmEndingAdditional,mspmEndingAdditional,
    spmEndingTax:ending471 + spmEndingAdditional,
    mspmEndingTax:ending471 + mspmEndingAdditional,
    spmCurrentAdjustment:spmCurrentAddition - release263A,
    mspmCurrentAdjustment:mspmCurrentAddition - release263A,
    spmAdditionalToCogs:(c ? c.add263A : 0) - spmCurrentAddition + release263A,
    mspmAdditionalToCogs:(c ? c.add263A : 0) - mspmCurrentAddition + release263A
  };
}

