function rerenderRowSurfacesPreservingFocus(){
  const selector = 'input:not([disabled]),select:not([disabled]),textarea:not([disabled]),button:not([disabled]),[contenteditable="true"]';
  const active = document.activeElement;
  const surfaces = [$("rowsBody"),$("accountInspectorBody")].filter(Boolean);
  const activeSurface = surfaces.find(surface => active && surface.contains(active));
  const focusIndex = activeSurface ? Array.from(activeSurface.querySelectorAll(selector)).indexOf(active) : -1;
  const selectionStart = active && typeof active.selectionStart === "number" ? active.selectionStart : null;
  const selectionEnd = active && typeof active.selectionEnd === "number" ? active.selectionEnd : null;
  const restoreInspector = activeSurface === $("accountInspectorBody");
  renderRows();
  if($("accountInspectorOverlay") && !$("accountInspectorOverlay").classList.contains("hidden") && activeInspectorRowId) renderAccountInspector();
  const replacementSurface = restoreInspector ? $("accountInspectorBody") : $("rowsBody");
  if(focusIndex < 0 || !replacementSurface) return;
  const controls = Array.from(replacementSurface.querySelectorAll(selector));
  const replacement = controls[Math.min(focusIndex,Math.max(0,controls.length-1))];
  if(!replacement) return;
  replacement.focus({preventScroll:true});
  if(selectionStart !== null && typeof replacement.setSelectionRange === "function"){
    const max = String(replacement.value || "").length;
    replacement.setSelectionRange(Math.min(selectionStart,max),Math.min(selectionEnd ?? selectionStart,max));
  }
}

