function mixedMethodCardHtml(c,kind,ready,issueCount){
  const isLabor = kind === "labor";
  const selected = c.mixedServiceMethod === kind;
  const title = isLabor ? "Labor-based calculation" : "Production-cost calculation";
  const description = isLabor
    ? "Compares inventory-related labor with all labor."
    : "Compares inventory-related costs with all business costs.";
  const definition = isLabor
    ? "The labor-based ratio is Section 263A labor divided by total labor, excluding labor already included in mixed service costs. UNIPRO multiplies the mixed service cost pool by that full-precision ratio."
    : "The production-cost ratio is Section 263A production or resale costs divided by total trade-or-business costs, with the required exclusions. UNIPRO multiplies the mixed service cost pool by that full-precision ratio.";
  const ratio = isLabor ? c.mixedLaborRatioExact : c.mixedProductionCostRatioExact;
  const amount = isLabor ? c.mixedLaborCapitalizable : c.mixedProductionCostCapitalizable;
  const denominator = isLabor ? c.mixedTotalLabor : c.mixedTotalCosts;
  const numerator = isLabor ? c.mixedSec263ALabor : c.mixedSec263AProductionCosts;
  const previewAvailable = denominator > 0 && numerator >= 0 && numerator <= denominator;
  const stateText = ready
    ? (selected ? "Used in workpaper" : "Calculated")
    : previewAvailable
      ? `Preview · ${issueCount} to review`
      : `${issueCount} account choice${issueCount === 1 ? "" : "s"}`;
  const valueLabel = ready ? `${pct(ratio)} of the pool` : previewAvailable ? `Partial preview · ${pct(ratio)} of the pool` : "Needs account review";
  return `<article class="msc-method-card ${isLabor ? "is-labor" : "is-production"} ${selected ? "is-selected" : ""}">
    <span class="msc-method-state ${ready ? "" : "needs-review"}">${esc(stateText)}</span>
    <strong>${esc(title)}</strong>
    <small>${esc(description)}</small>
    <button type="button" class="msc-info-link row-action-link row-definition-link" onmouseenter="showDefinitionTooltip(this)" onmouseleave="hideDefinitionTooltip(this)" onfocus="showDefinitionTooltip(this)" onblur="hideDefinitionTooltip(this)" data-definition-label="${esc(title)}" data-definition="${esc(definition)}" aria-describedby="selectionDefinitionTooltip">Definition</button>
    <div class="msc-card-values"><span>${esc(valueLabel)}</span><b>${previewAvailable ? esc(moneyWp(amount)) : "—"}</b></div>
  </article>`;
}

