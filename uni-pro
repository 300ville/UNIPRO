/* ==========================================================================\n   UNIPRO faded electric-purple interface\n   ========================================================================== */
:root{
  --black:#28233f;
  --ink:#302b48;
  --muted:#716d86;
  --line:#dddaf5;
  --paper:rgba(255,255,255,.95);
  --off:#f8f7ff;
  --accent:#9999ff;
  --accent-2:#b7b1ff;
  --accent-3:#7770e5;
  --accent-soft:#f0efff;
  --mauve:#aaa2f4;
  --lavender:#dad7ff;
  --plum:#49436f;
  --green:#2f7d67;
  --green-soft:#eaf7f2;
  --red:#a13c62;
  --red-soft:#fff0f5;
  --blue:#7770e5;
  --blue-soft:#f0efff;
  --amber:#9a6b20;
  --amber-soft:#fff8e7;
  --shadow:0 18px 46px rgba(73,67,111,.09);
  --shadow-hover:0 24px 58px rgba(73,67,111,.14);
  --serif:"Segoe UI",SegoeUI,Arial,Helvetica,sans-serif;
  --sans:"Segoe UI",SegoeUI,Arial,Helvetica,sans-serif;
}
html{scroll-behavior:smooth;background:#f7f6ff}
body{
  min-height:100vh;
  position:relative;
  isolation:isolate;
  overflow-x:hidden;
  background:
    linear-gradient(135deg,rgba(255,255,255,.80),rgba(246,245,255,.90)),
    repeating-linear-gradient(90deg,transparent 0 47px,rgba(153,153,255,.025) 48px),
    repeating-linear-gradient(0deg,transparent 0 47px,rgba(153,153,255,.025) 48px);
  color:var(--ink);
  font-family:var(--sans);
  font-size:15px;
  line-height:1.5;
}
.ambient-bg{position:fixed;inset:0;z-index:-1;overflow:hidden;pointer-events:none}
.ambient-orb{position:absolute;border-radius:999px;filter:blur(4px);opacity:.48;will-change:transform}
.ambient-orb.one{width:34vw;height:34vw;min-width:360px;min-height:360px;left:-11vw;top:-14vw;background:radial-gradient(circle at 35% 35%,rgba(183,177,255,.55),rgba(183,177,255,0) 70%);animation:uniproDriftOne 22s ease-in-out infinite alternate}
.ambient-orb.two{width:40vw;height:40vw;min-width:420px;min-height:420px;right:-15vw;top:20vh;background:radial-gradient(circle at 45% 45%,rgba(119,112,229,.38),rgba(119,112,229,0) 70%);animation:uniproDriftTwo 27s ease-in-out infinite alternate}
.ambient-orb.three{width:30vw;height:30vw;min-width:330px;min-height:330px;left:31vw;bottom:-18vw;background:radial-gradient(circle at 50% 50%,rgba(153,153,255,.32),rgba(153,153,255,0) 72%);animation:uniproDriftThree 25s ease-in-out infinite alternate}
@keyframes uniproDriftOne{from{transform:translate3d(0,0,0) scale(1)}to{transform:translate3d(8vw,10vh,0) scale(1.12)}}
@keyframes uniproDriftTwo{from{transform:translate3d(0,0,0) rotate(0deg)}to{transform:translate3d(-10vw,-8vh,0) rotate(12deg)}}
@keyframes uniproDriftThree{from{transform:translate3d(0,0,0) scale(.94)}to{transform:translate3d(-6vw,-9vh,0) scale(1.08)}}
@media(prefers-reduced-motion:reduce){.ambient-orb{animation:none!important}.card,.primary,button{transition:none!important}}

