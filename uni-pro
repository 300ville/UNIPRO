function terminologyEntries(){
  const entries = Object.entries(TERM_DEFINITIONS).map(([key,value]) => ({key,...value}));
  if(state && state.methodRun === "SRM") return entries.filter(term => !["SPM","MSPM"].includes(term.category) && !/production method/i.test(term.title));
  if(state && state.methodRun === "SPM"){
    return entries.filter(term => term.category !== "MSPM" && !/MSPM/i.test(term.title));
  }
  if(state && state.methodRun === "MSPM"){
    return entries.filter(term => term.category !== "SPM" && !/\bSPM\b/i.test(term.title));
  }
  return entries;
}

function renderTerminologyList(filter=""){
  const list = $("terminologyList");
