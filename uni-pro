  if(["excludedSales","excludedOtherIncome","excludedInterest","excludedIncomeTax"].includes(row.inputId)) return false;
  return true;
}

function fsaTaxAmountResult(row){
  if(!row) return {ok:false,blank:true,value:0,source:"missing"};
  const imported = parseAmountResult(row.sourceTaxAmount);
  if(imported.ok) return {...imported,source:"imported"};
  if(!imported.blank) return {...imported,source:"invalidImported"};
  if(row.fsaBookEqualsTax === "yes"){
    const book = parseAmountResult(row.amount);
    return book.ok ? {...book,source:"bookEqualsTax"} : {...book,source:"bookEqualsTax"};
  }
  if(row.fsaBookEqualsTax === "no"){
    const entered = parseAmountResult(row.fsaTaxAmount);
    return {...entered,source:"entered"};
  }
  return {ok:false,blank:true,value:0,source:"unanswered"};
}

function fsaTaxSourceLabel(row){
  const result = fsaTaxAmountResult(row);
  if(result.source === "imported") return "Imported with the Book source";
  if(result.source === "bookEqualsTax") return "Confirmed equal to Book";
  if(result.source === "entered") return "Entered after No";
  if(result.source === "invalidImported") return "Invalid imported Federal tax amount";
  return "Answer required";
}

function clearFsaBookTaxDecision(row,clearTax=true){
