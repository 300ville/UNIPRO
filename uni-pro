function workflowModel(c,validationItems=[]){
  const s = completionState(c,validationItems);
  const exceptionComplete = s.step5Complete && (s.redItems.length === 0 || s.overrideValid);
  const statuses = {
    1:{complete:s.step1Complete,accessible:true},
    2:{complete:s.step2Complete,accessible:s.step1Complete},
    3:{complete:s.step3Complete,accessible:s.step2Complete},
    4:{complete:s.step4Complete,accessible:s.step3Complete},
    5:{complete:s.step5Complete,accessible:s.step4Complete},
    6:{complete:s.workpaperReady,accessible:s.calculationReady},
    7:{complete:exceptionComplete,accessible:s.step5Complete},
    8:{complete:s.workpaperReady,accessible:s.workpaperReady},
    9:{complete:partnerReviewIsCurrent(),accessible:s.workpaperReady}
  };
  let action = {step:1,title:"Complete taxpayer information",detail:"Enter the taxpayer, tax year, inventory valuation method, Federal tax or Book amount basis, and producer de minimis conclusion."};
  if(s.step1Complete && !s.step2Complete) action = {step:2,title:"Confirm the imported report",detail:"Confirm that the imported accounts and report total agree to the source."};
  else if(s.step2Complete && !s.step3MappingComplete) action = {step:3,title:"Classify the accounts",detail:`${unresolvedAccountRows().length} account(s) still require classification, confirmation, or a split.`};
  else if(s.step3MappingComplete && s.bookTaxIssues.length) action = {step:3,title:"Complete the book-to-tax reconciliation",detail:s.bookTaxIssues[0]};
  else if(s.step2Complete && !s.step3Complete) action = {step:3,title:"Finish the account review",detail:"Complete the remaining account choices, any $0 confirmations, and the duplicate-cost check."};
  else if(s.step3Complete && !s.step4Complete) action = {step:4,title:"Confirm inventory amounts",detail:`${s.inventoryIssues.length} inventory item(s) remain.`};
  else if(s.step4Complete && !s.step5Complete) action = {step:5,title:"Review mixed service costs",detail:`${s.step5Issues.length} method, source, or account item${s.step5Issues.length === 1 ? " remains" : "s remain"}.`};
  else if(s.step5Complete && !exceptionComplete) action = {step:7,title:"Resolve workpaper exceptions",detail:`${s.redItems.length} item(s) require correction or reviewer support.`};
  else if(s.calculationReady && !s.methodSelectionComplete) action = {step:6,title:"Choose the production method",detail:"Review both calculated results, then select the method that applies to this tax year."};
  else if(s.calculationReady && !s.priorMethodProfileRecorded) action = {step:6,title:"Record the prior production method",detail:"Record the last-year method for each changed component before confirming the proposed current-year profile."};
  else if(s.calculationReady && !s.methodTransitionComplete) action = {step:6,title:"Confirm method-change support",detail:"Confirm the separate prior/proposed method, beginning-inventory, and Section 481(a) support that applies to this path."};
  else if(s.workpaperReady && !staffReviewIsCurrent()) action = {step:9,title:"Record Preparer / Senior review",detail:"Review the calculated result and formula trace, enter the reviewer name, then record the first signoff."};
  else if(s.workpaperReady && !managerReviewIsCurrent()) action = {step:9,title:"Record Manager review",detail:"Review the exception summary and source reconciliation, then record the Manager signoff."};
  else if(s.workpaperReady && !seniorManagerReviewIsCurrent()) action = {step:9,title:"Record Senior Manager review",detail:"Review overrides, high-dollar items, formulas, and source tie-outs, then record the Senior Manager signoff."};
  else if(s.workpaperReady && !partnerReviewIsCurrent()) action = {step:9,title:"Record Partner review",detail:"Review the one-page method and result summary, then record the final Partner signoff."};
  else if(partnerReviewIsCurrent()) action = {step:9,title:"Workpaper signed",detail:"All four reviews match the current calculation. Export the final Excel workpaper."};
  return {completion:s,statuses,action};
}

function workflowAutoAdvanceTarget(stage,model){
  const current = model && model.statuses ? model.statuses[Number(stage)] : null;
  if(!current || current.complete !== true) return null;
  const s = model.completion || {};
  let target = null;
  const fromStage = Number(stage);
  if(fromStage < 2 && !s.step2Complete) target = 2;
  else if(fromStage < 3 && !s.step3Complete) target = 3;
  else if(fromStage < 4 && !s.step4Complete) target = 4;
  else if(fromStage < 5 && s.hasMixedRows && !s.step5Complete) target = 5;
  else if([1,2,3,4,5,7].includes(fromStage)) target = s.calculationReady ? 6 : 7;
  return target && model.statuses[target] && model.statuses[target].accessible ? target : null;
}

function workflowCompletionTransition(previous,stage,model){
  const current = model && model.statuses ? model.statuses[Number(stage)] : null;
  if(!previous || Number(previous.stage) !== Number(stage) || previous.complete !== false || !current || current.complete !== true) return null;
  return workflowAutoAdvanceTarget(stage,model);
}

function workflowCalculationReadyTransition(previous,stage,model){
  const completion = model && model.completion ? model.completion : {};
  if(!previous || Number(previous.stage) !== Number(stage) || previous.calculationReady !== false || completion.calculationReady !== true) return null;
  if(![3,4,5,7].includes(Number(stage))) return null;
  return model.statuses && model.statuses[6] && model.statuses[6].accessible ? 6 : null;
}

function workflowAutoAdvanceSnapshot(stage,model){
  const status = model && model.statuses ? model.statuses[Number(stage)] : null;
  const completion = model && model.completion ? model.completion : {};
  return {
    stage:Number(stage),
    complete:!!(status && status.complete),
    mappingComplete:Number(stage) === 3 ? !!completion.step3MappingComplete : false,
    calculationReady:!!completion.calculationReady
  };
}

function workflowRequiredInputsTransition(previous,stage,model){
  const completion = model && model.completion ? model.completion : {};
  if(Number(stage) !== 3 || !previous || Number(previous.stage) !== 3 || previous.mappingComplete !== false) return false;
  if(!completion.step3MappingComplete || completion.step3Complete || completion.sourceRejectedCount) return false;
  return !!((completion.requiredMissing || []).length || (completion.overlapMissing || []).length);
}

function cancelWorkflowAutoAdvance(){
  if(workflowAutoAdvanceTimer){
    clearTimeout(workflowAutoAdvanceTimer);
    workflowAutoAdvanceTimer = null;
  }
  workflowAutoAdvancePending = null;
}

function resetWorkflowAutoAdvanceTracking(){
  cancelWorkflowAutoAdvance();
  workflowAutoAdvancePrevious = null;
  workflowNavigationRevision += 1;
}

function workflowAutoAdvanceShouldHold(element,stage){
  if(!element || typeof element.closest !== "function") return false;
  const containingStage = element.closest(".workflow-stage");
  if(!containingStage || Number(containingStage.dataset.step) !== Number(stage)) return false;
  if(element.isContentEditable || element.tagName === "TEXTAREA") return true;
  if(element.tagName !== "INPUT") return false;
  return !["button","checkbox","radio","submit","reset"].includes(String(element.type || "text").toLowerCase());
}

function workflowDiscreteChangeMatchesPending(control,pending=workflowAutoAdvancePending,sourceStage=null){
  if(!control || !pending || !pending.holdElement || typeof control.closest !== "function") return false;
  const tagName = String(control.tagName || "").toUpperCase();
  const inputType = String(control.type || "").toLowerCase();
  const discrete = tagName === "BUTTON" || tagName === "SELECT" || (tagName === "INPUT" && ["button","radio","checkbox","submit"].includes(inputType));
  if(!discrete) return false;
  const containingStage = sourceStage || control.closest(".workflow-stage");
  return !!containingStage && Number(containingStage.dataset.step) === Number(pending.fromStage);
}

function releaseWorkflowAutoAdvanceForDiscreteChange(event){
  const target = event && event.target;
  const eventPath = event && typeof event.composedPath === "function" ? event.composedPath() : [];
  const pathControl = eventPath.find(item => item && ["BUTTON","SELECT","INPUT"].includes(String(item.tagName || "").toUpperCase()));
  const control = pathControl || (target && typeof target.closest === "function" ? (target.closest("button,select,input") || target) : target);
  const sourceStage = eventPath.find(item => item && item.classList && item.classList.contains("workflow-stage")) || null;
  if(!workflowDiscreteChangeMatchesPending(control,workflowAutoAdvancePending,sourceStage)) return;
  workflowAutoAdvancePending.holdElement = null;
  setTimeout(flushWorkflowAutoAdvance,0);
}

function focusAndAnnounceWorkflowStage(stage){
  const activeStage = document.querySelector(`.workflow-stage[data-step="${stage}"]`);
  const heading = activeStage && activeStage.querySelector("h2");
  if(heading){
    const hadTabIndex = heading.hasAttribute("tabindex");
    if(!hadTabIndex) heading.setAttribute("tabindex","-1");
    heading.focus({preventScroll:true});
    if(!hadTabIndex) heading.addEventListener("blur",() => heading.removeAttribute("tabindex"),{once:true});
  }
  if(activeStage) activeStage.scrollIntoView({behavior:"smooth",block:"start"});
  if($("workflowAutoAdvanceStatus")) $("workflowAutoAdvanceStatus").textContent = `Step ${stage} opened automatically.`;
}

function openStageAutomatically(step){
  openStage(step,true);
  focusAndAnnounceWorkflowStage(Number(state.currentStage));
}

function queueWorkflowAutoAdvance(fromStage,targetStage){
  cancelWorkflowAutoAdvance();
  const active = document.activeElement;
  workflowAutoAdvancePending = {
    fromStage:Number(fromStage),
    targetStage:Number(targetStage),
    revision:workflowNavigationRevision,
    holdElement:workflowAutoAdvanceShouldHold(active,fromStage) ? active : null
  };
  const inspectorOpen = $("accountInspectorOverlay") && !$("accountInspectorOverlay").classList.contains("hidden");
  if(workflowAutoAdvancePending.holdElement || inspectorOpen) return;
  workflowAutoAdvanceTimer = setTimeout(flushWorkflowAutoAdvance,0);
}

function queueWorkflowRequiredInputs(fromStage){
  cancelWorkflowAutoAdvance();
  const active = document.activeElement;
  workflowAutoAdvancePending = {
    fromStage:Number(fromStage),
    targetStage:null,
    action:"requiredInputs",
    revision:workflowNavigationRevision,
    holdElement:workflowAutoAdvanceShouldHold(active,fromStage) ? active : null
  };
  const inspectorOpen = $("accountInspectorOverlay") && !$("accountInspectorOverlay").classList.contains("hidden");
  if(workflowAutoAdvancePending.holdElement || inspectorOpen) return;
  workflowAutoAdvanceTimer = setTimeout(flushWorkflowAutoAdvance,0);
}

function flushWorkflowAutoAdvance(){
  if(workflowAutoAdvanceTimer){
    clearTimeout(workflowAutoAdvanceTimer);
    workflowAutoAdvanceTimer = null;
  }
  const pending = workflowAutoAdvancePending;
  if(!pending) return;
  const inspectorOpen = $("accountInspectorOverlay") && !$("accountInspectorOverlay").classList.contains("hidden");
  if(inspectorOpen) return;
  if(pending.holdElement && document.activeElement === pending.holdElement) return;
  if(pending.revision !== workflowNavigationRevision || Number(state.currentStage) !== pending.fromStage){
    workflowAutoAdvancePending = null;
    return;
  }
  const c = calc();
  const validationItems = buildValidationItems(c);
  const model = workflowModel(c,validationItems);
  if(pending.action === "requiredInputs"){
    const completion = model.completion || {};
    const stillRequired = Number(pending.fromStage) === 3
      && completion.step3MappingComplete
      && !completion.step3Complete
      && ((completion.requiredMissing || []).length || (completion.overlapMissing || []).length);
    workflowAutoAdvancePending = null;
    workflowAutoAdvancePrevious = workflowAutoAdvanceSnapshot(state.currentStage,model);
    if(stillRequired) openRequiredInputModal();
    return;
  }
  const currentTarget = workflowAutoAdvanceTarget(pending.fromStage,model);
  if(currentTarget !== pending.targetStage){
    workflowAutoAdvancePending = null;
    workflowAutoAdvancePrevious = workflowAutoAdvanceSnapshot(state.currentStage,model);
    return;
  }
  workflowAutoAdvancePending = null;
  openStageAutomatically(currentTarget);
}

function observeWorkflowAutoAdvance(c,validationItems=[]){
  const stage = Number(state.currentStage || 1);
  const model = workflowModel(c,validationItems);
  const target = workflowCompletionTransition(workflowAutoAdvancePrevious,stage,model)
    || workflowCalculationReadyTransition(workflowAutoAdvancePrevious,stage,model);
  const requiredInputs = workflowRequiredInputsTransition(workflowAutoAdvancePrevious,stage,model);
  workflowAutoAdvancePrevious = workflowAutoAdvanceSnapshot(stage,model);
  if(target) queueWorkflowAutoAdvance(stage,target);
  else if(requiredInputs) queueWorkflowRequiredInputs(stage);
}

function openStage(step,quiet=false){
  cancelWorkflowAutoAdvance();
  workflowNavigationRevision += 1;
  const target = Math.max(1,Math.min(9,Number(step || 1)));
  const c = calc();
  const model = workflowModel(c,buildValidationItems(c));
  if(!model.statuses[target].accessible){
    state.currentStage = model.action.step;
    if(!quiet) alert(`That stage is locked. ${model.action.title} first.`);
  } else {
    state.currentStage = target;
  }
  renderWorkflow(c,buildValidationItems(c));
  workflowAutoAdvancePrevious = workflowAutoAdvanceSnapshot(state.currentStage,model);
  const active = document.querySelector(`.workflow-stage[data-step="${state.currentStage}"]`);
  if(active && !quiet) active.scrollIntoView({behavior:"smooth",block:"start"});
}

function renderWorkflow(c,validationItems=[]){
  const model = workflowModel(c,validationItems);
  if(!model.statuses[state.currentStage] || !model.statuses[state.currentStage].accessible) state.currentStage = model.action.step;
  document.querySelectorAll(".workflow-stage").forEach(stage => stage.classList.toggle("stage-active",Number(stage.dataset.step) === state.currentStage));
  document.querySelectorAll("[data-workflow-step]").forEach(button => {
    const step = Number(button.dataset.workflowStep);
    const status = model.statuses[step];
    button.classList.toggle("current",step === state.currentStage);
    button.classList.toggle("completed",status.complete);
    button.classList.toggle("locked",!status.accessible);
    button.disabled = !status.accessible;
    if(step === state.currentStage) button.setAttribute("aria-current","step");
    else button.removeAttribute("aria-current");
    const small = $("railStep" + step);
    if(small) small.textContent = status.complete ? "Complete" : step === state.currentStage ? "Current" : status.accessible ? "Ready" : "Locked";
  });
  const completeCount = Object.values(model.statuses).filter(status => status.complete).length;
  if($("railProgress")) $("railProgress").textContent = `${completeCount} of 9 complete`;
  if($("railProgressBar")) $("railProgressBar").style.width = `${completeCount / 9 * 100}%`;
  if($("railProgressRing")){
    $("railProgressRing").style.setProperty("--progress",`${completeCount / 9 * 360}deg`);
    $("railProgressRing").setAttribute("aria-valuenow",String(completeCount));
  }
  if($("railProgressCount")) $("railProgressCount").textContent = `${Math.round(completeCount / 9 * 100)}%`;
  if($("railTaxpayer")) $("railTaxpayer").textContent = String(state.clientName || "").trim() || "Untitled taxpayer";
  if($("railTaxYear")) $("railTaxYear").textContent = validTaxYearEnding(state.taxYear) ? `Tax year ending ${state.taxYear}` : "Tax year not set";
  if($("currentActionTitle")) $("currentActionTitle").textContent = model.action.title;
  if($("currentActionDetail")) $("currentActionDetail").textContent = model.action.detail;
  const unresolved = unresolvedAccountRows();
  const commandCenter = $("workpaperCommandCenter");
  const showCommandCenter = !!state.rows.length && Number(state.currentStage) >= 3;
  if(commandCenter) commandCenter.classList.toggle("hidden",!showCommandCenter);
  if(document.documentElement) document.documentElement.style.setProperty("--card-head-top",showCommandCenter ? "126px" : "73px");
  if($("metricImported")) $("metricImported").textContent = state.rows.length;
  if($("metricReviewed")) $("metricReviewed").textContent = state.rows.filter(row => !rowIsUnresolved(row)).length;
  if($("metricUnresolvedNet")) $("metricUnresolvedNet").textContent = unresolved.length ? moneyWp(unresolved.reduce((sum,row) => sum + mapped(row),0)) : "None";
  if($("metricUnresolvedDollars")) $("metricUnresolvedDollars").textContent = unresolved.length ? moneyWp(unresolved.reduce((sum,row) => sum + Math.abs(mapped(row)),0)) : "None";
  if($("nextUnresolvedButton")) $("nextUnresolvedButton").textContent = partnerReviewIsCurrent() ? "Export final" : "Next item";
  renderReviewSurfaces(c,validationItems);
}

