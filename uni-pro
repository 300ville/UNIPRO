function openAccountInspector(rowId){
  if(!findRowById(rowId)) return;
  if($("accountInspectorOverlay").classList.contains("hidden")) inspectorPriorFocus = document.activeElement;
  activeInspectorRowId = rowId;
  $("accountInspectorOverlay").classList.remove("hidden");
  document.addEventListener("keydown",handleInspectorKeydown);
  renderAccountInspector();
  setTimeout(() => $("accountInspector").focus && $("accountInspector").focus(),0);
}

function closeAccountInspector(event){
  if(event && event.target !== $("accountInspectorOverlay")) return;
  const closingRowId = activeInspectorRowId;
  activeInspectorRowId = null;
  $("accountInspectorOverlay").classList.add("hidden");
  document.removeEventListener("keydown",handleInspectorKeydown);
  const stableTrigger = Array.from(document.querySelectorAll("[data-inspect-row-id]")).find(button => button.dataset.inspectRowId === closingRowId);
  if(stableTrigger && typeof stableTrigger.focus === "function") stableTrigger.focus();
  else if(inspectorPriorFocus && document.contains(inspectorPriorFocus) && typeof inspectorPriorFocus.focus === "function") inspectorPriorFocus.focus();
  else if($("mappingSearch") && typeof $("mappingSearch").focus === "function") $("mappingSearch").focus();
  inspectorPriorFocus = null;
  setTimeout(flushWorkflowAutoAdvance,0);
}

function handleInspectorKeydown(event){
  if($("accountInspectorOverlay").classList.contains("hidden")) return;
  if(event.key === "Escape"){
    event.preventDefault();
    closeAccountInspector();
    return;
  }
  if(event.key !== "Tab") return;
  const focusables = Array.from($("accountInspector").querySelectorAll('button,[href],input,select,textarea,[tabindex]:not([tabindex="-1"])')).filter(el => !el.disabled && el.offsetParent !== null);
  if(!focusables.length){ event.preventDefault(); $("accountInspector").focus(); return; }
  const first = focusables[0];
  const last = focusables[focusables.length - 1];
  if(event.shiftKey && document.activeElement === first){ event.preventDefault(); last.focus(); }
  else if(!event.shiftKey && document.activeElement === last){ event.preventDefault(); first.focus(); }
}

