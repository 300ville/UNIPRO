  const controlsText = controls.length ? `${controls.length-controlFailures.length} of ${controls.length} tied` : analysis.structured && !analysis.needsAmountSelection ? "No controls found" : "Pending selection";
  const sourceBasisText = analysis.reportSourceBasis ? `${analysis.reportSourceBasis === "book" ? "Book" : "Tax-adjusted"} source detected` : "Not stated";
  const blockingNotices = [
