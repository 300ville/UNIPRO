  if(!financialStatementAlternativeActive()) return [];
  const issues = [];
  if(state.financialStatementQualified !== "yes") return [state.financialStatementQualified === "no" ? "The statement does not qualify. Select Federal tax." : "Confirm that the taxpayer has a qualifying financial statement."];
  if(state.financialStatementMethodAdopted !== "yes") return [state.financialStatementMethodAdopted === "no" ? "The financial statement alternative is not the taxpayer's method for this tax year. Select Federal tax or complete the method-change analysis." : "Confirm that the financial statement alternative is the taxpayer's method for this tax year."];
  if(state.financialStatementValuationExcluded !== "yes") return [state.financialStatementValuationExcluded === "no" ? "Remove the write-downs, reserves, and valuation adjustments before continuing." : "Confirm that write-downs, reserves, and valuation adjustments were removed."];
  if(state.activityType !== "reseller" && !["yes","no"].includes(state.financialStatementGrossReceiptsEligible)) return ["Complete the three-year gross receipts test."];
  {
    const missingAnswers = state.rows.filter(row => fsaRowApplies(row) && fsaTaxAmountResult(row).source === "unanswered");
    if(missingAnswers.length) issues.push(`${missingAnswers.length} confirmed current-year cost row(s) need a Book-equals-Federal-tax answer.`);
    const missingTax = fsaRowsNeedingTaxAmount().filter(row => fsaTaxAmountResult(row).source !== "unanswered");
    if(missingTax.length) issues.push(`${missingTax.length} confirmed current-year cost row(s) need a valid Federal tax amount or support reference.`);
    const characterizationMissing = fsaRowsNeedingAdditionalCostCharacterization();
    if(characterizationMissing.length) issues.push(`${characterizationMissing.length} additional-cost row(s) need an ordinary-cost or supported Section 471-type special-rule characterization.`);
    const negativeUnconfirmed = fsaRowsNeedingNegativeConfirmation();
    if(negativeUnconfirmed.length) issues.push(`${negativeUnconfirmed.length} negative tax-less-book difference(s) need the required negative-adjustment confirmation.`);
  }
  const control = parseAmountResult(state.bookTaxControlTotal);
  if(!control.ok) issues.push(control.blank ? "Enter the signed book-to-tax adjustment control total, including zero." : "Enter a valid signed book-to-tax adjustment control total.");
  if(!String(state.bookTaxReference || "").trim()) issues.push("Enter the supporting schedule or workpaper reference.");
  const legacyBucketRows = state.rows.filter(row => row.confirmed === true && LEGACY_FSA_INPUT_IDS.has(row.inputId));
  if(legacyBucketRows.length) issues.push(`${legacyBucketRows.length} row(s) use retired financial-statement-method adjustment buckets. Reclassify each source row once; UNIPRO now creates the linked tax-less-book layer automatically.`);
  if(control.ok){
    const difference = control.value - bookTaxMappedAdjustmentTotal();
    if(Math.abs(difference) >= SOURCE_CONTROL_EPSILON) issues.push(`The mapped book-to-tax adjustments differ from the control total by ${moneyWp(difference)}.`);
  }
  return issues;
}

