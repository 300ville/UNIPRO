      <div class="import-preview-stat"><span>Balance</span><strong>${analysis.needsAmountSelection ? "Pending" : esc(moneyWp(analysis.net))}</strong></div>
      <div class="import-preview-stat"><span>Total dollars</span><strong>${analysis.needsAmountSelection ? "Pending" : esc(moneyWp(analysis.absolute))}</strong></div>
      <div class="import-preview-stat"><span>Amount column used</span><strong>${esc(analysis.amountColumnLabel || "Not detected")}</strong></div>
      ${bookFederalTaxSupportActive() ? `<div class="import-preview-stat"><span>Federal tax column</span><strong>${esc(analysis.taxAmountColumnLabel || "Enter in Review")}</strong></div>` : ""}
      <div class="import-preview-stat"><span>Source format</span><strong>${esc(analysis.sourceFormat || (analysis.hasHeader ? "Mapped columns" : "Positional"))}</strong></div>
      <div class="import-preview-stat"><span>Source basis</span><strong>${esc(sourceBasisText)}</strong></div>
