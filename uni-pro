function renderCalcOnly(){
  const lifoBoxBefore=$("lifoIntegrationBox");
  const activeBefore=document.activeElement;
  const focusableSelector="input:not([disabled]),select:not([disabled]),textarea:not([disabled]),button:not([disabled])";
  let lifoFocusIndex=-1;
  let lifoSelectionStart=null;
  let lifoSelectionEnd=null;
  if(lifoBoxBefore && activeBefore && lifoBoxBefore.contains(activeBefore)){
    const controls=Array.from(lifoBoxBefore.querySelectorAll(focusableSelector));
    lifoFocusIndex=controls.indexOf(activeBefore);
    if(typeof activeBefore.selectionStart === "number"){
      lifoSelectionStart=activeBefore.selectionStart;
      lifoSelectionEnd=activeBefore.selectionEnd;
    }
  }
  reconcileRequiredZeroRows();
  const c = calc();
  renderLiveResults(c);
  invalidateStaleApprovals();
  syncScopeUi(c);
  renderMethodScopeNotice();
  renderBookTaxReconciliation();
  renderMspmRemediationBanner();
  renderInventoryInputs(c);
  renderMixedBaseMappings();
  renderMappingChecks();
  renderProgress(c);
  renderReadiness(c);
  renderMappingWarning(c);
  renderSourceImportExceptions();
  renderMixedServiceBox(c);
  renderResults(c);
  renderAppliedMethodSelection(c);
  const validationItems = renderValidation(c);
  renderDecisionSummary(c);
  renderDetail(c);
  renderReviewSignoff(c);
  renderCompletionStatuses(c,validationItems);
  renderWorkflow(c,validationItems);
  if(lifoFocusIndex >= 0){
    const lifoBoxAfter=$("lifoIntegrationBox");
    const controls=Array.from(lifoBoxAfter ? lifoBoxAfter.querySelectorAll(focusableSelector) : []);
    const replacement=controls[Math.min(lifoFocusIndex,Math.max(0,controls.length-1))];
    if(replacement){
      replacement.focus({preventScroll:true});
      if(lifoSelectionStart !== null && typeof replacement.setSelectionRange === "function"){
        const max=String(replacement.value || "").length;
        replacement.setSelectionRange(Math.min(lifoSelectionStart,max),Math.min(lifoSelectionEnd ?? lifoSelectionStart,max));
      }
    }
  }
  observeWorkflowAutoAdvance(c,validationItems);
}

