function baseMappingStats(){
  const rows = allocationBaseRows();
  const laborReview = rows.filter(row => !LABOR_BASE_BY_ID[row.laborTreatment] || ["review","detail"].includes(row.laborTreatment)).length;
  const laborUnconfirmed = rows.filter(row => !["review","detail"].includes(row.laborTreatment) && row.laborConfirmed !== true).length;
  const costReview = rows.filter(row => !COST_BASE_BY_ID[row.costTreatment] || ["review","detail"].includes(row.costTreatment)).length;
  const costUnconfirmed = rows.filter(row => !["review","detail"].includes(row.costTreatment) && row.costConfirmed !== true).length;
  return {
    rows:rows.length,
    laborReview,
    laborUnconfirmed,
    costReview,
    costUnconfirmed,
    laborComplete:rows.length > 0 && laborReview === 0 && laborUnconfirmed === 0,
    costComplete:rows.length > 0 && costReview === 0 && costUnconfirmed === 0
  };
