function parseNumResult(v){
  if(typeof v === "number"){
    return Number.isFinite(v)
      ? {value:v,ok:true,cleaned:String(v),blank:false,original:String(v)}
      : {value:0,ok:false,cleaned:String(v),blank:false,original:String(v)};
  }

  const original = v === null || v === undefined ? "" : String(v);
  let s = original.trim();
  if(!s) return {value:0,ok:false,cleaned:"",blank:true,original};

  let negative = false;
  if(/^\(.*\)$/.test(s)){
    negative = true;
    s = s.slice(1,-1).trim();
  } else if(s.endsWith("-")){
    negative = true;
    s = s.slice(0,-1).trim();
  } else if(s.startsWith("-")){
    negative = true;
    s = s.slice(1).trim();
  }

  if(s.startsWith("$")) s = s.slice(1).trim();
  const validNumber = /^(?:\d+|\d{1,3}(?:,\d{3})+)(?:\.\d+)?$/;
  if(!validNumber.test(s)) return {value:0,ok:false,cleaned:s,blank:false,original};

  const n = Number(s.replace(/,/g,""));
  if(!Number.isFinite(n)) return {value:0,ok:false,cleaned:s,blank:false,original};
  return {value:negative ? -n : n,ok:true,cleaned:s,blank:false,original};
}

const parseNum = v => parseNumResult(v).value;

function parseAmountResult(v){
  const parsed = parseNumResult(v);
