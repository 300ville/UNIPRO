function completionState(c,validationItems=null){
  const stats = rowStats();
  const requiredMissing = missingRequiredCategories();
  const overlapMissing = overlapRowsNeedingConfirmation();
  const bookTaxIssues = bookTaxReconciliationIssues();
  const basisMismatchRows = basisSourceMismatchRows();
  const unavailableRows = unavailableInputRows();
  const sourceRejectedCount = state.lastImport && Array.isArray(state.lastImport.rejected) ? state.lastImport.rejected.length : 0;
  const step1Complete = step1MissingFields().length === 0;
  const step2Complete = state.rows.length > 0
    && stats.parseIssues === 0
    && basisMismatchRows.length === 0;
  const step3MappingComplete = step2Complete
    && stats.reviewCount === 0
    && stats.unconfirmedCount === 0
    && stats.suspenseCount === 0
    && (!needsMspmDetail() || stats.mspmReviewCount === 0)
    && (!needsMspmDetail() || stats.mspmBreakoutCount === 0)
    && unavailableRows.length === 0;
  const step3Complete = step3MappingComplete
    && requiredMissing.length === 0
    && overlapMissing.length === 0
    && bookTaxIssues.length === 0
    && sourceRejectedCount === 0;
  const inventoryIssues = step3Complete ? inventoryCompletionIssues(c) : [];
  const step4Complete = step3Complete && inventoryIssues.length === 0;
  const hasMixedRows = hasMixedServiceCosts();
  const step5Calculated = step4Complete && (state.activityType === "reseller" ? !hasMixedRows : (!hasMixedRows || mixedServiceCalculated(c)));
  const step5Issues = !step4Complete || c.indirectCostRuleApplies
    ? []
    : state.activityType === "reseller"
      ? hasMixedRows
        ? mixedServiceInputIssues(c)
        : srmSharedDepartmentConfirmationIsCurrent()
          ? []
          : ["Confirm whether the reseller's labor-based mixed service allocation is included in the purchasing and storage account rows, or whether the taxpayer has no mixed service departments."]
      : hasMixedRows
        ? mixedServiceInputIssues(c)
        : mixedNoDepartmentsConfirmationIsCurrent()
          ? []
          : ["Confirm that the taxpayer has no mixed service departments."];
  const step5Complete = step4Complete && step5Issues.length === 0;
  const items = Array.isArray(validationItems) ? validationItems : buildValidationItems(c);
  const redItems = redValidationItems(items);
  const overrideValid = isRedFlagOverrideValid(redItems);
  const coreInputsReady = step1Complete
    && step2Complete
    && step3Complete
    && step4Complete;
  const inputsReady = coreInputsReady && step5Complete;
  const calculationReady = inputsReady && (redItems.length === 0 || overrideValid);
  const methodSelectionComplete = selectedMethodIsValid();
  const priorMethodProfileRecorded = priorMethodProfileComplete();
  const methodTransitionComplete = methodTransitionSupportIsCurrent() && priorMethodProfileRecorded;
  const workpaperReady = calculationReady && methodSelectionComplete && methodTransitionComplete;
  return {stats,requiredMissing,overlapMissing,bookTaxIssues,basisMismatchRows,unavailableRows,sourceRejectedCount,inventoryIssues,step1Complete,step2Complete,step3MappingComplete,step3Complete,step4Complete,hasMixedRows,step5Calculated,step5Issues,step5Complete,coreInputsReady,inputsReady,redItems,overrideValid,calculationReady,methodSelectionComplete,priorMethodProfileRecorded,methodTransitionComplete,workpaperReady};
}

