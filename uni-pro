    : findScopedHeader(structuredHeaderNames,["federal tax total","tax total","federal tax amount","tax amount","tax-adjusted amount","tax adjusted amount"],["book"])) : -1;
  const neutralStructuredAmountIndex = structuredHeader ? findExactHeader(structuredHeaderNames,["source amount","client amount","amount","value"]) : -1;
