function inputDefinition(inputId){
  const option = inputById[inputId] || inputById.review;
  if(INPUT_DEFINITIONS[inputId]) return INPUT_DEFINITIONS[inputId];
  if(option.group === "Breakout / Suspense") return TERM_DEFINITIONS.breakoutSuspense.definition;
  return `Use this selection only when the account meets the ${option.label} definition for the workpaper.`;
}

let activeDefinitionAnchor = null;

function positionDefinitionTooltip(anchor){
  const tooltip = $("selectionDefinitionTooltip");
  if(!tooltip || !anchor || !anchor.isConnected || !anchor.getClientRects().length){
    hideDefinitionTooltip();
    return;
  }
  const margin = 12;
  const gap = 10;
  const anchorRect = anchor.getBoundingClientRect();
  const tooltipRect = tooltip.getBoundingClientRect();
  const visualViewport = window.visualViewport;
  const viewportLeft = visualViewport ? visualViewport.offsetLeft : 0;
  const viewportTop = visualViewport ? visualViewport.offsetTop : 0;
  const viewportWidth = visualViewport ? visualViewport.width : Math.max(document.documentElement.clientWidth,window.innerWidth || 0);
  const viewportHeight = visualViewport ? visualViewport.height : Math.max(document.documentElement.clientHeight,window.innerHeight || 0);
  const viewportRight = viewportLeft + viewportWidth;
  const viewportBottom = viewportTop + viewportHeight;
  let left = anchorRect.left + (anchorRect.width - tooltipRect.width) / 2;
  left = Math.max(viewportLeft + margin,Math.min(left,viewportRight - tooltipRect.width - margin));
  let top = anchorRect.top - tooltipRect.height - gap;
  if(top < viewportTop + margin) top = anchorRect.bottom + gap;
  if(top + tooltipRect.height > viewportBottom - margin){
    top = Math.max(viewportTop + margin,viewportBottom - tooltipRect.height - margin);
  }
  tooltip.style.left = `${Math.round(left)}px`;
  tooltip.style.top = `${Math.round(top)}px`;
}

function showDefinitionTooltip(anchor){
  const tooltip = $("selectionDefinitionTooltip");
  if(!tooltip || !anchor) return;
  activeDefinitionAnchor = anchor;
  const title = document.createElement("strong");
  title.textContent = anchor.dataset.definitionLabel || "Definition";
  const definition = document.createElement("span");
  definition.textContent = anchor.dataset.definition || "";
  tooltip.replaceChildren(title,definition);
  tooltip.classList.add("visible");
  tooltip.setAttribute("aria-hidden","false");
  positionDefinitionTooltip(anchor);
}

function hideDefinitionTooltip(anchor){
  if(anchor && activeDefinitionAnchor && anchor !== activeDefinitionAnchor) return;
  const tooltip = $("selectionDefinitionTooltip");
  activeDefinitionAnchor = null;
  if(!tooltip) return;
  tooltip.classList.remove("visible");
  tooltip.setAttribute("aria-hidden","true");
}

function definitionLinkHtml(row){
  const definition = inputDefinition(row.inputId);
  const label = bucketDisplayLabel(row.inputId);
  return `<a href="#" class="row-action-link row-definition-link" onclick="event.preventDefault()" onmouseenter="showDefinitionTooltip(this)" onmouseleave="hideDefinitionTooltip(this)" onfocus="showDefinitionTooltip(this)" onblur="hideDefinitionTooltip(this)" data-definition-label="${esc(label)}" data-definition="${esc(definition)}" aria-describedby="selectionDefinitionTooltip">Definition</a>`;
}

function selectInputHtml(row,index){
  let html = `<select class="mapping-select" aria-label="UNICAP bucket for account ${esc(row.account || index+1)}" onchange="editInput(${index},this.value)">`;
  let currentGroup = "";
  const options = inputOptions.filter(opt => inputOptionIsAvailable(opt.id));
  if(!inputOptionIsAvailable(row.inputId) && inputById[row.inputId]){
    html += `<option value="${esc(row.inputId)}" selected>${esc(bucketDisplayLabel(row.inputId))} (unavailable for current basis)</option>`;
  }
  options.forEach(opt => {
    if(opt.group !== currentGroup){
      if(currentGroup) html += `</optgroup>`;
      currentGroup = opt.group;
      html += `<optgroup label="${esc(inputGroupDisplayLabel(opt.group))}">`;
    }
    html += `<option value="${esc(opt.id)}" ${opt.id === row.inputId ? "selected" : ""}>${esc(bucketDisplayLabel(opt.id))}</option>`;
  });
  html += `</optgroup></select>`;
  return html;
}

function suggestedInputHtml(row){
  const suggestedId = inputById[row.suggestedInputId] ? row.suggestedInputId : "review";
  return `<div class="bucket-readonly">${esc(bucketDisplayLabel(suggestedId))}</div><div class="small-note"><strong>${esc(row.confidence || "Low")}</strong> confidence</div>`;
}

function suggestionCanBeAccepted(row){
  return !!row
    && ["High","Medium"].includes(row.confidence)
    && inputById[row.suggestedInputId]
    && inputOptionIsAvailable(row.suggestedInputId)
    && row.suggestedInputId !== "review"
    && row.suggestedInputId !== "excludedSoldOnly"
    && !isSuspenseInputId(row.suggestedInputId);
}

function acceptSuggestedClassification(index){
  const row = state.rows[index];
  if(!suggestionCanBeAccepted(row)) return;
  invalidateCalculationApprovals();
  clearBookTaxMethodConfirmation();
  row.inputId = row.suggestedInputId;
  row.review = false;
  row.confirmed = true;
  row.notIn471Confirmed = false;
  row.fsaAdditionalCostType = "";
  row.fsaSpecialRuleReference = "";
  row.fsaNegativeAdjustmentConfirmed = false;
  clearFsaBookTaxDecision(row,true);
  row.mspmConfirmed = needsMspmDetail() && MSPM_REVIEW_INPUT_IDS.has(row.inputId);
  row.laborConfirmed = false;
  row.costConfirmed = false;
  row.reason = `Accepted ${row.confidence.toLowerCase()}-confidence suggestion.`;
  row.confirmedAt = new Date().toISOString();
  syncBaseSuggestions(row,true);
  renderAll();
}

function confirmVisibleSuggestions(){
  const candidates = visibleRows().filter(suggestionCanBeAccepted);
  if(!candidates.length){
    alert("No High or Medium confidence suggestions are eligible for batch acceptance. Low-confidence and suspense suggestions always require individual review.");
    return;
  }
  const net = candidates.reduce((sum,row) => sum + mapped(row),0);
  const absolute = candidates.reduce((sum,row) => sum + Math.abs(mapped(row)),0);
  if(!confirm(`Accept ${candidates.length} suggestion(s)? Balance: ${moneyWp(net)}. Total dollars: ${moneyWp(absolute)}. Low-confidence and suspense rows are excluded.`)) return;
  invalidateCalculationApprovals();
  clearBookTaxMethodConfirmation();
  const acceptedAt = new Date().toISOString();
  candidates.forEach(row => {
    row.inputId = row.suggestedInputId;
    row.review = false;
    row.confirmed = true;
    row.confirmedAt = acceptedAt;
    row.reason = `Batch accepted ${row.confidence.toLowerCase()}-confidence suggestion.`;
    row.notIn471Confirmed = false;
    row.fsaNegativeAdjustmentConfirmed = false;
    clearFsaBookTaxDecision(row,true);
    row.fsaAdditionalCostType = "";
    row.fsaSpecialRuleReference = "";
    row.mspmConfirmed = needsMspmDetail() && MSPM_REVIEW_INPUT_IDS.has(row.inputId);
    syncBaseSuggestions(row,true);
  });
  renderAll();
}

