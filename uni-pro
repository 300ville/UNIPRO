function selectAppliedMethod(method){
  if(!["SPM","MSPM"].includes(method) || state.activityType === "reseller" || (method === "SPM" && !spmAvailable())) return;
  if(state.selectedMethodConfirmed === true && state.selectedMethod === method) return;
  const mixedPopulationWasCurrent = mixedPopulationConfirmationIsCurrent();
  const noDepartmentsWasCurrent = mixedNoDepartmentsConfirmationIsCurrent();
  const redOverrideWasCurrent = isRedFlagOverrideValid(redValidationItems(buildValidationItems(calc())));
  const redOverrideExplanation = state.redFlagOverrideExplanation;
  invalidateCalculationApprovals();
  state.selectedMethod = method;
  state.selectedMethodConfirmed = true;
  state.methodTransitionSupportConfirmed = false;
  state.methodTransitionSupportFingerprint = "";
  if(mixedPopulationWasCurrent) state.mixedPopulationConfirmationFingerprint = calculationFingerprint();
  if(noDepartmentsWasCurrent) state.mixedNoDepartmentsConfirmationFingerprint = calculationFingerprint();
  if(redOverrideWasCurrent){
    state.redFlagOverrideChecked = true;
    state.redFlagOverrideExplanation = redOverrideExplanation;
    state.redFlagOverrideFingerprint = calculationFingerprint();
  }
  document.querySelectorAll('input[name="selectedMethodChoice"]').forEach(input => { input.checked = input.value === method; });
  renderCalcOnly();
}

