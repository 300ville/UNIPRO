  const supportNote = isDetailedMixedMethod(c.mixedServiceMethod)
    ? `Supporting allocation: ${String(state.mixedDetailedSupport || "Not entered").trim() || "Not entered"}`
    : "All ratios are multiplied at full precision. Rounded percentages are display-only.";
