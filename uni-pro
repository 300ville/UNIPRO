function fsaInventoryBasisIssues(){
  if(!financialStatementAlternativeActive()) return [];
  const issues = [];
  if(state.fsaOpeningBasisConfirmed !== "yes") issues.push({id:"fsaOpeningBasisConfirmed",message:state.fsaOpeningBasisConfirmed === "no" ? "Opening Section 471 and additional Section 263A layers must be reconciled to the opening tax inventory basis used in this calculation." : "Confirm the opening inventory basis tie-out."});
  if(!["yes","no"].includes(state.fsaMethodChange)) issues.push({id:"fsaMethodChange",message:"Answer whether the financial-statement alternative is being adopted or changed this year."});
  if(state.fsaMethodChange === "yes" && !String(state.fsaMethodChangeReference || "").trim()) issues.push({id:"fsaMethodChangeReference",message:"Enter the Section 481(a) / beginning-inventory revaluation workpaper reference."});
  if(state.fsaEndingBasisConfirmed !== "yes") issues.push({id:"fsaEndingBasisConfirmed",message:state.fsaEndingBasisConfirmed === "no" ? "Ending Section 471 layers must reconcile to the ending tax inventory schedule and exclude the separate additional Section 263A layer." : "Confirm the ending inventory basis tie-out."});
  return issues;
}

function normalizeInventoryInputs(){
  if(!state.inventoryInputs || typeof state.inventoryInputs !== "object") state.inventoryInputs = {};
  INVENTORY_CONFIRMATION_DEFS.forEach(def => {
    const current = state.inventoryInputs[def.id];
    if(!current || typeof current !== "object") state.inventoryInputs[def.id] = {mode:"",amount:"",reference:"",autoMode:"",zeroConfirmed:false};
    else {
      current.mode = ["linked","manual","zero","breakout","detailed"].includes(current.mode) ? current.mode : "";
      current.autoMode = ["linked","manual","zero","breakout","detailed"].includes(current.autoMode) ? current.autoMode : "";
      if(current.amount === undefined || current.amount === null) current.amount = "";
      if(current.reference === undefined || current.reference === null) current.reference = "";
      if(typeof current.zeroConfirmed !== "boolean") current.zeroConfirmed = current.mode === "zero" && current.autoMode !== "zero";
    }
  });
}

function inventoryState(id){
  normalizeInventoryInputs();
  return state.inventoryInputs[id];
}

function inventoryMappedRows(id){
  return state.rows.filter(row => row.confirmed === true && row.inputId === id && hasNumericEntry(row.amount));
}

function inventoryMappedTotal(id){
  return inventoryMappedRows(id).reduce((sum,row) => sum + mapped(row),0);
}

function inventoryRequiredIds(){
  if(!comparisonChoiceIsValid()) return [];
  if(state.activityType === "reseller"){
    const required = ["begresale","endresale"];
    if(lifoActive()) required.push("begadd");
    return required;
  }
  const required = needsMspmDetail()
    ? ["begraw","endraw","endresale","endprod"]
    : ["spmend471"];
  if(lifoActive() && !required.includes("begadd")) required.push("begadd");
  return required;
}

function inventoryRole(id){
  if(inventoryRequiredIds().includes(id)) return "required";
  if(state.activityType === "reseller") return "notused";
  if(id === "spmend471" && needsMspmDetail()) return "notused";
  return "support";
}

function inventoryRecommendedMode(id){
  const role = inventoryRole(id);
  if(role === "notused") return "";
  if(inventoryMappedRows(id).length) return "linked";
  if(inventoryState(id).zeroConfirmed) return "zero";
  return "";
}

function applyInventoryRecommendations(){
  normalizeInventoryInputs();
  INVENTORY_CONFIRMATION_DEFS.forEach(def => {
    const item = state.inventoryInputs[def.id];
    const mappedRows = inventoryMappedRows(def.id);
    if(mappedRows.length){
      item.mode = "linked";
      item.autoMode = "linked";
      item.zeroConfirmed = false;
      return;
    }
    if(item.zeroConfirmed){
      item.mode = "zero";
      item.autoMode = "";
      return;
    }
    item.mode = "";
    item.autoMode = "";
  });
}

function inventoryCalculationUse(id){
  const reseller = state.activityType === "reseller";
  const lifo = lifoActive();
  if(id === "spmend471") return {label:"Not used",detail:reseller ? "SRM does not use this producer field." : "The detailed ending amounts replace this old total."};
  if(reseller){
    if(id === "begresale") return {label:"SRM",detail:"Used to calculate the storage and handling rate."};
    if(id === "endresale") return lifo
      ? {label:"LIFO check",detail:"Must tie to the current-cost total in the LIFO pools."}
      : {label:"SRM",detail:"The SRM rate is applied to this ending amount."};
    if(id === "begadd" && lifo) return {label:"LIFO check",detail:"Must tie to the opening additional-cost layers in the LIFO pools."};
    return {label:"Not used",detail:"Does not change the SRM result."};
  }
  if(id === "begraw") return {label:"MSPM",detail:"Used to calculate the MSPM production rate."};
  if(["endraw","endresale","endprod"].includes(id)){
    if(lifo) return {label:"MSPM + LIFO check",detail:"Used by MSPM and checked against the current-cost total in the LIFO pools."};
    if(id === "endraw") return {label:spmAvailable() ? "SPM + MSPM" : "MSPM",detail:spmAvailable() ? "Determines raw materials in the SPM ending base and the MSPM production rate." : "Changes the MSPM ending amount and production rate."};
    return {label:spmAvailable() ? "SPM + MSPM" : "MSPM",detail:spmAvailable() ? "Included in ending inventory for both results." : "Included in ending inventory for MSPM."};
  }
  if(id === "begadd" && lifo) return {label:"LIFO check",detail:"Must tie to the opening additional-cost layers in the LIFO pools."};
  if(["begresale","begprod","begadd"].includes(id)) return {label:"Optional support",detail:"Shown for reconciliation; it does not change the current result."};
  return {label:"Not used",detail:"Does not change the current result."};
}

function inventoryModeValue(id){
  const item = inventoryState(id);
  if(item.mode === "linked") return inventoryMappedTotal(id);
  if(item.mode === "zero") return 0;
  return 0;
}

function inventoryFieldIssue(id,required=false){
  const item = inventoryState(id);
  if(inventoryRole(id) === "notused" && !required) return "";
  if(!item.mode) return required ? `No ${inventoryDisplayLabel(INVENTORY_CONFIRMATION_BY_ID[id])} row was found. Confirm $0 below or add that row in Step 2.` : "";
  if(item.mode === "linked"){
    if(!inventoryMappedRows(id).length) return required ? "No matching account row was found." : "";
    if(inventoryMappedTotal(id) < 0 && !(lifoActive() && id === "begadd")) return "This inventory balance cannot be negative.";
    return "";
  }
  if(item.mode === "zero") return "";
  return required ? "No matching account row was found. Confirm $0 below or add that row in Step 2." : "";
}

function inventoryCompletionIssues(c=null){
  const issues = inventoryRequiredIds().map(id => ({id,message:inventoryFieldIssue(id,true)})).filter(item => item.message).concat(fsaInventoryBasisIssues());
  if(lifoActive() && c) issues.push(...lifoCompletionIssues(c).map(message => ({id:"lifo",message})));
  return issues;
}

function inventoryStepComplete(c=null){
  return comparisonChoiceIsValid() && inventoryCompletionIssues(c).length === 0;
}

function inventoryStatus(id){
  const role = inventoryRole(id);
  const required = role === "required";
  const item = inventoryState(id);
  if(role === "notused") return {kind:"ok", text:"Not used. SPM is derived from the detailed MSPM inventory inputs."};
  const issue = inventoryFieldIssue(id,required);
  if(issue) return {kind:required ? "bad" : "warn", text:issue};
  if(!item.mode) return {kind:"warn", text:required ? "No matching account row was found." : "Optional support only; it does not change the result."};
  if(item.mode === "linked") return {kind:"ok", text:`Using ${inventoryMappedRows(id).length} confirmed Step 3 row(s).`};
  if(item.mode === "zero") return {kind:"ok", text:"Confirmed as $0."};
  return {kind:"warn", text:"No matching account row was found."};
}

