    || rowNeedsMspmBreakout(row)
    || rowNeedsTaxReconcileAdjustment(row)
    || rowNeedsFsaTaxAmount(row)
    || !!fsaAdditionalCostCharacterizationIssue(row)
    || rowNeedsFsaNegativeConfirmation(row)
