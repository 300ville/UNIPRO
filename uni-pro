function normalizeClassificationText(value){
  return String(value || "")
    .toLowerCase()
    .replace(/section/g,"sec")
    .replace(/&/g,"and")
    .replace(/[^a-z0-9]+/g," ")
    .trim();
}

function lookupInputId(value){
  const raw = String(value || "").trim();
  if(!raw) return null;
  if(inputById[raw]) return raw;
  const norm = normalizeClassificationText(raw);
  for(const opt of inputOptions){
    if(normalizeClassificationText(opt.id) === norm || normalizeClassificationText(opt.label) === norm) return opt.id;
  }
  const aliases = {
    "a":"begraw",
    "beginning direct material costs":"begraw",
    "beginning raw materials direct material costs":"begraw",
    "b":"begresale",
    "beginning property acquired for resale":"begresale",
    "d":"begprod",
    "beginning production sec 471 costs":"begprod",
    "e":"begadd",
    "beginning additional sec 263a costs":"begadd",
    "g":"raw",
    "direct material costs incurred":"raw",
    "direct material costs":"raw",
    "h":"resale",
    "property acquired for resale":"resale",
    "j":"prod471",
    "production sec 471 costs":"prod471",
    "k":"preadd",
    "pre production additional sec 263a costs":"preadd",
    "l":"prodadd",
    "production additional sec 263a costs":"prodadd",
    "n":"endraw",
    "ending direct material costs":"endraw",
    "o":"endresale",
