    analysis.needsTaxAmountSelection ? `<p class="note warn"><strong>Choose the federal tax amount column.</strong> More than one period-compatible tax column was found; UNIPRO will not guess.</p>` : "",
    analysis.basisConflict ? `<p class="note bad"><strong>Source-basis conflict.</strong> This report identifies the selected amounts as ${esc(analysis.selectedSourceBasis)} amounts, while Step 1 is set to ${esc(state.amountBasis)}. Change Step 1 or use a matching source column.</p>` : "",
