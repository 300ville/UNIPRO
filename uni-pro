function renderCompletionStatuses(c,validationItems=[]){
  const s = completionState(c,validationItems);
  const anyStep1 = !!String(state.clientName || "").trim()
    || !!String(state.taxYear || "").trim()
    || !!state.unicapHistory
    || !!state.firstUnicapYearReason
    || (Array.isArray(state.unicapChangeComponents) && state.unicapChangeComponents.length > 0)
    || !!state.amountBasis
    || !!state.bookTreatment
    || !!state.financialStatementQualified
    || !!state.financialStatementMethodAdopted
    || !!state.financialStatementValuationExcluded
    || !!state.financialStatementGrossReceiptsEligible
    || !!state.indirectCostRule;

  setStepStatus("step1Status",s.step1Complete ? "Complete" : (anyStep1 ? "Incomplete" : "Not started"),s.step1Complete ? "ok" : "warn");
  const step2IssueText = s.stats.parseIssues
    ? `${s.stats.parseIssues} amount issue(s)`
    : s.basisMismatchRows.length
      ? `${s.basisMismatchRows.length} source-basis mismatch(es)`
    : s.stats.duplicateGroups
      ? `${s.stats.duplicateGroups} duplicate group(s)`
      : "Action required";
  setStepStatus("step2Status",s.step2Complete ? "Complete" : (state.rows.length ? step2IssueText : "Not started"),s.step2Complete ? "ok" : (state.rows.length ? "bad" : "warn"));

  if(!state.rows.length){
    setStepStatus("step3Status","Not started","warn");
  } else if(s.step3Complete){
    setStepStatus("step3Status","Complete","ok");
  } else {
    const remaining = s.stats.reviewCount + s.stats.unconfirmedCount;
    const textValue = s.sourceRejectedCount
      ? `${s.sourceRejectedCount} source exception(s)`
      : s.stats.suspenseCount
      ? `${s.stats.suspenseCount} breakout(s) remaining`
      : s.stats.mspmBreakoutCount
        ? `${s.stats.mspmBreakoutCount} MSPM breakout(s) required`
      : s.stats.mspmReviewCount
        ? `${s.stats.mspmReviewCount} MSPM review(s) required`
      : s.requiredMissing.length
        ? `${s.requiredMissing.length} required amount(s) missing`
      : s.overlapMissing.length
        ? "Duplicate-cost check remaining"
      : s.bookTaxIssues.length
        ? `${s.bookTaxIssues.length} book-to-tax action(s) required`
      : s.unavailableRows.length
        ? `${s.unavailableRows.length} unavailable adjustment bucket(s)`
      : `${remaining} selection(s) remaining`;
    setStepStatus("step3Status",textValue,(s.sourceRejectedCount || s.stats.parseIssues || s.stats.mspmBreakoutCount) ? "bad" : "warn");
  }

  if(!state.rows.length){
    setStepStatus("step4Status","Not started","warn");
  } else if(!s.step3Complete){
    setStepStatus("step4Status","Waiting for Step 3","warn");
  } else if(s.step4Complete){
    setStepStatus("step4Status","Complete","ok");
  } else {
    setStepStatus("step4Status",`${s.inventoryIssues.length} inventory action(s) required`,`bad`);
  }

  if(!state.rows.length){
    setStepStatus("step5Status","Not started","warn");
  } else if(!s.step4Complete){
    setStepStatus("step5Status","Waiting for Step 4","warn");
  } else if(c.indirectCostRuleApplies){
    setStepStatus("step5Status","Not needed","ok");
  } else if(!s.hasMixedRows && !s.step5Complete){
    setStepStatus("step5Status",state.activityType === "reseller" ? "Confirm mixed service" : "Confirm no mixed service departments","warn");
  } else if(s.step5Complete){
    setStepStatus("step5Status","Ready","ok");
  } else if(isDetailedMixedMethod(state.mixedServiceMethod) || state.mixedDepartmentNinetyElection === "yes"){
    setStepStatus("step5Status","Support required","bad");
  } else if(s.step5Calculated){
    setStepStatus("step5Status","In progress","warn");
  } else {
    setStepStatus("step5Status",`${s.step5Issues.length} action(s) required`,`warn`);
  }

  const redBlocked = s.coreInputsReady && s.redItems.length > 0 && !s.overrideValid;
  setStepStatus("step6Status",s.workpaperReady ? "Results ready" : s.calculationReady ? (!s.methodSelectionComplete ? "Choose method" : !s.priorMethodProfileRecorded ? "Record prior method" : "Confirm support") : (redBlocked ? "Blocked by red flag" : (state.rows.length ? "Locked" : "Not started")),s.workpaperReady ? "ok" : (redBlocked ? "bad" : "warn"));
  if(!state.rows.length){
    setStepStatus("step7Status","Not started","warn");
  } else if(!s.coreInputsReady){
    setStepStatus("step7Status","Waiting for inputs","warn");
  } else if(s.redItems.length && !s.overrideValid){
    setStepStatus("step7Status",`${s.redItems.length} red flag(s) block`,`bad`);
  } else if(s.redItems.length && s.overrideValid){
    setStepStatus("step7Status",`${s.redItems.length} red flag(s) overridden`,`bad`);
  } else if(validationItems.length){
    setStepStatus("step7Status",`${validationItems.length} warning(s)`,`warn`);
  } else {
    setStepStatus("step7Status","Complete","ok");
  }
  setStepStatus("step8Status",s.workpaperReady ? "Workpaper ready" : s.calculationReady ? (!s.methodSelectionComplete ? "Waiting for method" : !s.priorMethodProfileRecorded ? "Waiting for prior method" : "Waiting for support") : (redBlocked ? "Blocked by red flag" : (state.rows.length ? "Locked" : "Not started")),s.workpaperReady ? "ok" : (redBlocked ? "bad" : "warn"));

  const staffName = !!String(state.staffReviewName || "").trim();
  const managerName = !!String(state.managerReviewName || "").trim();
  const seniorManagerName = !!String(state.seniorManagerReviewName || "").trim();
  const partnerName = !!String(state.partnerReviewName || "").trim();
  const namesReady = staffName && managerName && seniorManagerName && partnerName;
  const staffCurrent = staffReviewIsCurrent();
  const managerCurrent = managerReviewIsCurrent();
  const seniorManagerCurrent = seniorManagerReviewIsCurrent();
  const partnerCurrent = partnerReviewIsCurrent();
  const staleReview = state.reviewInvalidated
    || (state.staffReviewChecked && !staffCurrent)
    || (state.managerReviewChecked && !managerCurrent)
    || (state.seniorManagerReviewChecked && !seniorManagerCurrent)
    || (state.partnerReviewChecked && !partnerCurrent);
  const signoffComplete = s.workpaperReady && namesReady && staffCurrent && managerCurrent && seniorManagerCurrent && partnerCurrent;
  const signoffStarted = staffName || managerName || seniorManagerName || partnerName || state.staffReviewChecked || state.managerReviewChecked || state.seniorManagerReviewChecked || state.partnerReviewChecked;
  const step9Text = signoffComplete
    ? "Complete"
    : staleReview
      ? "Re-review required"
      : !s.workpaperReady && (state.staffReviewChecked || state.managerReviewChecked || state.seniorManagerReviewChecked || state.partnerReviewChecked)
        ? "Waiting for workpaper"
      : namesReady
        ? "Ready for review"
        : signoffStarted
          ? "Action required"
          : "Not started";
  setStepStatus("step9Status",step9Text,signoffComplete ? "ok" : (staleReview ? "bad" : "warn"));

  const banner = $("calculationCompletionBanner");
  if(!banner) return;
  banner.className = "note";
  if(s.calculationReady){
    if(!s.methodSelectionComplete){
      banner.innerHTML = spmAvailable()
        ? `<strong>Both results are calculated.</strong> Review them below, then choose the production method that applies to this tax year.`
        : `<strong>The available result is calculated.</strong> Confirm the production method that applies to this tax year.`;
    } else if(!s.priorMethodProfileRecorded){
      banner.innerHTML = `<strong>The current-year result is calculated.</strong> Record the prior method for each changed component below.`;
    } else if(!s.methodTransitionComplete){
      banner.innerHTML = `<strong>The current-year result is calculated.</strong> Confirm the separate method-change support below before finalizing the workpaper.`;
    } else if(s.overrideValid){
      banner.classList.add("bad");
      banner.innerHTML = `<strong>Calculation released by red-flag override.</strong> The overridden red flag(s) and required explanation will appear in the printed workpaper.`;
    } else if(validationItems.length){
      banner.innerHTML = `<strong>Calculation complete with warning(s).</strong> Review ${esc(validationItems.length)} item(s) in Step 7 before reliance.`;
    } else {
      banner.classList.add("ok");
      banner.innerHTML = `<strong>${esc(methodScopePlainLabel())} calculations complete.</strong>`;
    }
    return;
  }
  if(!state.rows.length){
    banner.innerHTML = "<strong>Calculation not started.</strong> Complete Steps 1 through 5.";
    return;
  }
  const actions = [];
  if(!s.step1Complete) actions.push("finish Step 1");
  if(s.stats.parseIssues) actions.push(`correct ${s.stats.parseIssues} import issue(s)`);
  if(s.stats.duplicateGroups) actions.push(`remove ${s.stats.duplicateGroups} duplicate group(s)`);
  const primaryRemaining = s.stats.reviewCount + s.stats.unconfirmedCount;
  if(primaryRemaining) actions.push(`make ${primaryRemaining} account selection(s)`);
  if(s.stats.suspenseCount) actions.push(`resolve ${s.stats.suspenseCount} breakout row(s)`);
  if(s.stats.mspmReviewCount) actions.push(`reconfirm ${s.stats.mspmReviewCount} account row(s) for MSPM`);
  if(s.stats.mspmBreakoutCount) actions.push(`break out ${s.stats.mspmBreakoutCount} aggregate SPM ending row(s)`);
  if(s.requiredMissing.length) actions.push(`confirm ${s.requiredMissing.length} missing categor${s.requiredMissing.length === 1 ? "y" : "ies"} as $0 or add the source row(s)`);
  if(s.overlapMissing.length) actions.push("finish the duplicate-cost check at the bottom of Step 3");
  if(s.step3Complete && !s.step4Complete) actions.push(`resolve ${s.inventoryIssues.length} missing inventory amount(s) in Step 4`);
  if(s.step4Complete && s.hasMixedRows && !s.step5Complete) actions.push("review the mixed service cost allocation in Step 5");
  if(redBlocked) actions.push(`resolve or override ${s.redItems.length} red flag(s) in Step 7`);
  banner.classList.add("bad");
  banner.innerHTML = `<strong>Calculation not complete.</strong> ${esc(actions.join("; ") || "Resolve the remaining required inputs")}.`;
}

