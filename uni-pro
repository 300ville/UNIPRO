}

function duplicateRowKey(row){
  const account = normalizeClassificationText(row && row.account);
  const description = normalizeClassificationText(row && row.description);
  if(!account && !description) return "";
  const parsed = parseAmountResult(row && row.amount);
  const amount = parsed.ok ? String(parsed.value) : `invalid:${String(row && row.amount || "").trim()}`;
  const taxParsed = parseAmountResult(row && (String(row.fsaTaxAmount ?? "").trim() ? row.fsaTaxAmount : row.sourceTaxAmount));
  const taxAmount = taxParsed.ok ? String(taxParsed.value) : "";
  return [account,description,amount,taxAmount].join("|");
}

function sourceIdentityKey(row){
  const account = normalizeClassificationText(row && row.account);
  const description = normalizeClassificationText(row && row.description);
  if(account) return `account:${account}`;
  return description ? `description:${description}` : "";
}

function appendIdentityOverlaps(incomingRows){
  const existingKeys = new Set(state.rows.map(sourceIdentityKey).filter(Boolean));
  return (incomingRows || []).filter(row => existingKeys.has(sourceIdentityKey(row)));
}

function duplicateRowGroups(rows=state.rows){
  const groups = new Map();
  rows.forEach(row => {
    const key = duplicateRowKey(row);
    if(!key) return;
    if(!groups.has(key)) groups.set(key,[]);
    groups.get(key).push(row);
  });
  return Array.from(groups.values()).filter(group => group.length > 1);
}

