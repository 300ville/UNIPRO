    mixedMspmSplitMethod:state.mixedMspmSplitMethod || "",
    mixedMspmNinetyElection:state.mixedMspmNinetyElection || "",
    srmSharedDepartmentStatus:state.srmSharedDepartmentStatus || "",
    lastImport:state.lastImport || null,
    importHistory:Array.isArray(state.importHistory) ? state.importHistory : [],
    sourceParents:Array.isArray(state.sourceParents) ? state.sourceParents : [],
    rows:state.rows.map(row => ({
      id:row.id || "",
      originalAccount:String(row.originalAccount || ""),
      originalDescription:String(row.originalDescription || ""),
      originalAmount:parseAmount(row.originalAmount),
