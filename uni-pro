function setFsaBookEqualsTax(rowId,value){
  const row = findRowById(rowId);
  if(!row || !fsaRowApplies(row) || parseAmountResult(row.sourceTaxAmount).ok || !["yes","no"].includes(value)) return;
  if(row.fsaBookEqualsTax === value) return;
  invalidateCalculationApprovals();
  row.fsaBookEqualsTax = value;
  row.fsaTaxAmount = "";
  row.fsaNegativeAdjustmentConfirmed = false;
  renderAll();
  setTimeout(() => {
    if(Number(state.currentStage) !== 3) return;
    const inspectorOpen = $("accountInspectorOverlay") && !$("accountInspectorOverlay").classList.contains("hidden");
    const scope = inspectorOpen ? $("accountInspectorBody") : document;
    if(value === "no"){
      const input = Array.from(scope.querySelectorAll("[data-fsa-tax-row-id]")).find(item => item.dataset.fsaTaxRowId === String(row.id));
      if(input) input.focus();
      return;
    }
    const radios = Array.from(scope.querySelectorAll('input[type="radio"]'));
    const response = inspectorOpen
      ? radios.find(input => input.name === "inspectorFsaBookEqualsTax" && input.value === value)
      : radios.find(input => input.name === `bookTax-${row.id}` && input.value === value);
    if(response) response.focus();
  },0);
}

function fsaBookTaxInlineHtml(row){
  if(!fsaRowApplies(row)) return "";
  const tax = fsaTaxAmountResult(row);
  const imported = parseAmountResult(row.sourceTaxAmount);
  if(imported.ok) return `<div class="small-note"><strong>Federal tax ${esc(moneyWp(imported.value))}</strong> · Tax less Book ${esc(moneyWp(fsaTaxLessBook(row)))} · Imported</div>`;
  const id = String(row.id);
  const yesChecked = row.fsaBookEqualsTax === "yes" ? "checked" : "";
  const noChecked = row.fsaBookEqualsTax === "no" ? "checked" : "";
