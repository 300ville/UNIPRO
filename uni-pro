    controlFailures.length ? `<p class="note bad"><strong>${esc(controlFailures.length)} report control(s) do not tie.</strong> A subtotal or total differs from its underlying detail. Correct the source before importing.</p>` : "",
    appendOverlaps.length ? `<p class="note bad"><strong>${esc(appendOverlaps.length)} pasted account(s) are already in the current list.</strong> To update them, select Replace the current account list.</p>` : "",
    rejected.length ? `<p class="note bad"><strong>Import blocked.</strong> Correct every unread account line and try again.</p>` : ""
  ].filter(Boolean).join("");
  const canImport = analysis.rows.length > 0 && !analysis.needsAmountSelection && !analysis.needsTaxAmountSelection && !analysis.basisConflict && !analysis.periodConflict && !controlFailures.length && !appendOverlaps.length && !rejected.length;
  const importButtonText = analysis.needsAmountSelection ? "Choose calculation amount column" : analysis.needsTaxAmountSelection ? "Choose Federal tax amount column" : `Import ${analysis.rows.length} account row${analysis.rows.length === 1 ? "" : "s"} from ${analysis.amountColumnLabel || "source"}`;
  box.classList.remove("hidden");
  box.innerHTML = `${amountChoice}${taxAmountChoice}${blockingNotices}<div class="import-preview-grid">
      <div class="import-preview-stat"><span>${analysis.needsAmountSelection ? "Account rows detected" : "Account rows ready"}</span><strong>${esc(analysis.rows.length || analysis.detectedAccountRows || 0)}</strong></div>
