function secondaryBaseRollup(){
  const rows = allocationBaseRows();
  let mixedPreProductionLabor = 0;
  let mixedProductionLabor = 0;
  let mixedOtherLabor = 0;
  let mixedSec263AProductionCosts = 0;
  let mixedOtherCosts = 0;

  rows.forEach(row => {
    if(row.inputId === "mixedservice" || row.inputId === "review" || (inputById[row.inputId] && inputById[row.inputId].group === "Breakout / Suspense")) return;
    const amount = allocationBaseAmount(row);
    if(row.laborConfirmed === true && row.laborTreatment === "preproduction") mixedPreProductionLabor += amount;
    else if(row.laborConfirmed === true && row.laborTreatment === "production") mixedProductionLabor += amount;
    else if(row.laborConfirmed === true && row.laborTreatment === "other") mixedOtherLabor += amount;

    if(row.costConfirmed === true && row.costTreatment === "sec263a") mixedSec263AProductionCosts += amount;
    else if(row.costConfirmed === true && row.costTreatment === "other") mixedOtherCosts += amount;
  });

  const mixedSec263ALabor = mixedPreProductionLabor + mixedProductionLabor;
  const mixedTotalLabor = mixedSec263ALabor + mixedOtherLabor;
  const mixedTotalCosts = mixedSec263AProductionCosts + mixedOtherCosts;
  return {
    mixedPreProductionLabor,
    mixedProductionLabor,
    mixedOtherLabor,
    mixedSec263ALabor,
    mixedTotalLabor,
    mixedSec263AProductionCosts,
    mixedOtherCosts,
    mixedTotalCosts,
    baseMappingStats:baseMappingStats()
  };
}

function calculationFingerprint(){
