  if(FSA_ADDITIONAL_CHARACTERIZATION_INPUT_IDS.has(row.inputId) && row.fsaAdditionalCostType === "section471Special") return "This is a Section 471-type cost treated as additional under the supported special rule. Its Book amount and signed Tax less Book difference both remain in the existing additional Section 263A layer; UNIPRO does not create a duplicate source row.";
  if(FSA_ADDITIONAL_CHARACTERIZATION_INPUT_IDS.has(row.inputId) && row.fsaAdditionalCostType === "ordinary") return "This is an ordinary additional Section 263A cost. Its Federal tax amount drives the existing layer directly; Tax less Book remains a reconciliation field and is not added again.";
  if(FSA_ADDITIONAL_CHARACTERIZATION_INPUT_IDS.has(row.inputId)) return "Choose the additional-cost characterization so UNIPRO can document whether this is an ordinary additional cost or a Section 471-type cost treated as additional under a supported special rule.";
  if(fsaMscBaseRowApplies(row)) return "The Federal tax amount is used in the selected mixed service allocation ratio. It does not create a separate Section 471 or additional Section 263A row.";
