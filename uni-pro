function sameImportDatasetContract(previous,analysis){
  if(!previous || !analysis) return true;
  const priorPeriod = canonicalPeriodDate(previous.reportPeriod || "") || periodYear(previous.reportPeriod || "");
  const nextPeriod = canonicalPeriodDate(analysis.reportPeriod || "") || periodYear(analysis.reportPeriod || "");
  const priorAmount = normalizeHeader(String(previous.amountColumnLabel || "").split("|")[0]);
  const nextAmount = normalizeHeader(String(analysis.amountColumnLabel || "").split("|")[0]);
  const priorTax = normalizeHeader(String(previous.taxAmountColumnLabel || "").split("|")[0]);
  const nextTax = normalizeHeader(String(analysis.taxAmountColumnLabel || "").split("|")[0]);
  return previous.amountBasis === state.amountBasis
    && String(previous.sourceBasis || "") === String(analysis.selectedSourceBasis || analysis.reportSourceBasis || state.amountBasis || "")
    && (!priorPeriod || !nextPeriod || priorPeriod === nextPeriod)
    && String(previous.sourceFormat || "") === String(analysis.sourceFormat || "")
    && priorAmount === nextAmount
    && priorTax === nextTax;
}

function confirmPastedImport(){
  const analysis = pendingImportAnalysis;
  if(!analysis || !analysis.rows.length) return;
  const currentPreviewColumn = $("previewAmountColumn") ? $("previewAmountColumn").value : analysis.selectedAmountColumnKey;
  const currentPreviewTaxColumn = $("previewTaxAmountColumn") ? $("previewTaxAmountColumn").value : analysis.selectedTaxAmountColumnKey;
  if(analysis.previewText !== $("pasteBox").value || analysis.previewMode !== $("pasteMode").value || analysis.previewSuggestionBasis !== state.suggestionBasis || analysis.previewAmountBasis !== state.amountBasis || analysis.previewTaxYear !== state.taxYear || analysis.previewParserVersion !== IMPORT_PARSER_VERSION || currentPreviewColumn !== analysis.selectedAmountColumnKey || currentPreviewTaxColumn !== analysis.selectedTaxAmountColumnKey){
    alert("The source text, import mode, period, basis, suggestion basis, or amount column changed after preview. Preview the current source again before confirming.");
    cancelImportPreview();
    return;
  }
  if(analysis.needsAmountSelection || analysis.needsTaxAmountSelection || analysis.basisConflict || analysis.periodConflict || (analysis.controlFailures || []).length || (analysis.appendIdentityOverlaps || []).length){
    alert("Finish the highlighted import items before continuing.");
    return;
  }
  const mode = $("pasteMode").value === "replace" ? "replace" : "append";
  if(mode === "append" && state.lastImport){
    if(!sameImportDatasetContract(state.lastImport,analysis)){
      alert("These accounts do not match the current report. Add accounts only from the same report, or select Replace the current account list.");
      return;
    }
  }
  if(mode === "append" && (state.importHistory || []).some(item => (item.sourceFingerprint && item.sourceFingerprint === analysis.sourceFingerprint) || (item.batchFingerprint && item.batchFingerprint === analysis.batchFingerprint))){
    alert("This report was already added. Select Replace the current account list if you want to use a different amount column.");
    return;
  }
  const resolvesPriorRejections = mode === "append" && !!$("resolvePriorRejections") && $("resolvePriorRejections").checked;
  if(mode === "append" && state.lastImport && Array.isArray(state.lastImport.rejected) && state.lastImport.rejected.length && !analysis.rejected.length && !resolvesPriorRejections){
    alert("Confirm that this paste corrects every unread line, or select Replace the current account list and paste the complete report again.");
    return;
  }
  const importSnapshot = JSON.parse(JSON.stringify(state));
  invalidateCalculationApprovals();
  lastImportSnapshot = importSnapshot;
  const importedAt = new Date().toISOString();
  const importId = `import_${Date.now().toString(36)}`;
  analysis.rows.forEach(row => { row.sourceImportId = importId; });
  if(mode === "replace"){
    state.rows = analysis.rows;
    resetSourceDependentInputs();
  } else {
    state.rows = state.rows.concat(analysis.rows);
    if(financialStatementAlternativeActive()){
      state.bookTaxControlTotal = "";
      state.bookTaxReference = "";
    }
  }
  const priorSummary = mode === "append" && state.lastImport ? state.lastImport : null;
  const priorRejected = priorSummary && Array.isArray(priorSummary.rejected) && !resolvesPriorRejections ? priorSummary.rejected : [];
  const ignoredCounts = (analysis.ignored || []).reduce((counts,item) => {
    const reason = item.reason || "Report structure";
    counts[reason] = (counts[reason] || 0) + 1;
    return counts;
  },{});
  const finalPopulationControls = (analysis.controlChecks || [])
    .filter(control => String(control.type || "").startsWith("Final population total") || String(control.type || "").startsWith("Grand total"))
    .map(control => ({line:control.line,type:control.type,label:control.label,sourceAmount:control.sourceAmount,detailAmount:control.detailAmount,difference:control.difference}));
  state.lastImport = {
    at:importedAt,
    accepted:(priorSummary ? Number(priorSummary.accepted || 0) : 0) + analysis.rows.length,
    rejected:priorRejected.concat(analysis.rejected),
    net:(priorSummary ? Number(priorSummary.net || 0) : 0) + analysis.net,
    absolute:(priorSummary ? Number(priorSummary.absolute || 0) : 0) + analysis.absolute,
    headerDetected:analysis.hasHeader,
    headerLine:analysis.headerLine || null,
    secondaryHeaderLine:analysis.secondaryHeaderLine || null,
    amountColumnLabel:analysis.amountColumnLabel,
    amountColumnKey:analysis.selectedAmountColumnKey || "",
    taxAmountColumnLabel:analysis.taxAmountColumnLabel || "",
    taxAmountColumnKey:analysis.selectedTaxAmountColumnKey || "",
    amountBasis:state.amountBasis,
    sourceBasis:analysis.selectedSourceBasis || analysis.reportSourceBasis || state.amountBasis,
    sourceFormat:analysis.sourceFormat || "Delimited source data",
    reportPeriod:analysis.reportPeriod || "",
    ignoredStructural:(priorSummary ? Number(priorSummary.ignoredStructural || 0) : 0) + (analysis.ignored || []).length,
    ignoredCounts,
    controlsPassed:(analysis.controlChecks || []).length,
    finalPopulationControls,
    parserVersion:IMPORT_PARSER_VERSION,
    batchFingerprint:analysis.batchFingerprint,
    sourceFingerprint:analysis.sourceFingerprint,
    suggestionBasis:state.suggestionBasis,
    resolvedPriorRejections:resolvesPriorRejections
  };
  if(!Array.isArray(state.importHistory)) state.importHistory = [];
  state.importHistory.push({id:importId,at:importedAt,mode,accepted:analysis.rows.length,rejected:analysis.rejected,net:analysis.net,absolute:analysis.absolute,headerDetected:analysis.hasHeader,headerLine:analysis.headerLine || null,secondaryHeaderLine:analysis.secondaryHeaderLine || null,amountColumnLabel:analysis.amountColumnLabel,amountColumnKey:analysis.selectedAmountColumnKey || "",taxAmountColumnLabel:analysis.taxAmountColumnLabel || "",taxAmountColumnKey:analysis.selectedTaxAmountColumnKey || "",amountBasis:state.amountBasis,sourceBasis:analysis.selectedSourceBasis || analysis.reportSourceBasis || state.amountBasis,sourceFormat:analysis.sourceFormat || "Delimited source data",reportPeriod:analysis.reportPeriod || "",ignoredStructural:(analysis.ignored || []).length,ignoredCounts,controlsPassed:(analysis.controlChecks || []).length,finalPopulationControls,parserVersion:IMPORT_PARSER_VERSION,batchFingerprint:analysis.batchFingerprint,sourceFingerprint:analysis.sourceFingerprint,suggestionBasis:state.suggestionBasis,resolvedPriorRejections:resolvesPriorRejections});
  pendingImportAnalysis = null;
  $("pasteBox").value = "";
  renderImportPreview(null);
  renderAll();
  openStageAutomatically(3);
}

function changeSuggestionBasis(value){
  if(!["account","description","both"].includes(value) || value === state.suggestionBasis) return;
  const rebuildPreview = !!pendingImportAnalysis;
  invalidateCalculationApprovals();
  state.suggestionBasis = value;
  state.rows.forEach(row => {
    const c = classifySourceAccountWithContext(row.account,row.description,[row.sourceGroup,row.sourceSubgroup],value);
    row.suggestedInputId = c.inputId;
    row.confidence = c.confidence;
    row.suggestionReason = c.reason;
    syncBaseSuggestions(row,false);
  });
  if(rebuildPreview) previewPastedRows();
  renderAll();
}

function excludeRow(index){
  const row = state.rows[index];
  if(!row) return;
  let fsaExclusionType = "";
  if(financialStatementAlternativeActive()){
    const selection = prompt("FSA exclusion type:\n1 — Not capitalized to eligible property in the qualifying financial statement\n2 — Financial-statement write-down, reserve, or valuation adjustment\n\nEnter 1 or 2. If neither applies, cancel and retain the row.","");
    if(selection === null) return;
    if(String(selection).trim() === "1") fsaExclusionType = "fsaTrueExclusion";
    else if(String(selection).trim() === "2") fsaExclusionType = "fsaValuationExclusion";
    else {
      alert("A cost capitalized in the qualifying financial statement but removed for Federal tax is not a simple exclusion. Retain the row and enter its Federal tax amount, including zero.");
      return;
    }
  }
  const reason = prompt("Document why this source line is excluded. The original row will remain in the workpaper.",row.notes || "");
  if(reason === null) return;
  if(!String(reason).trim()){
    alert("An exclusion reason is required.");
    return;
  }
  invalidateCalculationApprovals();
  clearBookTaxMethodConfirmation();
  row.inputId = "excludedOther";
  row.review = false;
  row.confirmed = true;
  row.confirmedAt = new Date().toISOString();
  if(fsaExclusionType) row.sourceKind = fsaExclusionType;
  const exclusionLabel = fsaExclusionType === "fsaValuationExclusion" ? "FSA valuation exclusion" : fsaExclusionType === "fsaTrueExclusion" ? "Not capitalized in qualifying statement" : "Excluded from calculation";
  row.notes = `${exclusionLabel}: ${String(reason).trim()}`;
  row.reason = `${exclusionLabel}; original source fields were retained.`;
  row.notIn471Confirmed = false;
  clearFsaBookTaxDecision(row,true);
  row.fsaAdditionalCostType = "";
  row.fsaSpecialRuleReference = "";
  row.mspmConfirmed = false;
  syncBaseSuggestions(row,true);
  renderAll();
}

function undoLastImport(){
  if(!lastImportSnapshot) return;
  if(!confirm("Undo the latest import? Any classifications, inventory inputs, notes, or signoffs made since that import will be discarded.")) return;
  resetWorkflowAutoAdvanceTracking();
  state = JSON.parse(JSON.stringify(lastImportSnapshot));
  calculationRevision += 1;
  fingerprintCacheRevision = -1;
  lastImportSnapshot = null;
  pendingImportAnalysis = null;
  setControls();
  renderImportPreview(null);
  renderAll();
}

