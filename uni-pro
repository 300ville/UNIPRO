}

function previewPastedRows(amountColumnKey=null,taxAmountColumnKey=null){
  const preservedAmountColumnKey = amountColumnKey === null ? ((pendingImportAnalysis && pendingImportAnalysis.selectedAmountColumnKey) || "") : String(amountColumnKey || "");
  const preservedTaxAmountColumnKey = taxAmountColumnKey === null ? ((pendingImportAnalysis && pendingImportAnalysis.selectedTaxAmountColumnKey) || "") : String(taxAmountColumnKey || "");
  const analysis = analyzePastedData($("pasteBox").value,{amountColumnKey:preservedAmountColumnKey,taxAmountColumnKey:preservedTaxAmountColumnKey});
  analysis.previewText = $("pasteBox").value;
  analysis.previewMode = $("pasteMode").value;
  analysis.previewSuggestionBasis = state.suggestionBasis;
  analysis.previewAmountBasis = state.amountBasis;
  analysis.previewTaxYear = state.taxYear;
  analysis.previewParserVersion = IMPORT_PARSER_VERSION;
  analysis.batchFingerprint = importBatchFingerprint(analysis.previewText,analysis);
  analysis.sourceFingerprint = importSourceFingerprint(analysis.previewText);
  const proposedRows = $("pasteMode").value === "replace" ? analysis.rows : state.rows.concat(analysis.rows);
  analysis.duplicateGroups = duplicateRowGroups(proposedRows).length;
  analysis.appendIdentityOverlaps = $("pasteMode").value === "append" ? appendIdentityOverlaps(analysis.rows) : [];
  pendingImportAnalysis = analysis;
  const blocked = !analysis.rows.length || analysis.needsAmountSelection || analysis.needsTaxAmountSelection || analysis.basisConflict || analysis.periodConflict || (analysis.controlFailures || []).length || (analysis.appendIdentityOverlaps || []).length;
  if(blocked){
    renderImportPreview(analysis);
    return;
  }
  confirmPastedImport();
}

