function importBatchFingerprint(text,analysis={}){
  const canonical = [
    IMPORT_PARSER_VERSION,
    state.amountBasis || "",
    state.taxYear || "",
    analysis.selectedAmountColumnKey || "",
    analysis.selectedTaxAmountColumnKey || "",
    String(text || "").replace(/\r\n?/g,"\n").replace(/\u00a0/g," ").trim()
  ].join("\n|");
  let hash = 2166136261;
  for(let index=0;index<canonical.length;index++){
    hash ^= canonical.charCodeAt(index);
    hash = Math.imul(hash,16777619);
  }
  return `imp-${(hash>>>0).toString(16).padStart(8,"0")}-${canonical.length}`;
}

function importSourceFingerprint(text){
  const canonical = `${IMPORT_PARSER_VERSION}\n${String(text || "").replace(/\r\n?/g,"\n").replace(/\u00a0/g," ").trim()}`;
  let hash = 2166136261;
  for(let index=0;index<canonical.length;index++){
    hash ^= canonical.charCodeAt(index);
    hash = Math.imul(hash,16777619);
  }
  return `src-${(hash>>>0).toString(16).padStart(8,"0")}-${canonical.length}`;
}

