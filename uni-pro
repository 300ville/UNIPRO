function fsaLinkedLayer(row){
  if(!row) return "Not applicable";
  if(row.inputId === "raw" || row.inputId === "resale") return "Pre-production additional Section 263A costs";
  if(row.inputId === "prod471") return "Production additional Section 263A costs";
  if(row.inputId === "preadd") return row.fsaAdditionalCostType === "section471Special" ? "Pre-production additional Section 263A costs; Book plus Tax less Book under the supported special rule" : row.fsaAdditionalCostType === "ordinary" ? "Pre-production additional Section 263A costs; Federal tax amount used directly" : "Pre-production additional Section 263A costs; characterization required";
  if(row.inputId === "prodadd") return row.fsaAdditionalCostType === "section471Special" ? "Production additional Section 263A costs; Book plus Tax less Book under the supported special rule" : row.fsaAdditionalCostType === "ordinary" ? "Production additional Section 263A costs; Federal tax amount used directly" : "Production additional Section 263A costs; characterization required";
  if(row.inputId === "mixedservice") return "Mixed-service cost pool; tax amount used directly";
  return "Not applicable";
}

function fsaSection471Layer(row){
  if(!row) return "Not applicable";
  if(FSA_ADDITIONAL_CHARACTERIZATION_INPUT_IDS.has(row.inputId)){
    if(row.fsaAdditionalCostType === "section471Special") return `Section 471-type cost treated as additional under supported special rule${String(row.fsaSpecialRuleReference || "").trim() ? ` (${String(row.fsaSpecialRuleReference).trim()})` : ""}`;
    if(row.fsaAdditionalCostType === "ordinary") return "Ordinary additional Section 263A cost; not a Section 471 cost";
    return "Additional-cost characterization required";
  }
  if(!FSA_SECTION_471_INPUT_IDS.has(row.inputId)) return "Not a Section 471 row; Federal tax amount drives its existing cost layer";
