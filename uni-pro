function exportExcel(){
  const c=calc();invalidateStaleApprovals();const completion=completionState(c);
  if(!completion.workpaperReady){
    alert(completion.calculationReady && !completion.methodSelectionComplete
      ? "Review both results in Step 6 and choose the production method before exporting."
      : completion.calculationReady && !completion.priorMethodProfileRecorded
      ? "Record the prior method for each changed component in Step 6 before exporting."
      : completion.calculationReady && !completion.methodTransitionComplete
      ? "Confirm the separate method-change support in Step 6 before exporting."
      : "Excel export is locked until the required calculation steps are complete and all blocking red flags are resolved or documented.");
    return;
  }
  const namesComplete=[state.staffReviewName,state.managerReviewName,state.seniorManagerReviewName,state.partnerReviewName].every(name=>!!String(name||"").trim());
  const isDraft=!(namesComplete&&staffReviewIsCurrent()&&managerReviewIsCurrent()&&seniorManagerReviewIsCurrent()&&partnerReviewIsCurrent());
  if(isDraft&&!confirm("The review signoffs are incomplete or do not match the current calculation. The Excel file will be clearly marked DRAFT FOR REVIEW ONLY. Continue?"))return;
  try{
    const sheets=buildUniproExcelSheets(c,isDraft);const blob=buildUniproXlsxBlob(sheets);
    const filename=`UNIPRO_${xlsxSafeFilePart(state.clientName)}_${xlsxSafeFilePart(state.taxYear)}.xlsx`;
    downloadBlob(filename,blob);
  }catch(error){console.error(error);alert("The Excel workpaper could not be created. Review the browser console for details.");}
}

const BRAND_INTRO_DURATION = 2050;
let brandIntroTimer = null;

function finishBrandIntro(){
  const intro = $("brandIntro");
  if(!intro || intro.hidden) return;
  if(brandIntroTimer) clearTimeout(brandIntroTimer);
  brandIntroTimer = null;
  intro.hidden = true;
  intro.classList.remove("is-running");
  document.body.classList.remove("intro-running");
}

function startBrandIntro(){
  const intro = $("brandIntro");
  if(!intro) return;
  if(window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches){
    finishBrandIntro();
    return;
  }
  document.body.classList.add("intro-running");
  requestAnimationFrame(() => intro.classList.add("is-running"));
  brandIntroTimer = setTimeout(finishBrandIntro,BRAND_INTRO_DURATION);
}

const brandIntro = $("brandIntro");
if(brandIntro) brandIntro.addEventListener("click",finishBrandIntro);
document.addEventListener("keydown", event => {
  if(!brandIntro || brandIntro.hidden) return;
  if(["Escape","Enter"," "].includes(event.key)) finishBrandIntro();
