function editRowTextLive(index,field,value){
  if(!state.rows[index] || !["description","account"].includes(field)) return;
  const row = state.rows[index];
  if(String(row[field] ?? "") === String(value ?? "")) return;
  invalidateCalculationApprovals();
  clearBookTaxMethodConfirmation();
  row[field] = value;
  resetRowClassificationAfterSourceTextChange(row);
  row._textEditPendingField = field;
}

function editRow(index,field,value){
  if(!state.rows[index]) return;
  const row = state.rows[index];
  if((field === "description" || field === "account") && row._textEditPendingField === field){
    row[field] = value;
    delete row._textEditPendingField;
    setTimeout(() => renderAll(),0);
    return;
  }
  if(field === "amount"){
    const parsed = parseAmountResult(value);
    const nextValue = parsed.ok ? parsed.value : value;
    const unchanged = parsed.ok && row.parseOk !== false
      ? parseAmount(row.amount) === parsed.value
      : row.parseOk === false && String(row.amount ?? "") === String(nextValue ?? "");
    if(unchanged) return;
    invalidateCalculationApprovals();
    clearBookTaxMethodConfirmation();
    row.amount = nextValue;
    row.parseOk = parsed.ok;
    row.parseWarning = parsed.ok ? "" : (parsed.blank ? "Source amount is blank." : `Source amount '${String(value ?? "")}' is not valid.`);
    if(OVERLAP_CONFIRMATION_IDS.has(row.inputId)) row.notIn471Confirmed = false;
    row.fsaNegativeAdjustmentConfirmed = false;
    clearFsaBookTaxDecision(row,true);
  } else {
    if(String(row[field] ?? "") === String(value ?? "")) return;
    invalidateCalculationApprovals();
    row[field] = value;
  }
  if(field === "description" || field === "account"){
    resetRowClassificationAfterSourceTextChange(row);
  }
  if(field === "amount" || field === "usePct"){
    const cell = $("mapped-" + index);
    if(cell) cell.textContent = moneyWhole(mapped(row));
    renderCalcOnly();
  } else {
    renderAll();
  }
}

