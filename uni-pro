editLifoLayerLive(${jsString(pool.id)},${jsString(layer.id)},'reference',this.value)" onblur="blurLifoLayerField(${jsString(pool.id)},${jsString(layer.id)},'reference',this)"></td><td><button class="ghost" type="button" aria-label="Remove ${esc(pool.name || `Pool ${index + 1}`)} layer ${esc(layer.layerYear || "")}" onclick="removeLifoLayer(${jsString(pool.id)},${jsString(layer.id)})">Remove</button></td></tr>`).join("") || `<tr><td colspan="7">Add each prior layer invaded by this decrement.</td></tr>`}
      </tbody></table></div><fieldset class="lifo-attestation"><legend>Are all invaded layers entered completely and in the order required by the adopted LIFO method?</legend><div class="binary-choice-grid"><label class="binary-choice"><input type="radio" name="lifoLayersComplete_${esc(pool.id)}" value="yes" ${pool.decrementLayersComplete === "yes" ? "checked" : ""} onchange="editLifoPoolLive(${jsString(pool.id)},'decrementLayersComplete',this.value);renderCalcOnly()"><span>Yes</span></label><label class="binary-choice"><input type="radio" name="lifoLayersComplete_${esc(pool.id)}" value="no" ${pool.decrementLayersComplete === "no" ? "checked" : ""} onchange="editLifoPoolLive(${jsString(pool.id)},'decrementLayersComplete',this.value);renderCalcOnly()"><span>No</span></label></div></fieldset></div>` : "";
    return `<section class="lifo-pool-editor"><div class="lifo-pool-head"><div><span>Pool ${index + 1}</span><strong>${esc(pool.name || "Unnamed pool")}</strong></div><div class="lifo-pool-status ${poolIssues.length ? "bad" : "ok"}">${poolIssues.length ? `${poolIssues.length} action(s) required` : "Entered controls passed"}</div><button class="ghost" type="button" aria-label="Remove LIFO pool ${esc(pool.name || `Pool ${index + 1}`)}" onclick="removeLifoPool(${jsString(pool.id)})">Remove pool</button></div>
      <div class="lifo-field-grid">
        <label>Pool or grouping name<input value="${esc(pool.name || "")}" oninput="editLifoPoolLive(${jsString(pool.id)},'name',this.value)" onblur="blurLifoPoolField(${jsString(pool.id)},'name',this)"></label>
        <label>LIFO method<select onchange="editLifoPoolLive(${jsString(pool.id)},'lifoType',this.value);renderCalcOnly()"><option value="">Select</option><option value="dollarValue" ${pool.lifoType === "dollarValue" ? "selected" : ""}>Dollar-value LIFO</option><option value="specificGoods" ${pool.lifoType === "specificGoods" ? "selected" : ""}>Specific-goods LIFO</option></select></label>
        <label>Adopted method / index source<input value="${esc(pool.methodSource || "")}" placeholder="e.g., IPIC pool schedule" oninput="editLifoPoolLive(${jsString(pool.id)},'methodSource',this.value)" onblur="blurLifoPoolField(${jsString(pool.id)},'methodSource',this)"></label>
        <label>LIFO workpaper reference<input value="${esc(pool.reference || "")}" oninput="editLifoPoolLive(${jsString(pool.id)},'reference',this.value)" onblur="blurLifoPoolField(${jsString(pool.id)},'reference',this)"></label>
        <fieldset class="lifo-attestation"><legend>Does the source exclude additional Section 263A?</legend><div class="binary-choice-grid"><label class="binary-choice"><input type="radio" name="lifoExcludes_${esc(pool.id)}" value="yes" ${pool.excludesAdditional263A === "yes" ? "checked" : ""} onchange="editLifoPoolLive(${jsString(pool.id)},'excludesAdditional263A',this.value);renderCalcOnly()"><span>Yes</span></label><label class="binary-choice"><input type="radio" name="lifoExcludes_${esc(pool.id)}" value="no" ${pool.excludesAdditional263A === "no" ? "checked" : ""} onchange="editLifoPoolLive(${jsString(pool.id)},'excludesAdditional263A',this.value);renderCalcOnly()"><span>No</span></label></div></fieldset>
        ${financialStatementAlternativeActive() ? `<fieldset class="lifo-attestation"><legend>Does the pool use the same financial-statement-alternative Section 471 basis?</legend><div class="binary-choice-grid"><label class="binary-choice"><input type="radio" name="lifoFsaBasis_${esc(pool.id)}" value="yes" ${pool.fsaBasisConfirmed === "yes" ? "checked" : ""} onchange="editLifoPoolLive(${jsString(pool.id)},'fsaBasisConfirmed',this.value);renderCalcOnly()"><span>Yes</span></label><label class="binary-choice"><input type="radio" name="lifoFsaBasis_${esc(pool.id)}" value="no" ${pool.fsaBasisConfirmed === "no" ? "checked" : ""} onchange="editLifoPoolLive(${jsString(pool.id)},'fsaBasisConfirmed',this.value);renderCalcOnly()"><span>No</span></label></div></fieldset>` : ""}
        <label>Current-cost ending Section 471<input type="text" inputmode="decimal" value="${esc(currencyInputValue(pool.currentCostEnding471))}" onfocus="focusCurrencyInput(this)" oninput="editLifoPoolLive(${jsString(pool.id)},'currentCostEnding471',this.value)" onblur="blurLifoPoolField(${jsString(pool.id)},'currentCostEnding471',this)"></label>
        <label>Beginning LIFO Section 471<input type="text" inputmode="decimal" value="${esc(currencyInputValue(pool.beginningLifo471))}" onfocus="focusCurrencyInput(this)" oninput="editLifoPoolLive(${jsString(pool.id)},'beginningLifo471',this.value)" onblur="blurLifoPoolField(${jsString(pool.id)},'beginningLifo471',this)"></label>
        <label>Beginning additional Section 263A<input type="text" inputmode="decimal" value="${esc(currencyInputValue(pool.beginningAdditional263A))}" onfocus="focusCurrencyInput(this)" oninput="editLifoPoolLive(${jsString(pool.id)},'beginningAdditional263A',this.value)" onblur="blurLifoPoolField(${jsString(pool.id)},'beginningAdditional263A',this)"></label>
        <label>Signed Section 471 movement from LIFO workpaper<input type="text" inputmode="decimal" value="${esc(currencyInputValue(pool.movement471))}" placeholder="Positive CY-dollar increment; negative layer-dollar decrement; 0 no change" onfocus="focusCurrencyInput(this)" oninput="editLifoPoolLive(${jsString(pool.id)},'movement471',this.value)" onblur="blurLifoPoolField(${jsString(pool.id)},'movement471',this)"></label>
        <label>Independent ending LIFO Section 471 control<input type="text" inputmode="decimal" value="${esc(currencyInputValue(pool.endingLifo471Control))}" onfocus="focusCurrencyInput(this)" oninput="editLifoPoolLive(${jsString(pool.id)},'endingLifo471Control',this.value)" onblur="blurLifoPoolField(${jsString(pool.id)},'endingLifo471Control',this)"></label>
      </div>
      <div class="lifo-derived-grid"><div><span>Derived ending Section 471</span><strong>${esc(moneyWp(p.ending471))}</strong></div><div><span>Prior Section 263A released</span><strong>${esc(moneyWp(p.release))}</strong></div><div><span>SPM current addition</span><strong>${esc(moneyWp(p.spmCurrentAddition))}</strong></div><div><span>MSPM current addition</span><strong>${esc(moneyWp(p.mspmCurrentAddition))}</strong></div></div>
      ${layers}
      ${poolIssues.length ? `<div class="lifo-pool-issues">${poolIssues.map(issue => `<p>${esc(issue)}</p>`).join("")}</div>` : ""}
    </section>`;
  }).join("");
  box.innerHTML = `<div class="lifo-title-row"><div><h3>LIFO integration</h3><p>Enter each pool or grouping from the completed LIFO workpaper. State increments in current-year dollars. State decrements in the dollars applicable to each invaded layer. Every amount must exclude additional Section 263A.</p></div><button class="secondary" type="button" onclick="addLifoPool()">Add LIFO pool</button></div>
    ${outside}
    ${poolHtml || `<div class="note bad">Add every LIFO pool or specific-goods grouping covered by this workpaper.</div>`}
    <div class="lifo-control-strip" aria-live="polite"><div><span>Non-LIFO ending Section 471 control</span><strong>${esc(moneyWp(c.end471))}</strong></div><div><span>Pool current-cost total</span><strong>${esc(moneyWp(totals.currentCostEnding471))}</strong></div><div><span>Opening additional Section 263A control</span><strong>${esc(moneyWp(inventoryModeValue("begadd")))}</strong></div><div><span>Pool opening additional Section 263A</span><strong>${esc(moneyWp(totals.beginningAdditional))}</strong></div><div><span>Status</span><strong>${issues.length ? "Action required" : "Entered controls passed"}</strong></div></div>`;
}

function sumInput(id){
  return state.rows.reduce((sum,row) => row.confirmed === true && row.inputId === id ? sum + mapped(row) : sum, 0);
}

function calc(){
  readControls();
  applyInventoryRecommendations();

  const indirectCostRule = ["applies","doesNotApply","notDetermined"].includes(state.indirectCostRule) ? state.indirectCostRule : "";
  const indirectCostRuleApplies = indirectCostRule === "applies";

  const begRaw = state.activityType === "reseller" ? 0 : inventoryModeValue("begraw");
  const begResale = inventoryModeValue("begresale");
  const begProd = state.activityType === "reseller" ? 0 : inventoryModeValue("begprod");
  const begAdd = state.activityType === "reseller" && !lifoActive() ? 0 : inventoryModeValue("begadd");
  const begPre471 = begRaw + begResale;
  const beg471 = begPre471 + begProd;
  const begTotal = beg471 + begAdd;

  const cyRaw = sumInput("raw");
  const cyResale = sumInput("resale");
  const cyPre471 = cyRaw + cyResale;
  const cyProd471 = sumInput("prod471");
  const cy471 = cyPre471 + cyProd471;

  const ppDirect = sumInput("preadd");
  const prodDirect = sumInput("prodadd");
  const fsaPreAdjustment = financialStatementAlternativeActive() ? fsaPreProductionAdjustment() : 0;
  const fsaProdAdjustment = financialStatementAlternativeActive() ? fsaProductionAdjustment() : 0;

  const decimals = Math.max(0, Math.min(8, parseNum(state.rounding)));
  const displayRatio = value => value;

  const mixedServicePool = sumInput("mixedservice");
  applyAutomaticBaseClassifications();
  const mixedServiceMethod = MIXED_METHODS[state.mixedServiceMethod] ? state.mixedServiceMethod : "";
  const mixedCalculationMethod = isSimplifiedMixedMethod(mixedServiceMethod) ? mixedServiceMethod : (!mixedServiceMethod ? "production" : "");
  const derivedBases = secondaryBaseRollup();
  const mixedSec263ALabor = derivedBases.mixedSec263ALabor;
  const mixedTotalLabor = derivedBases.mixedTotalLabor;
  const mixedSec263AProductionCosts = derivedBases.mixedSec263AProductionCosts;
  const mixedTotalCosts = derivedBases.mixedTotalCosts;
  const mixedDetailedCapitalizable = parseAmount(state.mixedDetailedCapitalizable);
  const mixedDetailedPreProduction = parseAmount(state.mixedDetailedPreProduction);
  const mixedMspmSplitMethod = ["labor","materials"].includes(state.mixedMspmSplitMethod) ? state.mixedMspmSplitMethod : "";
  const mixedCalculationSplitMethod = mixedMspmSplitMethod || "materials";
  const mixedMspmNinetyElection = ["none","apply"].includes(state.mixedMspmNinetyElection) ? state.mixedMspmNinetyElection : "none";
  const mixedPreProductionLabor = derivedBases.mixedPreProductionLabor;

  // Keep every ratio at full precision for multiplication and threshold tests.
  // Rounded ratios below are display-only values.
  const mixedLaborRatioRaw = !isZeroMoney(mixedTotalLabor) ? mixedSec263ALabor / mixedTotalLabor : 0;
  const mixedLaborRatioExact = clamp01(mixedLaborRatioRaw);
  const mixedLaborRatioCalc = displayRatio(mixedLaborRatioExact);
  const mixedLaborCapitalizable = wholeDollar(mixedServicePool * mixedLaborRatioExact);

  const mixedProductionCostRatioRaw = !isZeroMoney(mixedTotalCosts) ? mixedSec263AProductionCosts / mixedTotalCosts : 0;
  const mixedProductionCostRatioExact = clamp01(mixedProductionCostRatioRaw);
  const mixedProductionCostRatioCalc = displayRatio(mixedProductionCostRatioExact);
  const mixedProductionCostCapitalizable = wholeDollar(mixedServicePool * mixedProductionCostRatioExact);

  let mixedCapitalizable;
  if(mixedCalculationMethod === "labor") mixedCapitalizable = mixedLaborCapitalizable;
  else if(mixedCalculationMethod === "production") mixedCapitalizable = mixedProductionCostCapitalizable;
  else mixedCapitalizable = 0;

  const mixedCapitalizableRatioRaw = !isZeroMoney(mixedServicePool) ? mixedCapitalizable / mixedServicePool : 0;
  const mixedCapitalizableRatioExact = clamp01(mixedCapitalizableRatioRaw);
  const mixedCapitalizableRatioCalc = displayRatio(mixedCapitalizableRatioExact);
  const mixedDeductible = wholeDollar(mixedServicePool - mixedCapitalizable);

  let mixedPreProductionRatioRaw = 0;
  if(isDetailedMixedMethod(mixedServiceMethod)){
    mixedPreProductionRatioRaw = 0;
  } else if(mixedCalculationSplitMethod === "materials"){
    mixedPreProductionRatioRaw = !isZeroMoney(cy471) ? cyRaw / cy471 : 0;
  } else {
    mixedPreProductionRatioRaw = !isZeroMoney(mixedTotalLabor) ? mixedPreProductionLabor / mixedTotalLabor : 0;
  }

  const mixedPreProductionRatioIsValid = Number.isFinite(mixedPreProductionRatioRaw)
    && mixedPreProductionRatioRaw >= 0
    && mixedPreProductionRatioRaw <= 1;
  const mixedPreProductionRatioBaseExact = clamp01(mixedPreProductionRatioRaw);
  const mixedMspmNinetyEligible = state.methodRun !== "SPM"
    && mixedCapitalizable > 0
    && mixedPreProductionRatioIsValid
    && (mixedPreProductionRatioBaseExact >= 0.9 || mixedPreProductionRatioBaseExact <= 0.1);
  const mixedMspmNinetyRequested = state.methodRun !== "SPM" && mixedMspmNinetyElection === "apply";
  const mixedMspmNinetyApplied = mixedMspmNinetyRequested && mixedMspmNinetyEligible;
  const mixedMspmNinetyCategory = mixedMspmNinetyEligible
    ? (mixedPreProductionRatioBaseExact >= 0.9 ? "pre-production" : "production")
    : "";
  const mixedPreProductionRatioExact = mixedMspmNinetyApplied
    ? (mixedMspmNinetyCategory === "pre-production" ? 1 : 0)
    : mixedPreProductionRatioBaseExact;
  const mixedPreProductionRatioCalc = displayRatio(mixedPreProductionRatioExact);
  const mixedPreProductionRatioBaseCalc = displayRatio(mixedPreProductionRatioBaseExact);
  const mixedPre = state.methodRun === "SPM" ? 0 : wholeDollar(mixedCapitalizable * mixedPreProductionRatioExact);
  const mixedProd = wholeDollar(mixedCapitalizable - mixedPre);

  const preAdd = ppDirect + fsaPreAdjustment + mixedPre;
  const prodAdd = prodDirect + fsaProdAdjustment + mixedProd;
  const currentYearTotal = cy471 + preAdd + prodAdd;
  const add263A = preAdd + prodAdd;

  const totalEndRaw = state.activityType === "reseller" ? 0 : inventoryModeValue("endraw");
  const currentYearEndRaw = lifoActive() ? Math.max(totalEndRaw,0) : Math.min(Math.max(cyRaw,0),Math.max(totalEndRaw,0));
  const endRaw = totalEndRaw;
  const endResale = inventoryModeValue("endresale");
  const endProd = state.activityType === "reseller" ? 0 : inventoryModeValue("endprod");
  const endPre471 = currentYearEndRaw + endResale;
  const end471 = endPre471 + endProd;

  const spmRatioRaw = !isZeroMoney(cy471) ? add263A / cy471 : 0;
  const spmRatioCalc = displayRatio(spmRatioRaw);
  const spmBase = needsMspmDetail() ? end471 : inventoryModeValue("spmend471");
  const spmComputedCap = wholeDollar(spmRatioRaw * spmBase);
  const spmCap = indirectCostRuleApplies ? 0 : spmComputedCap;
  const spmEffectiveRatioRaw = !isZeroMoney(spmBase) ? spmCap / spmBase : 0;
  const spmEffectiveRatioCalc = displayRatio(spmEffectiveRatioRaw);
  const spmEnding = wholeDollar(spmBase + spmCap);
  const spmCogs = wholeDollar(add263A - spmCap);

  const preRatioRaw = !isZeroMoney(cyPre471) ? preAdd / cyPre471 : 0;
  const preRatioCalc = displayRatio(preRatioRaw);
  const preCap = wholeDollar(preRatioRaw * endPre471);
  const residualPreAdd = wholeDollar(preAdd - preCap);
  const directMaterialsAdjustment = wholeDollar(begRaw + cyRaw - totalEndRaw);
  const prodDenominator = cyProd471 + directMaterialsAdjustment;
  const prodRatioRaw = !isZeroMoney(prodDenominator) ? (prodAdd + residualPreAdd) / prodDenominator : 0;
  const prodRatioCalc = displayRatio(prodRatioRaw);
  const prodCap = wholeDollar(prodRatioRaw * endProd);
  const mspmComputedCap = wholeDollar(preCap + prodCap);
  const mspmCap = indirectCostRuleApplies ? 0 : mspmComputedCap;
  const combinedRatioRaw = !isZeroMoney(end471) ? mspmCap / end471 : 0;
  const combinedRatioCalc = displayRatio(combinedRatioRaw);
  const mspmBase = end471;
  const mspmEnding = wholeDollar(mspmBase + mspmCap);
  const mspmCogs = wholeDollar(add263A - mspmCap);

  const srmPurchasingDirect = sumInput("srmpurchasing");
  const srmStorageHandlingDirect = sumInput("srmstoragehandling");
  const srmMixedPurchasing = 0;
  const srmMixedStorageHandling = 0;
  const srmPurchasingCosts = wholeDollar(srmPurchasingDirect + srmMixedPurchasing);
  const srmStorageHandlingCosts = wholeDollar(srmStorageHandlingDirect + srmMixedStorageHandling);
  const srmPurchasingRatio = !isZeroMoney(cyResale) ? srmPurchasingCosts / cyResale : 0;
  const srmStorageHandlingDenominator = begResale + cyResale;
  const srmStorageHandlingRatio = !isZeroMoney(srmStorageHandlingDenominator) ? srmStorageHandlingCosts / srmStorageHandlingDenominator : 0;
  const srmActualCombinedRatio = srmPurchasingRatio + srmStorageHandlingRatio;
  const srmAppliedRatio = state.srmRatioMode === "historic" ? srmHistoricRatioValue() : srmActualCombinedRatio;
  const srmBase = endResale;
  const srmCap = wholeDollar((Number.isFinite(srmAppliedRatio) ? srmAppliedRatio : 0) * srmBase);
  const srmEnding = wholeDollar(srmBase + srmCap);
  const srmCurrentAdditional = wholeDollar(srmPurchasingCosts + srmStorageHandlingCosts);
  const srmCogs = wholeDollar(srmCurrentAdditional - srmCap);

  const result = {
    indirectCostRule,indirectCostRuleApplies,
    begRaw,begResale,begProd,begAdd,begPre471,beg471,begTotal,
    cyRaw,cyResale,cyPre471,cyProd471,cy471,
    ppDirect,prodDirect,fsaPreAdjustment,fsaProdAdjustment,bookPre:fsaPreAdjustment,bookProd:fsaProdAdjustment,
    mixedServicePool,mixedServiceMethod,mixedCalculationMethod,mixedSec263ALabor,mixedTotalLabor,mixedPreProductionLabor,
    mixedSec263AProductionCosts,mixedTotalCosts,mixedDetailedCapitalizable,mixedDetailedPreProduction,
    mixedProductionLabor:derivedBases.mixedProductionLabor,mixedOtherLabor:derivedBases.mixedOtherLabor,
    mixedOtherCosts:derivedBases.mixedOtherCosts,baseMappingStats:derivedBases.baseMappingStats,
    mixedMspmSplitMethod,mixedCalculationSplitMethod,mixedMspmNinetyElection,
    mixedLaborRatioRaw,mixedLaborRatioExact,mixedLaborRatioCalc,mixedLaborCapitalizable,
    mixedProductionCostRatioRaw,mixedProductionCostRatioExact,mixedProductionCostRatioCalc,mixedProductionCostCapitalizable,
    mixedCapitalizableRatioRaw,mixedCapitalizableRatioExact,mixedCapitalizableRatioCalc,mixedCapitalizable,mixedDeductible,
    mixedPreProductionRatioRaw,mixedPreProductionRatioIsValid,mixedPreProductionRatioBaseExact,mixedPreProductionRatioBaseCalc,
    mixedPreProductionRatioExact,mixedPreProductionRatioCalc,mixedMspmNinetyEligible,mixedMspmNinetyRequested,
    mixedMspmNinetyApplied,mixedMspmNinetyCategory,mixedPre,mixedProd,
    preAdd,prodAdd,currentYearTotal,add263A,
    endRaw,totalEndRaw,currentYearEndRaw,endResale,endProd,endPre471,end471,spmAggregateEnd471:inventoryModeValue("spmend471"),
    spmRatioRaw,spmRatioCalc,spmEffectiveRatioRaw,spmEffectiveRatioCalc,spmBase,spmComputedCap,spmCap,spmEnding,spmCogs,
    preRatioRaw,preRatioCalc,preCap,residualPreAdd,directMaterialsAdjustment,prodDenominator,prodRatioRaw,prodRatioCalc,prodCap,
    combinedRatioRaw,combinedRatioCalc,mspmBase,mspmComputedCap,mspmCap,mspmEnding,mspmCogs,
    srmPurchasingDirect,srmStorageHandlingDirect,srmMixedPurchasing,srmMixedStorageHandling,srmPurchasingCosts,srmStorageHandlingCosts,
    srmPurchasingRatio,srmStorageHandlingDenominator,srmStorageHandlingRatio,srmActualCombinedRatio,srmAppliedRatio,srmBase,srmCap,srmEnding,srmCurrentAdditional,srmCogs,

    // Workpaper aliases used in the MSPM calculation detail.
    a:begRaw,
    b:begResale,
    c:begPre471,
    d:begProd,
    e:begAdd,
    f:begTotal,
    g:cyRaw,
    h:cyResale,
    i:cyPre471,
    j:cyProd471,
    k:preAdd,
    l:prodAdd,
    m:currentYearTotal,
    n:totalEndRaw,
    o:endResale,
    p:endPre471,
    q:endProd,
    r:end471,
    u:preRatioCalc,
    v:preCap,
    w:residualPreAdd,
    x:directMaterialsAdjustment,
    y:prodRatioCalc,
    z:prodCap
  };
  result.lifo = lifoActive() ? lifoTotals(result) : null;
  result.finalSpmBase = lifoActive() ? result.lifo.ending471 : result.spmBase;
  result.finalSpmCap = lifoActive() ? result.lifo.spmEndingAdditional : result.spmCap;
  result.finalSpmEnding = lifoActive() ? result.lifo.spmEndingTax : result.spmEnding;
  result.finalSpmCogs = lifoActive() ? result.lifo.spmAdditionalToCogs : result.spmCogs;
  result.finalSpmRate = lifoActive() ? result.lifo.spmRatio : result.spmEffectiveRatioRaw;
  result.finalSpmCurrentAdjustment = lifoActive() ? result.lifo.spmCurrentAdjustment : result.spmCap;
  result.finalMspmBase = lifoActive() ? result.lifo.ending471 : result.mspmBase;
  result.finalMspmCap = lifoActive() ? result.lifo.mspmEndingAdditional : result.mspmCap;
  result.finalMspmEnding = lifoActive() ? result.lifo.mspmEndingTax : result.mspmEnding;
  result.finalMspmCogs = lifoActive() ? result.lifo.mspmAdditionalToCogs : result.mspmCogs;
  result.finalMspmRate = lifoActive() ? result.lifo.mspmRatio : result.combinedRatioRaw;
  result.finalMspmCurrentAdjustment = lifoActive() ? result.lifo.mspmCurrentAdjustment : result.mspmCap;
  if(lifoActive() && result.lifo){
    result.finalSrmBase = result.lifo.increment471;
    result.finalSrmCap = wholeDollar((Number.isFinite(result.srmAppliedRatio) ? result.srmAppliedRatio : 0) * result.lifo.increment471);
    result.finalSrmRelease = result.lifo.release263A;
    result.finalSrmEndingAdditional = wholeDollar(result.lifo.beginningAdditional + result.finalSrmCap - result.finalSrmRelease);
    result.finalSrmEnding = wholeDollar(result.lifo.ending471 + result.finalSrmEndingAdditional);
    result.finalSrmCurrentAdjustment = wholeDollar(result.finalSrmCap - result.finalSrmRelease);
    result.finalSrmCogs = wholeDollar(result.srmCurrentAdditional - result.finalSrmCap + result.finalSrmRelease);
  } else {
    result.finalSrmBase = result.srmBase;
    result.finalSrmCap = result.srmCap;
    result.finalSrmRelease = 0;
    result.finalSrmEndingAdditional = result.srmCap;
    result.finalSrmEnding = result.srmEnding;
    result.finalSrmCurrentAdjustment = result.srmCap;
    result.finalSrmCogs = result.srmCogs;
  }
  return result;
}


function jsString(value){
  const literal = "'" + String(value ?? "")
    .replace(/\\/g,"\\\\")
    .replace(/'/g,"\\'")
    .replace(/\r/g,"\\r")
    .replace(/\n/g,"\\n") + "'";
  return esc(literal);
}
function isSuspenseInputId(inputId){
  const opt = inputById[inputId];
  return opt && opt.group === "Breakout / Suspense";
}

function inputOptionIsAvailable(inputId){
  return !!inputById[inputId] && !LEGACY_FSA_INPUT_IDS.has(inputId);
}

function unavailableInputRows(){
  return state.rows.filter(row => row.confirmed === true && !inputOptionIsAvailable(row.inputId));
}

function breakoutEligibleOptions(){
  return inputOptions.filter(opt => opt.group !== "Breakout / Suspense" && !(needsMspmDetail() && opt.id === "spmend471") && inputOptionIsAvailable(opt.id));
}

function breakoutTemplateLines(row){
  return [{
    id:cryptoRandomId(),
    description:"",
    amount:"",
    taxAmount:"",
    suggestedInputId:"review",
    inputId:"review"
  }];
}

function ensureBreakoutLines(row){
  if(!row) return [];
  if(!Array.isArray(row.breakoutLines) || !row.breakoutLines.length){
    row.breakoutLines = breakoutTemplateLines(row);
  }
  return row.breakoutLines;
}

function findRowById(rowId){
  return state.rows.find(row => row.id === rowId);
}

function toggleBreakout(index){
  const row = state.rows[index];
  if(!row || !rowCanBeBrokenOut(row)) return;
  invalidateCalculationApprovals();
  ensureBreakoutLines(row);
  activeBreakoutId = activeBreakoutId === row.id ? null : row.id;
  renderAll();
}

function addBreakoutLine(rowId){
  const row = findRowById(rowId);
  if(!row) return;
  invalidateCalculationApprovals();
  ensureBreakoutLines(row).push({id:cryptoRandomId(), description:"", amount:"", taxAmount:"", suggestedInputId:"review", inputId:"review"});
  activeBreakoutId = row.id;
  renderAll();
}

function addStandardBreakoutLines(rowId){
  const row = findRowById(rowId);
  if(!row) return;
  invalidateCalculationApprovals();
  row.breakoutLines = breakoutTemplateLines(row);
  activeBreakoutId = row.id;
  renderAll();
}

function editBreakoutLine(rowId,lineIndex,field,value){
  const row = findRowById(rowId);
  if(!row || !Array.isArray(row.breakoutLines) || !row.breakoutLines[lineIndex]) return;
  invalidateCalculationApprovals();
  const line = row.breakoutLines[lineIndex];
  if(field === "amount" || field === "taxAmount"){
    const parsed = parseAmountResult(value);
    line[field] = parsed.ok ? parsed.value : value;
  } else {
    line[field] = value;
  }
  if(field === "description") line.suggestedInputId = classifySourceAccount("",value).inputId;
  renderAll();
}

function removeBreakoutLine(rowId,lineIndex){
  const row = findRowById(rowId);
  if(!row || !Array.isArray(row.breakoutLines)) return;
  invalidateCalculationApprovals();
  row.breakoutLines.splice(lineIndex,1);
  if(!row.breakoutLines.length) row.breakoutLines.push({id:cryptoRandomId(), description:"", amount:"", taxAmount:"", suggestedInputId:"review", inputId:"review"});
  activeBreakoutId = row.id;
  renderAll();
}

function breakoutTotal(row){
  return ensureBreakoutLines(row).reduce((sum,line) => sum + parseAmount(line.amount), 0);
}

function breakoutTaxTotal(row){
  return ensureBreakoutLines(row).reduce((sum,line) => sum + parseAmount(line.taxAmount), 0);
}

function breakoutParentTaxAmountResult(row){
  if(!row) return {ok:false,blank:true,value:0};
  const explicitFsaTax = parseAmountResult(row.fsaTaxAmount);
  if(explicitFsaTax.ok) return explicitFsaTax;
  const importedTax = parseAmountResult(row.sourceTaxAmount);
  if(importedTax.ok) return importedTax;
  const book = parseAmountResult(row.amount);
  const explicitAdjustment = parseAmountResult(row.taxAdjustment);
  if(book.ok && explicitAdjustment.ok) return {ok:true,blank:false,value:book.value + explicitAdjustment.value};
  if(!explicitFsaTax.blank) return explicitFsaTax;
  if(!importedTax.blank) return importedTax;
  return {ok:false,blank:true,value:0};
}

function breakoutParentBookAmountResult(row){
  if(!row) return {ok:false,blank:true,value:0};
  const importedBook = parseAmountResult(row.sourceBookAmount);
  if(importedBook.ok) return importedBook;
  return parseAmountResult(row.amount);
}

function breakoutOptionHtml(rowId,lineIndex,line){
  let html = `<select class="mapping-select" aria-label="Breakout UNICAP bucket" onchange="editBreakoutLine(${jsString(rowId)},${lineIndex},'inputId',this.value)">`;
  let currentGroup = "";
  breakoutEligibleOptions().forEach(opt => {
    if(opt.group !== currentGroup){
      if(currentGroup) html += `</optgroup>`;
      currentGroup = opt.group;
      html += `<optgroup label="${esc(inputGroupDisplayLabel(opt.group))}">`;
    }
    html += `<option value="${esc(opt.id)}" ${opt.id === line.inputId ? "selected" : ""}>${esc(bucketDisplayLabel(opt.id))}</option>`;
  });
  html += `</optgroup></select>`;
  return html;
}

