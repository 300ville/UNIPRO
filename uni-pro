function buildPrintSnapshot(c){
  const box = $("printSnapshot");
  const liveDetailBox = $("detailBox");
  if(!box || !liveDetailBox) return;

  const sourceBody = state.rows.map(row => {
    const unresolved = row.inputId === "review" || row.confirmed !== true || isSuspenseInputId(row.inputId)
      || rowNeedsMspmReview(row) || rowNeedsMspmBreakout(row) || rowNeedsTaxReconcileAdjustment(row) || rowNeedsFsaTaxAmount(row)
      || (rowRequiresOverlapConfirmation(row) && row.notIn471Confirmed !== true);
    return `<tr>
      <td>${esc(row.sourceImportId || "Manual")} / ${esc(row.sourceLineNumber ?? "Manual")}</td>
      <td>${esc(row.originalAccount ?? row.account)}</td>
      <td>${esc(row.originalDescription ?? row.description)}</td>
      <td class="num">${esc(moneyWp(parseAmount(row.originalAmount ?? row.amount)))}</td>
      <td>${esc(row.account)}</td>
      <td>${esc(row.description)}</td>
      <td class="num">${esc(moneyWp(mapped(row)))}</td>
      <td>${esc(bucketDisplayLabel(inputById[row.suggestedInputId] ? row.suggestedInputId : "review"))}</td>
      <td>${esc(rowBucket(row))}</td>
      <td>${esc([row.sourceGroup ? `Group ${row.sourceGroup}` : "",row.sourceSubgroup ? `Subgroup ${row.sourceSubgroup}` : "",row.notes || ""].filter(Boolean).join(" | "))}</td>
      <td>${unresolved ? "Action required" : "Confirmed"}</td>
    </tr>`;
  }).join("");

  const priorDetail = state.detail;
  const priorDetailHtml = liveDetailBox.innerHTML;
  const detailLabels = {spm:"Simplified Production Method Calculation",mspm:"Modified Simplified Production Method Calculation",lifo:"LIFO Integration",sources:"Source Rows",definitions:"Definitions"};
  const supportBlocks = [];
  allowedDetailsForScope().forEach(detail => {
    state.detail = detail;
    renderDetail(c);
    supportBlocks.push(`<section class="print-support-section"><h2>${esc(detailLabels[detail] || detail)}</h2>${liveDetailBox.innerHTML}</section>`);
  });
  state.detail = priorDetail;
  liveDetailBox.innerHTML = priorDetailHtml;

  box.innerHTML = `<section class="card print-source-ledger">
    <div class="card-head"><h2>Complete Source Account Ledger</h2></div>
    <div class="card-body"><p class="small-note">All ${esc(state.rows.length)} current source row(s), independent of the on-screen filter and page.</p>
      <div class="table-wrap"><table><thead><tr><th>Batch / line</th><th>Original account</th><th>Original description</th><th class="num">Original amount</th><th>Current account</th><th>Current description</th><th class="num">Calculation amount</th><th>Suggestion</th><th>User treatment</th><th>Reviewer note</th><th>Status</th></tr></thead><tbody>${sourceBody || `<tr><td colspan="11">No source rows.</td></tr>`}</tbody></table></div>
    </div></section>
    <section class="card print-all-support"><div class="card-head"><h2>Complete Formula and Source Support</h2></div><div class="card-body">${supportBlocks.join("")}</div></section>`;
