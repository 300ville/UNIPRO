  if(!physical.length) return {rows:[],rejected:[],ignored:[],hasHeader:false,net:0,absolute:0,duplicateGroups:0,amountColumnLabel:"Not detected",amountCandidates:[],selectedAmountColumnKey:"",needsAmountSelection:false,sourceFormat:"Empty",structured:false};
  const firstParts = splitPasteLine(physical[0].text);
  const headers = firstParts.map(normalizeHeader);
  const accountIndex = findHeader(headers,["account number","gl account","account","account code"]);
  const descriptionIndex = findHeader(headers,["account description","account name","description","name"]);
  const taxAmountIndex = findScopedHeader(headers,["federal tax total","tax total","federal tax amount","tax amount","tax-adjusted amount","tax adjusted amount"],["book"]);
  const bookAmountIndex = findScopedHeader(headers,["book total","book amount","book balance","financial statement amount","financial statement total","trial balance amount","tb amount"],["tax"]);
  const genericAmountIndex = findExactHeader(headers,["source amount","client amount","amount","value"]);
  const amountIndex = state.amountBasis === "book" ? bookAmountIndex : taxAmountIndex;
  const detectedIndices = [accountIndex,descriptionIndex,amountIndex];
  const hasHeader = detectedIndices.every(index => index >= 0) && new Set(detectedIndices).size === 3;
  const malformedHeader = !hasHeader && detectedIndices.filter(index => index >= 0).length >= 2;
  if(malformedHeader){
    const expectedAmount = state.amountBasis === "book" ? "an explicit Book Total, Book Amount, or Financial Statement Amount" : "an explicit Federal Tax Total, Tax Total, or Tax Amount";
    return {
      rows:[],
      rejected:[{line:physical[0].line,reason:`Header row must contain three distinct required fields: Account Number, Account Name, and ${expectedAmount}.`,text:physical[0].text}],
      hasHeader:false,
      headerError:true,
      net:0,
      absolute:0,
      duplicateGroups:0,
      amountColumnLabel:"Not detected",
      ignored:[],amountCandidates:[],selectedAmountColumnKey:"",needsAmountSelection:false,sourceFormat:"Mapped columns",structured:false
    };
  }
  if(!hasHeader){
    const expected = state.amountBasis === "book" ? "an explicit Book amount header" : "an explicit Federal tax amount header";
    return {rows:[],rejected:[{line:physical[0].line,reason:`This source requires Account Number, Account Name, and ${expected}.`,text:physical[0].text}],ignored:[],hasHeader:false,headerError:true,net:0,absolute:0,duplicateGroups:0,amountColumnLabel:"Not detected",amountCandidates:[],selectedAmountColumnKey:"",needsAmountSelection:false,taxAmountCandidates:[],selectedTaxAmountColumnKey:"",needsTaxAmountSelection:false,sourceFormat:"Unmapped source",structured:false};
  }
  const indices = hasHeader ? {accountIndex,descriptionIndex,amountIndex} : {accountIndex:0,descriptionIndex:1,amountIndex:2};
  const rows = [];
  const rejected = [];
  physical.slice(hasHeader ? 1 : 0).forEach(item => {
    const parts = splitPasteLine(item.text);
    const requiredMax = Math.max(indices.accountIndex,indices.descriptionIndex,indices.amountIndex);
    if(parts.length <= requiredMax){ rejected.push({line:item.line,reason:"Missing one or more required columns.",text:item.text}); return; }
    const account = String(parts[indices.accountIndex] || "").trim();
    const description = String(parts[indices.descriptionIndex] || "").trim();
    const amountText = String(parts[indices.amountIndex] || "").trim();
    if(!account && !description){ rejected.push({line:item.line,reason:"Account number and account name are both blank.",text:item.text}); return; }
    const parsed = parseAmountResult(amountText);
    if(!parsed.ok){ rejected.push({line:item.line,reason:parsed.blank ? "Source amount is blank." : `Source amount '${amountText}' is not valid.`,text:item.text}); return; }
    const row = newRow(account,description,amountText,100,true,"","","");
    row.sourceLineNumber = item.line;
    row.sourceAmountHeader = hasHeader ? String(firstParts[indices.amountIndex] || "Source Amount").trim() : "Positional column 3";
    row.sourceAmountBasis = state.amountBasis;
    row.sourceFormat = hasHeader ? "Mapped columns" : "Positional three-column";
    if(hasHeader && bookAmountIndex >= 0){
      row.sourceBookHeader = String(firstParts[bookAmountIndex] || "Book Amount").trim();
      const rawBook = String(parts[bookAmountIndex] || "").trim();
