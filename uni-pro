function applyBreakout(index){
  const row = state.rows[index];
  if(!row || !rowCanBeBrokenOut(row)) return;
  const lines = ensureBreakoutLines(row);
  const original = parseAmount(row.amount);
  const fsa = financialStatementAlternativeActive();
  const pairedTax = financialStatementAlternativeActive() && parseAmountResult(row.sourceTaxAmount).ok;
  const parentTaxResult = breakoutParentTaxAmountResult(row);
  if(pairedTax && !parentTaxResult.ok){
    alert("Enter a valid federal tax amount for the summarized parent row before breaking it out.");
    return;
  }
  const activeLines = lines.filter(line => parseAmount(line.amount) !== 0 || (pairedTax && parseAmount(line.taxAmount) !== 0));

  if(!activeLines.length){
    alert("Enter at least one breakout line amount before applying the breakout.");
    return;
  }

  const total = activeLines.reduce((sum,line) => sum + parseAmount(line.amount), 0);
  if(Math.abs(original - total) > 1e-8){
    alert("The breakout total must equal the original source amount before replacing the suspense row. Difference: " + moneyWp(original - total));
    return;
  }
  if(pairedTax){
    const invalidTaxLine = activeLines.find(line => !parseAmountResult(line.taxAmount).ok);
    if(invalidTaxLine){
      alert("Each breakout line needs a valid Federal tax amount. Enter 0 when the tax amount is zero.");
      return;
    }
    const taxTotal = activeLines.reduce((sum,line) => sum + parseAmount(line.taxAmount),0);
    if(Math.abs(parentTaxResult.value - taxTotal) > 1e-8){
      alert("The federal tax breakout total must equal the parent federal tax amount. Difference: " + moneyWp(parentTaxResult.value - taxTotal));
      return;
    }
  }

  const missingDescription = activeLines.find(line => !String(line.description || "").trim());
  if(missingDescription){
    alert("Each nonzero breakout line needs a description.");
    return;
  }

  const invalidBucket = activeLines.find(line => !inputById[line.inputId] || line.inputId === "review" || isSuspenseInputId(line.inputId) || !inputOptionIsAvailable(line.inputId) || (needsMspmDetail() && line.inputId === "spmend471"));
  if(invalidBucket){
    alert("Each nonzero breakout line must be mapped to a non-suspense calculation or exclusion bucket.");
    return;
  }

  const sourceLabel = [row.account, row.description].filter(Boolean).join(" - ");
  const replacementRows = activeLines.map(line => syncBaseSuggestions({
      id:cryptoRandomId(),
      account:row.account || "",
      description:String(line.description || "").trim(),
      originalAccount:row.originalAccount ?? row.account ?? "",
      originalDescription:row.originalDescription ?? row.description ?? "",
      originalAmount:parseAmount(line.amount),
      sourceLineNumber:row.sourceLineNumber ?? null,
      sourceImportId:row.sourceImportId ?? "",
      sourceAmountHeader:row.sourceAmountHeader ?? "",
      sourceBookHeader:fsa ? (row.sourceBookHeader || row.sourceAmountHeader || "Breakout Book amount") : (row.sourceBookHeader ?? ""),
      sourceTaxHeader:pairedTax ? (row.sourceTaxHeader || "Breakout Federal tax amount") : (row.sourceTaxHeader ?? ""),
      sourceBookAmount:fsa ? parseAmount(line.amount) : "",
      sourceTaxAmount:pairedTax ? parseAmount(line.taxAmount) : "",
      sourceKind:"breakoutChild",
      fsaBookEqualsTax:"",
      manualSupplementReference:"",
      sourceAmountBasis:row.sourceAmountBasis ?? "",
      sourceGroup:row.sourceGroup ?? "",
      sourceSubgroup:row.sourceSubgroup ?? "",
      sourceFormat:row.sourceFormat ?? "",
      parentSourceId:row.id,
      taxAdjustment:"",
      fsaTaxAmount:pairedTax ? parseAmount(line.taxAmount) : "",
      fsaNegativeAdjustmentConfirmed:false,
      fsaAdditionalCostType:"",
      fsaSpecialRuleReference:"",
      period:row.period ?? "",
      amount:parseAmount(line.amount),
      usePct:100,
      inputId:line.inputId,
      bucket:"",
      confidence:"Manual",
      suggestionReason:"Breakout line classification was entered manually.",
      reason:`Created from breakout of summarized account ${sourceLabel || row.id}.`,
      confirmed:true,
      suggestedInputId:inputById[line.suggestedInputId] ? line.suggestedInputId : "review",
      review:line.inputId === "review",
      parseOk:true,
      parseWarning:"",
      notes:`Breakout from ${sourceLabel || "summarized account"}; original book/source amount ${moneyWp(original)}${pairedTax ? `; federal tax amount ${moneyWp(parseAmount(line.taxAmount))}` : ""}.`,
      notIn471Confirmed:false,
      mspmConfirmed:needsMspmDetail() && MSPM_REVIEW_INPUT_IDS.has(line.inputId),
      suggestedLaborTreatment:"review",
      laborTreatment:"review",
      laborConfirmed:false,
      suggestedCostTreatment:"review",
      costTreatment:"review",
      costConfirmed:false
    },true));

  invalidateCalculationApprovals();
  clearBookTaxMethodConfirmation();
  if(!Array.isArray(state.sourceParents)) state.sourceParents = [];
  state.sourceParents.push({...JSON.parse(JSON.stringify(row)),breakoutAppliedAt:new Date().toISOString(),breakoutChildIds:replacementRows.map(child => child.id)});
  state.rows.splice(index,1,...replacementRows);
  activeBreakoutId = null;
  renderAll();
}

function rowNeedsConfirmation(row){
  return row.inputId !== "review" && row.confirmed !== true;
}

function viewMatches(row){
  const opt = inputOption(row);
  if(state.view === "all") return true;
  if(state.view === "review") return row.review || row.inputId === "review" || rowNeedsConfirmation(row) || row.parseOk === false || rowNeedsMspmReview(row) || rowNeedsMspmBreakout(row) || rowNeedsTaxReconcileAdjustment(row) || rowNeedsFsaTaxAmount(row) || !!fsaAdditionalCostCharacterizationIssue(row) || rowNeedsFsaNegativeConfirmation(row) || (rowRequiresOverlapConfirmation(row) && row.notIn471Confirmed !== true);
  if(state.view === "suspense") return opt.group === "Breakout / Suspense";
  if(state.view === "mixed") return opt.group === "Mixed Service Costs";
  if(state.view === "materials") return opt.group === "Materials or goods";
  if(state.view === "handling") return opt.group === "Making or handling inventory";
  if(state.view === "inventory") return opt.group === "Inventory balances";
  if(state.view === "excluded") return opt.group === "Excluded costs";
  return true;
}

function filteredRows(){
  const query = normalizeClassificationText(state.mappingSearch || "");
  return state.rows.filter(row => {
    if(!viewMatches(row)) return false;
    if(focusedExceptionRowIds && !focusedExceptionRowIds.has(row.id)) return false;
    if(!query) return true;
    return normalizeClassificationText([row.account,row.description,row.suggestionReason,row.reason,bucketDisplayLabel(row.inputId),bucketDisplayLabel(row.suggestedInputId)].join(" ")).includes(query);
  });
}

function visibleRows(){
  const rows = filteredRows();
  const size = Math.max(25,Math.min(250,Number(state.mappingPageSize || 100)));
  const pages = Math.max(1,Math.ceil(rows.length / size));
  state.mappingPage = Math.max(0,Math.min(pages - 1,Number(state.mappingPage || 0)));
  return rows.slice(state.mappingPage * size,(state.mappingPage + 1) * size);
}

function renderMappingPagination(){
  const box = $("mappingPagination");
  if(!box) return;
  const total = filteredRows().length;
  const size = Math.max(25,Math.min(250,Number(state.mappingPageSize || 100)));
  const pages = Math.max(1,Math.ceil(total / size));
  const page = Math.max(0,Math.min(pages - 1,Number(state.mappingPage || 0)));
  const start = total ? page * size + 1 : 0;
  const end = Math.min(total,(page + 1) * size);
  box.innerHTML = `<span>Showing ${start}-${end} of ${total}</span><div class="row-tools"><button class="ghost" type="button" onclick="changeMappingPage(-1)" ${page <= 0 ? "disabled" : ""}>Previous</button><button class="ghost" type="button" onclick="changeMappingPage(1)" ${page >= pages - 1 ? "disabled" : ""}>Next</button></div>`;
}

function changeMappingPage(direction){
  state.mappingPage = Math.max(0,Number(state.mappingPage || 0) + Number(direction || 0));
  renderRows();
  const table = document.querySelector(".source-map-wrap");
  if(table) table.scrollIntoView({behavior:"smooth",block:"start"});
}

function setMappingSearch(value){
  state.mappingSearch = String(value || "");
  state.mappingPage = 0;
  renderRows();
}

function setMappingDisplay(value){
  focusedExceptionRowIds = null;
  setActiveMappingView(value);
  renderAll();
}

