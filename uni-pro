function renderRows(){
  hideDefinitionTooltip();
  const body = $("rowsBody");
  const display = $("mappingDisplay");
  if(display && display.value !== state.view) display.value = labelView(state.view) === "All rows" ? "all" : state.view;
  const amountHeading = $("sourceAmountColumnHeading");
  if(amountHeading) amountHeading.textContent = state.amountBasis === "book" ? "Book / Federal tax" : "Federal tax amount";
  const rows = visibleRows();
  const batchButton = $("confirmBookEqualsTaxShown");
  if(batchButton){
    const count = financialStatementAlternativeActive() ? rows.filter(row => fsaRowApplies(row) && parseAmountResult(row.sourceTaxAmount).blank && !row.fsaBookEqualsTax).length : 0;
    batchButton.classList.toggle("hidden",count === 0);
    batchButton.textContent = count ? `Confirm Book = tax for ${count} unanswered shown` : "Confirm Book equals tax for unanswered rows shown";
  }
  renderMappingPagination();
  if(!rows.length){
    body.innerHTML = `<tr><td colspan="6"><div class="note">No rows in this view.</div></td></tr>`;
    return;
  }

  body.innerHTML = rows.map(row => {
    const index = state.rows.indexOf(row);
    const isSuspense = isSuspenseInputId(row.inputId);
    const needsBucket = row.inputId === "review";
    const needsConfirm = rowNeedsConfirmation(row);
    const needsMspmReview = rowNeedsMspmReview(row);
    const needsMspmBreakout = rowNeedsMspmBreakout(row);
    const needsTaxReconcile = rowNeedsTaxReconcileAdjustment(row);
    const needsFsaTax = rowNeedsFsaTaxAmount(row);
    const needsFsaNegative = rowNeedsFsaNegativeConfirmation(row);
    const status = row.parseOk === false
      ? `<span class="pill bad">Import issue</span>`
      : needsBucket
        ? `<span class="pill bad">Needs category</span>`
        : needsConfirm
          ? `<span class="pill warn">Needs choice</span>`
          : needsMspmBreakout
            ? `<span class="pill bad">MSPM breakout required</span>`
          : needsTaxReconcile
            ? `<span class="pill bad">Federal tax amount required</span>`
          : needsFsaTax
            ? `<span class="pill bad">${fsaTaxAmountResult(row).source === "unanswered" ? "Book / tax answer required" : "Federal tax support required"}</span>`
          : needsFsaNegative
            ? `<span class="pill bad">Negative adjustment check required</span>`
          : needsMspmReview
            ? `<span class="pill warn">Confirm for MSPM</span>`
          : isSuspense
            ? `<span class="pill warn">Needs split</span>`
            : "";
    const remediationDetail = needsMspmBreakout
      ? `<div class="small-note">This aggregate SPM ending amount cannot drive MSPM. Split it among total ending raw materials, current-year ending resale property, and current-year ending production Section 471 costs.</div>`
      : needsMspmReview
        ? `<div class="small-note">Reconfirm this dropdown for the MSPM pre-production/production treatment. Change it when the SPM selection was only an aggregate or provisional classification.</div>`
        : "";
    const parseDetail = row.parseOk === false && row.parseWarning ? `<div class="small-note">${esc(row.parseWarning)}</div>` : "";
    const statusHtml = status || parseDetail || remediationDetail ? `<div class="small-note">${status}${parseDetail}${remediationDetail}</div>` : "";
    const breakoutLink = rowCanBeBrokenOut(row) ? `<a href="#" class="row-action-link" onclick="event.preventDefault();toggleBreakout(${index})">${activeBreakoutId === row.id ? "Close" : (needsMspmBreakout ? "Break out for MSPM" : "Break out")}</a>` : "";
    const acceptLink = suggestionCanBeAccepted(row) && (row.inputId === "review" || row.confirmed !== true) ? `<a href="#" class="row-action-link" onclick="event.preventDefault();acceptSuggestedClassification(${index})">Accept suggestion</a>` : "";
    const rowRemovalLink = row.sourceLineNumber == null && !row.originalAccount && !row.originalDescription && !row.parentSourceId
      ? `<a href="#" class="row-action-link" onclick="event.preventDefault();removeRow(${index})">Remove draft</a>`
      : `<a href="#" class="row-action-link" onclick="event.preventDefault();excludeRow(${index})">Exclude</a>`;
    const confirmMspmLink = needsMspmReview ? `<a href="#" class="row-action-link" onclick="event.preventDefault();confirmRowForMspm(${index})">Confirm for MSPM</a>` : "";
    const rowClass = needsMspmBreakout ? "mspm-breakout-row" : needsMspmReview ? "mspm-review-row" : "";
    const mainRow = `<tr class="${rowClass}">
      <td><input class="account-number-input" aria-label="Account number" value="${esc(row.account)}" oninput="editRowTextLive(${index},'account',this.value)" onblur="editRow(${index},'account',this.value)"></td>
      <td class="source-description"><div class="editable-text account-name-box" contenteditable="true" oninput="editRowTextLive(${index},'description',this.textContent)" onblur="editRow(${index},'description',this.textContent)">${esc(row.description)}</div></td>
      <td class="num"><input class="value-input currency-input" aria-label="${state.amountBasis === "book" ? "Book amount" : "Federal tax amount"}" type="text" inputmode="decimal" value="${esc(currencyInputValue(row.amount))}" onfocus="focusCurrencyInput(this)" oninput="editRow(${index},'amount',this.value)" onblur="blurCurrencyInput(${index},this)">${financialStatementAlternativeActive() ? fsaBookTaxInlineHtml(row) : ""}</td>
      <td class="source-bucket">${suggestedInputHtml(row)}</td>
      <td class="source-bucket">${selectInputHtml(row,index)}${statusHtml}</td>
      <td class="no-print"><div class="row-action-links"><a href="#" class="row-action-link" data-inspect-row-id="${esc(row.id)}" onclick="event.preventDefault();openAccountInspector(${jsString(row.id)})">Inspect</a>${definitionLinkHtml(row)}${acceptLink}${confirmMspmLink}${breakoutLink}${rowRemovalLink}</div></td>
    </tr>`;
    return mainRow + (activeBreakoutId === row.id && rowCanBeBrokenOut(row) ? breakoutPanelHtml(row,index) : "");
  }).join("");
}

function baseTreatmentLocked(row){
  if(!row) return true;
  const option = inputById[row.inputId];
  return row.inputId === "review" || (option && option.group === "Breakout / Suspense");
}

function baseTreatmentSelectHtml(row,kind){
  const allOptions = kind === "labor" ? LABOR_BASE_OPTIONS : COST_BASE_OPTIONS;
  const options = row.inputId === "mixedservice"
    ? allOptions.filter(option => option.id === "review" || option.id === (kind === "labor" ? "none" : "excluded"))
    : allOptions;
  const value = kind === "labor" ? row.laborTreatment : row.costTreatment;
  const locked = baseTreatmentLocked(row);
  const select = `<select aria-label="${kind === "labor" ? "Labor" : "Production-cost"} treatment for ${esc(row.description || row.account)}" onchange="editBaseTreatment(${jsString(row.id)},${jsString(kind)},this.value)" ${locked ? "disabled" : ""}>
    ${options.map(option => `<option value="${esc(option.id)}" ${option.id === value ? "selected" : ""}>${esc(option.label)}</option>`).join("")}
  </select>`;
  const confirmed = kind === "labor" ? row.laborConfirmed : row.costConfirmed;
  const status = value === "review"
      ? `<span class="pill bad">Review required</span>`
      : confirmed
        ? `<span class="pill ok">Assigned</span>`
        : `<span class="pill warn">Needs choice</span>`;
  return `${select}<div class="small-note">${status}</div>`;
}

function baseMappingTableHtml(kind,unresolvedOnly=false){
  const allRows = allocationBaseRows();
  const rows = (unresolvedOnly
    ? allRows.filter(row => kind === "labor" ? row.laborTreatment === "review" || row.laborConfirmed !== true : row.costTreatment === "review" || row.costConfirmed !== true)
    : allRows.slice()).sort((a,b) => {
      const unresolved = row => kind === "labor"
        ? row.laborTreatment === "review" || row.laborConfirmed !== true
        : row.costTreatment === "review" || row.costConfirmed !== true;
      return Number(unresolved(b)) - Number(unresolved(a));
    });
  const title = unresolvedOnly
    ? (kind === "labor" ? "Labor accounts that need a choice" : "Cost accounts that need a choice")
    : (kind === "labor" ? "Labor accounts in this ratio" : "Cost accounts in this ratio");
  if(!rows.length) return "";

  const body = rows.map(row => {
    const suggested = kind === "labor" ? row.suggestedLaborTreatment : row.suggestedCostTreatment;
    return `<tr>
      <td><div class="base-account-name">${esc([row.account,row.description].filter(Boolean).join(" | ") || "Unnamed row")}</div><div class="base-account-meta">Primary mapping: ${esc(rowBucket(row))}</div></td>
      <td class="num">${esc(moneyWp(mapped(row)))}</td>
      <td>${esc(baseTreatmentLabel(kind,suggested))}</td>
      <td>${baseTreatmentSelectHtml(row,kind)}</td>
    </tr>`;
  }).join("");

  const note = kind === "labor"
    ? "Choose whether each account is inventory-related labor, other labor, or not labor."
    : "Choose whether each account relates to inventory work, another business activity, or is outside this ratio.";
  return `<div class="base-map-block">
    <h4>${esc(title)}</h4>
    <div class="table-wrap">
      <table class="base-map-table">
        <colgroup><col class="base-account-col"><col class="base-amount-col"><col class="base-suggested-col"><col class="base-selection-col"></colgroup>
        <thead><tr><th>Account and primary mapping</th><th class="num">Amount</th><th>Suggested treatment</th><th>User selection</th></tr></thead>
        <tbody>${body}</tbody>
      </table>
    </div>
    <p class="method-note">${esc(note)}</p>
  </div>`;
}

