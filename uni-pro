function preparePrintState(showAlerts=false){
  const c = calc();
  invalidateStaleApprovals();
  const s = completionState(c);
  renderRedFlagOverride(s.redItems);
  if(showAlerts && s.step1Complete && s.step2Complete && s.step3MappingComplete && (s.requiredMissing.length || s.overlapMissing.length)){
    document.body.classList.remove("print-blocked");
    openRequiredInputModal();
    return false;
  }
  if(!s.workpaperReady){
    if($("printSnapshot")) $("printSnapshot").innerHTML = "";
    document.body.classList.add("print-blocked");
    const redBlocked = s.coreInputsReady && s.redItems.length > 0 && !s.overrideValid;
    const reason = s.calculationReady && !s.methodSelectionComplete
      ? "Choose the production method before printing."
      : s.calculationReady && !s.priorMethodProfileRecorded
      ? "Record the prior method before printing."
      : s.calculationReady && !s.methodTransitionComplete
      ? "Confirm the separate method-change support before printing."
      : redBlocked
      ? "Printing is blocked by one or more red flags."
      : "The calculation is not complete.";
    const detail = s.calculationReady && !s.methodSelectionComplete
      ? "Review the calculated result or results in Step 6, then select the method that applies to this tax year."
      : s.calculationReady && !s.priorMethodProfileRecorded
      ? "Record the last-year method for each changed component shown in Step 6."
      : s.calculationReady && !s.methodTransitionComplete
      ? "Confirm that the separate prior/proposed method, beginning-inventory, and Section 481(a) support is complete."
      : redBlocked
      ? "Resolve every red flag or use the explicit override and provide an explanation."
      : "Finish the required workpaper steps before printing.";
    setPrintBlocker(reason,detail);
    if(showAlerts) alert(reason + " " + detail);
    return false;
  }
  document.body.classList.remove("print-blocked");
  setPrintBlocker("Complete the required workpaper steps before printing.","");
  const namesComplete = [state.staffReviewName,state.managerReviewName,state.seniorManagerReviewName,state.partnerReviewName].every(name => !!String(name || "").trim());
  state.printForReviewDisclaimer = !(namesComplete && staffReviewIsCurrent() && managerReviewIsCurrent() && seniorManagerReviewIsCurrent() && partnerReviewIsCurrent());
  renderReviewSignoff();
  buildPrintSnapshot(c);
  return true;
}

function exportPdf(){
  if(!preparePrintState(true)) return;

  if(state.printForReviewDisclaimer){
    const ok = confirm("The final review signoffs are incomplete or do not match the current calculation. The printout will be marked DRAFT FOR REVIEW ONLY. Continue?");
    if(!ok){
      state.printForReviewDisclaimer = false;
      renderReviewSignoff();
      return;
    }
  }

  window.print();
}


