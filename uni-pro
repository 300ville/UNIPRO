<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>UNIPRO | Uniform Capitalization Calculator</title>
<style>
:root{
  --black:#0b1f33;
  --ink:#102033;
  --muted:#536579;
  --line:#d6e1ed;
  --paper:#fff;
  --off:#f5f8fc;
  --accent:#0f6b8f;
  --accent-soft:#eaf6fb;
  --green:#276749;
  --green-soft:#f0fff4;
  --red:#9b2c2c;
  --red-soft:#fff5f5;
  --blue:#0f6b8f;
  --blue-soft:#eaf6fb;
  --shadow:0 16px 38px rgba(11,31,51,.075);
  --serif:Garamond,"EB Garamond",Georgia,serif;
  --sans:Arial,Helvetica,sans-serif;
}
*{box-sizing:border-box}
body{margin:0;background:var(--paper);color:var(--ink);font-family:var(--serif);font-size:13px}
button{border:1px solid var(--black);border-radius:999px;background:var(--black);color:#fff;padding:8px 13px;font-family:var(--sans);font-size:12px;font-weight:700;cursor:pointer}
button:disabled{opacity:.45;cursor:not-allowed}
button.secondary{background:var(--paper);color:var(--black)}
button.primary{background:var(--accent);border-color:var(--accent);color:#fff}
button.ghost{background:var(--paper);color:var(--muted);border-color:var(--line)}
button.link{border:0;background:transparent;color:var(--muted);text-decoration:underline;padding:7px 0;border-radius:0;white-space:nowrap}
input,select,textarea{width:100%;border:1px solid var(--line);border-radius:8px;padding:8px 9px;background:var(--paper);color:var(--ink);font-family:var(--serif);font-size:14px;outline:none}
textarea{min-height:104px;resize:vertical;font-family:Consolas,Monaco,monospace;font-size:13px}
input:focus,select:focus,textarea:focus,button:focus{outline:2px solid rgba(15,107,143,.34);outline-offset:2px}
input[type=number]{appearance:textfield;-moz-appearance:textfield;text-align:right}
input[type=number]::-webkit-outer-spin-button,input[type=number]::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
label,.field-label{display:block;margin:12px 0 7px;font-family:var(--sans);font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:#2b2b2b}
.hidden{display:none!important}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}

header{display:none;padding:13px 22px 11px;border-bottom:3px solid var(--accent);background:linear-gradient(180deg,#ffffff 0%,var(--off) 100%);align-items:center;justify-content:space-between;gap:16px}
header.active{display:flex}
header h1{margin:0;font-size:23px;line-height:1.05;letter-spacing:.04em;color:var(--black)}
.subhead{margin:5px 0 0;color:var(--muted);font-size:13px}
.app-tools{display:flex;gap:8px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
.app-tools button{padding:7px 11px;font-size:11px}

.foyer{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:28px}
.foyer.hidden{display:none}
.foyer-card{width:min(860px,100%);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow);background:var(--paper);overflow:hidden;position:relative}
.acronym-top{position:absolute;top:14px;right:18px;font-family:var(--sans);font-size:9.5px;font-weight:700;letter-spacing:.045em;text-transform:uppercase;color:var(--muted);opacity:.8;white-space:nowrap;text-align:right}
.foyer-screen{padding:46px 48px;text-align:center}
.hello h2{margin:18px 0 0;font-size:38px;line-height:1.05;letter-spacing:.06em;color:var(--black)}
.nto-line{margin:6px 0 0;font-family:var(--sans);font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.foyer-options{display:flex;justify-content:center;align-items:center;gap:14px;margin-top:28px;font-family:var(--sans);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em}
.foyer-link{border:0;border-radius:0;background:transparent;color:var(--black);padding:0;font-family:var(--sans);font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em}
.foyer-divider{width:1px;height:18px;background:var(--line)}
.how-to-row{margin-top:28px;padding-top:14px;border-top:1px solid var(--line)}
.how-to-row button{font-size:11px;padding:8px 13px}
.copy{margin:0 auto;max-width:720px;text-align:left;border-top:3px solid var(--accent);padding-top:18px}
.copy h3{margin:0 0 8px;font-size:23px}
.copy p{margin:0 0 10px;color:var(--muted);font-size:14px;line-height:1.43}
.bottom{display:flex;justify-content:space-between;gap:18px;align-items:center;margin-top:18px;padding-top:16px;border-top:1px solid var(--line)}

main{display:none;padding:26px 48px 34px;max-width:1560px;margin:0 auto}
main.active{display:block}
.card{background:var(--paper);border:1px solid var(--line);border-radius:10px;box-shadow:var(--shadow);margin-bottom:16px}
.card-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:14px 16px;border-bottom:1px solid var(--line)}
.card-head h2{margin:0;font-size:18px}
.card-title-status{display:flex;align-items:center;gap:10px;flex-wrap:wrap;min-width:0}
.card-title-status .pill{flex:0 0 auto}
.card-body{padding:16px}
.grid{display:grid;grid-template-columns:repeat(4,minmax(170px,1fr));gap:12px}
.two-col{display:grid;grid-template-columns:1.1fr .9fr;gap:16px;align-items:start}
.note{margin:12px 0 0;padding:11px 12px;border-left:3px solid var(--line);background:var(--off);color:var(--muted);font-size:13px;line-height:1.38}
.note.bad{border-left-color:var(--red);background:var(--red-soft);color:#612020}
.note.ok{border-left-color:var(--green);background:var(--green-soft);color:#224c38}
.small-note{color:var(--muted);font-family:var(--sans);font-size:12px;line-height:1.38;margin:8px 0 0}
details.advanced-settings{margin-top:14px;border:1px solid var(--line);border-radius:10px;background:var(--off)}
details.advanced-settings summary{padding:12px 13px;font-family:var(--sans);font-size:11px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;cursor:pointer}
details.advanced-settings .inside{padding:0 12px 14px}

.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:10px;background:var(--paper)}
table{width:100%;border-collapse:collapse;font-size:12px}
th,td{border-bottom:1px solid var(--line);padding:8px 7px;vertical-align:top}
th{font-family:var(--sans);font-size:10px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted);text-align:left;background:var(--off);position:sticky;top:0;z-index:2}
td.num,th.num{text-align:right}
th,td,label,.small-note,.note,.result-table th,.result-table td{white-space:normal;overflow:visible;text-overflow:clip}
.source-description,.source-bucket,.source-note{min-width:220px}
tr:last-child td{border-bottom:0}
textarea.paste-box{height:150px}
.source-paste-copy>label{margin:12px 0 10px}
.source-paste-copy>.small-note{margin:0 0 14px;line-height:1.5}
.source-paste-copy>textarea.paste-box{display:block}


.term-modal-overlay{position:fixed;inset:0;background:rgba(17,17,17,.48);z-index:85;display:flex;align-items:center;justify-content:center;padding:24px}
.term-modal-overlay.hidden{display:none!important}
.term-modal{width:min(920px,100%);max-height:calc(100vh - 48px);overflow:auto;background:var(--paper);border:2px solid var(--black);border-radius:14px;box-shadow:0 24px 80px rgba(0,0,0,.28);padding:22px;position:relative;text-align:left}
.term-modal h2{margin:0 44px 6px 0;font-size:24px;line-height:1.12}
.term-modal p{margin:0 0 12px;color:var(--muted);font-size:14px;line-height:1.42}
.term-close{position:absolute;top:14px;right:14px;border:1px solid var(--line);background:var(--paper);color:var(--black);border-radius:999px;width:30px;height:30px;line-height:26px;padding:0;font-size:18px;font-family:var(--sans)}
.term-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px;align-items:end;margin:12px 0 14px;padding:12px;border:1px solid var(--line);border-radius:10px;background:var(--off)}
.term-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.term-item{border:1px solid var(--line);border-radius:10px;background:var(--paper);padding:12px}
.term-item h4{margin:0 0 6px;font-family:var(--sans);font-size:12px;text-transform:uppercase;letter-spacing:.05em;color:var(--ink)}
.term-item p{font-size:13px;margin:0 0 7px;color:var(--ink)}
.term-cite{font-family:var(--sans);font-size:10px;color:var(--muted);font-weight:700;text-transform:uppercase;letter-spacing:.04em;margin-top:8px}
.term-example{border-left:3px solid var(--line);background:var(--off);padding:8px 9px;color:var(--muted);font-size:12px;margin-top:8px}
.term-category{display:inline-block;margin:0 0 8px;border:1px solid var(--line);border-radius:999px;background:var(--off);padding:3px 8px;font-family:var(--sans);font-size:9px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
.term-empty{grid-column:1/-1;padding:18px;border:1px dashed var(--line);border-radius:10px;color:var(--muted);text-align:center}
@media(max-width:780px){.term-list{grid-template-columns:1fr}.term-toolbar{grid-template-columns:1fr}}

.required-input-list{display:grid;gap:10px;margin-top:12px}
.required-input-row{display:grid;grid-template-columns:minmax(0,1fr) 190px;gap:12px;align-items:end;border:1px solid var(--line);border-radius:10px;background:var(--off);padding:11px}
.required-input-row label{margin:0}
.required-input-row .small-note{margin:4px 0 0}
.required-overlap-list{margin:9px 0 0;padding-left:20px}
.required-overlap-list li{margin:5px 0}
.required-modal-error{margin-top:12px}
@media(max-width:680px){.required-input-row{grid-template-columns:1fr}}
.mapping-checks{display:grid;gap:10px;margin-top:16px}
.mapping-check-panel{border:1px solid var(--line);border-radius:10px;background:var(--off);padding:13px}
.mapping-check-panel h3{margin:0 0 5px;font-size:16px}
.mapping-check-panel p{margin:0;color:var(--muted);line-height:1.42}
.mapping-check-panel .checkbox-label{margin-top:11px;text-transform:none;letter-spacing:0;font-size:13px;line-height:1.4;color:var(--ink)}
.mapping-zero-list{display:grid;gap:9px;margin-top:10px}
.mapping-zero-item{border-top:1px solid var(--line);padding-top:9px}
.mapping-zero-item:first-child{border-top:0;padding-top:0}


.statusbar{display:grid;grid-template-columns:repeat(6,1fr);gap:8px}
.status-item{border:1px solid var(--line);border-radius:10px;padding:10px;background:var(--off)}
.status-item strong{display:block;font-family:var(--sans);font-size:10px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
.status-item span{font-size:17px;font-weight:700}
.pass{color:var(--green);font-weight:700}
.fail{color:var(--red);font-weight:700}
.warn{color:var(--muted);font-weight:700}
.pill{display:inline-block;border-radius:999px;padding:4px 9px;font-family:var(--sans);font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;white-space:nowrap}
.pill.ok{background:var(--green-soft);color:var(--green);border:1px solid #bfe3ce}
.pill.warn{background:var(--off);color:var(--muted);border:1px solid var(--line)}
.pill.bad{background:var(--red-soft);color:var(--red);border:1px solid #e9b4b4}
.tabs{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px}
.tab-button{background:var(--paper);color:var(--black);border-color:var(--line);font-size:11px;padding:8px 12px}
.tab-button.active{background:var(--accent);color:#fff;border-color:var(--accent)}
.row-tools{display:flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:flex-end}
.row-tools button{font-size:10px;padding:5px 8px}
.detail-table td:nth-child(5){text-align:right;white-space:nowrap}
.results-workpaper{display:grid;gap:12px}
.results-section{border:1px solid var(--line);border-radius:10px;background:var(--paper);overflow:hidden}
.results-section h3{margin:0;padding:11px 13px;border-bottom:1px solid var(--line);background:var(--off);font-family:var(--sans);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted)}
.results-section table{min-width:760px}
.results-section th{position:static}
.results-section td,.results-section th{padding:8px 9px}
.results-section td:nth-child(n+2),.results-section th:nth-child(n+2){text-align:right;white-space:nowrap}
.results-section td.text,.results-section th.text{text-align:left;white-space:normal}
.results-section .total-row td{font-weight:700;background:var(--green-soft)}
.results-section .subtotal-row td{font-weight:700;background:var(--off)}
.results-section .ratio-row td{background:var(--blue-soft)}
.results-section .difference-negative{color:var(--green);font-weight:700}
.results-section .difference-positive{color:var(--red);font-weight:700}
.results-disclosure{border:1px solid var(--line);border-radius:10px;background:var(--paper);overflow:hidden}
.results-disclosure>summary{display:flex;align-items:center;justify-content:space-between;gap:12px;cursor:pointer;list-style:none;padding:13px 15px;font-family:var(--sans);font-size:12px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:var(--ink);background:var(--off)}
.results-disclosure>summary::-webkit-details-marker{display:none}
.results-disclosure>summary::after{content:"Expand";font-size:10px;color:var(--accent-2,var(--accent));letter-spacing:.03em}
.results-disclosure[open]>summary::after{content:"Collapse"}
.results-disclosure-content{display:grid;gap:12px;padding:12px}
.method-note{margin:8px 0 0;color:var(--muted);font-family:var(--sans);font-size:11px;line-height:1.38}
.method-fields{margin-top:14px}
.method-guidance{border-left-color:var(--accent);background:var(--accent-soft);color:var(--ink)}
.method-guidance strong{color:var(--black)}
.base-mapping-section{margin-top:14px;border:1px solid var(--line);border-radius:10px;background:var(--off);padding:12px}
.base-mapping-head{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:10px}
.base-mapping-head h3{margin:0;font-size:17px}
.base-mapping-head p{margin:4px 0 0;color:var(--muted);font-size:13px}
.base-mapping-actions{display:flex;gap:7px;flex-wrap:wrap;justify-content:flex-end}
.base-mapping-actions button{font-size:10px;padding:6px 9px}
.base-map-block{margin-top:12px}
.base-map-block h4{margin:0 0 7px;font-family:var(--sans);font-size:11px;text-transform:uppercase;letter-spacing:.05em;color:var(--muted)}
.base-map-table{width:100%;min-width:0!important;table-layout:fixed}
.base-map-table .base-account-col{width:42%}
.base-map-table .base-amount-col{width:14%}
.base-map-table .base-suggested-col{width:22%}
.base-map-table .base-selection-col{width:22%}
.base-map-table td,.base-map-table th{white-space:normal;overflow-wrap:break-word}
.base-map-table select{width:100%;min-width:0}
.base-account-name{font-weight:700}
.base-account-meta{margin-top:3px;color:var(--muted);font-family:var(--sans);font-size:10px;line-height:1.3}
@media(max-width:900px){.base-mapping-head{display:block}.base-mapping-actions{justify-content:flex-start;margin-top:8px}.base-map-table{font-size:12px}.base-map-table .base-account-col{width:34%}.base-map-table .base-amount-col{width:16%}.base-map-table .base-suggested-col,.base-map-table .base-selection-col{width:25%}}
.group-title{font-family:var(--sans);font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:var(--muted);margin:16px 0 7px}
.readiness{display:grid;grid-template-columns:repeat(5,1fr);gap:8px}
.ready-card{border:1px solid var(--line);border-radius:10px;padding:10px;background:var(--off)}
.ready-card strong{display:block;font-family:var(--sans);font-size:10px;text-transform:uppercase;color:var(--muted);letter-spacing:.05em;margin-bottom:4px}
.ready-card span{font-weight:700}
.decision-summary{margin-bottom:14px}
.decision-summary h3{margin:0 0 8px;font-size:16px}
.decision-summary table{min-width:720px}
.decision-summary td:nth-child(2){font-weight:700}
.validation-list{margin:0;padding-left:20px}
.validation-list li{margin:6px 0;line-height:1.35}

.disclaimer-overlay{position:fixed;inset:0;background:rgba(17,17,17,.45);z-index:50;display:flex;align-items:center;justify-content:center;padding:24px}
.disclaimer-box{width:min(720px,100%);background:var(--paper);border:2px solid var(--black);border-radius:14px;box-shadow:0 24px 80px rgba(0,0,0,.24);padding:26px;text-align:left}
.disclaimer-box h2{margin:0 0 8px;font-size:24px}
.disclaimer-box p{margin:0 0 12px;color:var(--muted);font-size:14px;line-height:1.43}
.disclaimer-check{display:flex;gap:10px;align-items:flex-start;margin:14px 0}
.disclaimer-check input{width:auto;margin-top:2px}
.disclaimer-check label{margin:0;text-transform:none;letter-spacing:0;font-size:13px;line-height:1.38;color:var(--ink)}
body.app-blurred header.active,body.app-blurred main.active{filter:blur(3px);pointer-events:none;user-select:none}

.tour-overlay{position:fixed;inset:0;z-index:45;pointer-events:none}
.tour-shade{position:absolute;inset:0;background:rgba(17,17,17,.28)}
.tour-highlight{position:absolute;border:3px solid var(--accent);border-radius:12px;box-shadow:0 0 0 9999px rgba(17,17,17,.28),0 10px 28px rgba(0,0,0,.22);transition:all .18s ease;pointer-events:none}
.tour-card{position:absolute;width:min(380px,calc(100vw - 40px));background:var(--paper);border:2px solid var(--black);border-radius:12px;box-shadow:0 20px 54px rgba(0,0,0,.25);padding:16px;pointer-events:auto}
.tour-card h3{margin:0 0 6px;font-size:19px}
.tour-card p{margin:0 0 12px;color:var(--muted);line-height:1.35}
.tour-card .tour-actions{display:flex;justify-content:space-between;align-items:center;gap:12px}
.tour-count{font-family:var(--sans);font-size:11px;font-weight:700;color:var(--muted);text-transform:uppercase;letter-spacing:.06em}
.live-results{margin:14px 8px 0;padding:12px;border-top:1px solid rgba(184,148,125,.20);border-bottom:1px solid rgba(184,148,125,.20)}
.live-results>span{display:block;margin-bottom:8px;font-family:var(--sans);font-size:9px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}
.live-result{display:flex;justify-content:space-between;gap:10px;align-items:baseline;padding:5px 0;font-family:var(--sans)}
.live-result span{font-size:10px;color:var(--muted)}
.live-result strong{font-size:12px;color:var(--ink);text-align:right}



/* Visibility-first source mapping. No titles, descriptions, or workpaper labels are intentionally truncated. */
th,td{white-space:normal;overflow:visible;text-overflow:clip;overflow-wrap:anywhere}
td.num,th.num{white-space:nowrap;text-align:right}
.source-description{min-width:300px;max-width:520px;white-space:normal;overflow-wrap:anywhere}
.source-period{min-width:150px;max-width:220px;white-space:normal}
.source-bucket{min-width:240px;max-width:420px;white-space:normal}
.source-note{min-width:260px;max-width:520px;white-space:normal}
.editable-text{min-height:24px;min-width:160px;border:1px solid transparent;border-radius:6px;padding:4px 5px;background:transparent;white-space:normal;overflow:visible;overflow-wrap:anywhere}
.editable-text:focus{border-color:var(--accent);box-shadow:0 0 0 3px rgba(15,107,143,.14);outline:none;background:var(--paper)}
.results-section td,.results-section th{white-space:normal!important;overflow:visible;text-overflow:clip;overflow-wrap:anywhere}
.results-section td.numcell,.results-section th.numcell{white-space:nowrap!important;text-align:right}
.detail-table td,.detail-table th{white-space:normal;overflow:visible;overflow-wrap:anywhere}



/* Compact visible import status sidebar inside source mapping. */
.source-map-layout{display:grid;grid-template-columns:minmax(0,1fr) 245px;gap:12px;align-items:start}
.source-map-main{min-width:0}
.import-status-panel{border:1px solid var(--line);border-radius:10px;background:var(--off);padding:10px;position:sticky;top:12px;box-shadow:0 8px 22px rgba(17,17,17,.04)}
.import-status-head{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:8px;border-bottom:1px solid var(--line);padding-bottom:8px}
.import-status-head h3{margin:0;font-family:var(--sans);font-size:10px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}
.import-status-head button{font-size:9.5px;padding:5px 7px;white-space:nowrap}
.import-status-panel .statusbar{display:grid;grid-template-columns:1fr;gap:6px}
.import-status-panel .status-item{display:flex;justify-content:space-between;align-items:baseline;gap:8px;border-radius:8px;padding:7px 8px;background:var(--paper)}
.import-status-panel .status-item strong{margin:0;font-size:9px;line-height:1.15}
.import-status-panel .status-item span{font-size:14px;line-height:1.1;text-align:right}
.import-status-divider{height:1px;background:var(--line);margin:10px 0 8px}
.import-status-subhead{border-bottom:0;margin-bottom:6px;padding-bottom:0}
.import-status-panel .status-item span.pass{color:var(--green)}
.import-status-panel .status-item span.warn{color:var(--muted)}
.import-status-panel .status-item span.fail{color:var(--red)}
