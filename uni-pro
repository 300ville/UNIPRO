function rowTaxAdjustmentResult(row){
  if(state.amountBasis !== "book" || state.bookTreatment !== "taxReconcile") return {ok:true,blank:false,value:0,derived:false};
  const federalTax = parseAmountResult(row && row.sourceTaxAmount);
  const book = parseAmountResult(row && row.amount);
  if(federalTax.ok && book.ok) return {ok:true,blank:false,value:federalTax.value-book.value,derived:true};
  const explicit = parseAmountResult(row && row.taxAdjustment);
  return {...explicit,derived:false};
}

function rowTaxAdjustment(row){
