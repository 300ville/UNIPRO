    state.priorMixedMspmSplitMethod = "";
  } else if(state.priorSelectedMethod !== "MSPM" || !["labor","production"].includes(state.priorMixedServiceMethod)) state.priorMixedMspmSplitMethod = "";
  if(state.unicapHistory === "priorUnchanged" && state.activityType === "producer"){
    if(["SPM","MSPM"].includes(state.priorSelectedMethod)){
      state.selectedMethod = state.priorSelectedMethod;
      state.selectedMethodConfirmed = true;
    }
    state.mixedServiceMethod = ["labor","production","direct","step","reasonable"].includes(state.priorMixedServiceMethod) ? state.priorMixedServiceMethod : "";
