      fsaBookEqualsTax:String(row.fsaBookEqualsTax || ""),
      fsaTaxSource:fsaTaxSourceLabel(row),
      fsaNegativeAdjustmentConfirmed:row.fsaNegativeAdjustmentConfirmed === true,
      fsaAdditionalCostType:String(row.fsaAdditionalCostType || ""),
      fsaSpecialRuleReference:String(row.fsaSpecialRuleReference || ""),
      usePct:100,
      inputId:row.inputId || "review",
      suggestedInputId:row.suggestedInputId || "review",
      confidence:String(row.confidence || ""),
      suggestionReason:String(row.suggestionReason || ""),
      reason:String(row.reason || ""),
      notes:String(row.notes || ""),
      confirmed:row.confirmed === true,
      notIn471Confirmed:row.notIn471Confirmed === true,
      mspmConfirmed:row.mspmConfirmed === true,
      laborTreatment:row.laborTreatment || "review",
