function rowStats(){
  const reviewCount = state.rows.filter(row => row.review || row.inputId === "review").length;
  const unconfirmedCount = state.rows.filter(rowNeedsConfirmation).length;
  const suspenseRows = state.rows.filter(row => inputOption(row).group === "Breakout / Suspense");
  const suspenseCount = suspenseRows.length;
  const suspenseAmount = suspenseRows.reduce((sum,row) => sum + mapped(row), 0);
  const suspenseAbsAmount = suspenseRows.reduce((sum,row) => sum + Math.abs(mapped(row)), 0);
  const suggestedCount = state.rows.filter(row => row.confidence !== "Manual").length;
  const manualCount = state.rows.filter(row => row.confirmed === true).length;
  const parseIssues = state.rows.filter(row => !parseAmountResult(row.amount).ok || row.parseOk === false).length;
  const overlapUnconfirmedCount = overlapRowsNeedingConfirmation().length;
  const duplicateGroups = duplicateRowGroups();
  const duplicateRows = duplicateGroups.reduce((count,group) => count + group.length,0);
  const mspmReviewCount = mspmRowsNeedingReview().length;
  const mspmBreakoutCount = mspmRowsNeedingBreakout().length;
  const fsaTaxAmountMissingCount = fsaRowsNeedingTaxAmount().length;
  const fsaCharacterizationMissingCount = fsaRowsNeedingAdditionalCostCharacterization().length;
  const fsaNegativeUnconfirmedCount = fsaRowsNeedingNegativeConfirmation().length;
  return {reviewCount,unconfirmedCount,suggestedCount,manualCount,parseIssues,overlapUnconfirmedCount,duplicateGroups:duplicateGroups.length,duplicateRows,suspenseCount,suspenseAmount,suspenseAbsAmount,mspmReviewCount,mspmBreakoutCount,fsaTaxAmountMissingCount,fsaCharacterizationMissingCount,fsaNegativeUnconfirmedCount};
}

function hasMixedServiceCosts(){
  return state.rows.some(row => row.confirmed === true && row.inputId === "mixedservice" && mapped(row) !== 0);
}

function validTaxYearEnding(value){
  const match = String(value || "").trim().match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
  if(!match) return false;
  const month = Number(match[1]);
  const day = Number(match[2]);
  const year = Number(match[3]);
  if(year < 1900 || year > 2200) return false;
  const date = new Date(Date.UTC(year,month - 1,day));
  return date.getUTCFullYear() === year && date.getUTCMonth() === month - 1 && date.getUTCDate() === day;
}
