  if(state.methodRun !== "SPM"){
    if(isDetailedMixedMethod(c.mixedServiceMethod)){
      rows.push({cells:["Pre-production allocation from detailed workpaper before any 90 percent election",resultCell(c.mixedDetailedPreProduction)]});
    } else if((c.mixedMspmSplitMethod || c.mixedCalculationSplitMethod) === "materials"){
      rows.push(
