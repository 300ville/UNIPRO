function sourceAmountHeaderKind(header){
  const normalized = normalizeHeader(String(header || "").split("|")[0]);
  if(!normalized || normalized === "manual" || normalized.startsWith("positional")) return "generic";
  if(normalized === "tax" || normalized.includes("federal tax") || normalized.includes("tax total") || normalized.includes("tax amount") || normalized.includes("tax balance") || normalized.includes("tax adjusted") || (normalized.includes("tax") && normalized.includes("trial balance"))) return "tax";
  if(normalized === "book" || normalized.includes("book total") || normalized.includes("book amount") || normalized.includes("book balance") || normalized.includes("financial statement") || normalized.includes("trial balance") || normalized === "tb amount") return "book";
  return "generic";
}

function sourceAmountForBasis(row,basis){
  const raw = basis === "book" ? row && row.sourceBookAmount : row && row.sourceTaxAmount;
  const parsed = parseAmountResult(raw);
  return parsed.ok ? parsed.value : null;
}

function sourceHeaderForBasis(row,basis){
  return String((basis === "book" ? row && row.sourceBookHeader : row && row.sourceTaxHeader) || "").trim();
}

function applyAmountBasisToImportedRows(basis){
  if(!["tax","book"].includes(basis)) return 0;
  let changed = 0;
  state.rows.forEach(row => {
    if(row.sourceLineNumber == null || row.parentSourceId) return;
    const targetAmount = sourceAmountForBasis(row,basis);
    const targetHeader = sourceHeaderForBasis(row,basis);
    if(targetAmount == null || !targetHeader) return;
    const amountChanged = !parseAmountResult(row.amount).ok || !isZeroMoney(parseAmount(row.amount) - targetAmount);
    const headerChanged = String(row.sourceAmountHeader || "") !== targetHeader;
    if(!amountChanged && !headerChanged) return;
    row.amount = targetAmount;
    row.originalAmount = targetAmount;
    row.sourceAmountHeader = targetHeader;
    row.sourceAmountBasis = basis;
    row.parseOk = true;
    row.parseWarning = "";
    row.notIn471Confirmed = false;
    row.fsaNegativeAdjustmentConfirmed = false;
    changed += 1;
  });
  return changed;
}

function basisSourceMismatchRows(basis=state.amountBasis){
  if(!["tax","book"].includes(basis)) return [];
  return state.rows.filter(row => {
    if(row.sourceLineNumber == null) return false;
    const explicitKind = ["tax","book"].includes(row.sourceAmountBasis) ? row.sourceAmountBasis : "";
    const currentKind = explicitKind || sourceAmountHeaderKind(row.sourceAmountHeader);
    return currentKind !== "generic" && currentKind !== basis;
  });
