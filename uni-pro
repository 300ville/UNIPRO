function categoryHasAmount(inputId){
  return state.rows.some(row => row.confirmed === true
    && row.inputId === inputId
    && hasNumericEntry(row.amount));
}

function missingRequiredCategories(){
  return requiredCategoryIds().filter(inputId => !categoryHasAmount(inputId));
}

function rowRequiresOverlapConfirmation(row){
  return !!row
    && row.confirmed === true
    && OVERLAP_CONFIRMATION_IDS.has(row.inputId)
    && hasNumericEntry(row.amount)
    && mapped(row) !== 0;
}

function overlapRowsNeedingConfirmation(){
  return state.rows.filter(row => rowRequiresOverlapConfirmation(row) && row.notIn471Confirmed !== true);
}

function overlapRowLabel(row){
  return [row.account,row.description].filter(Boolean).join(" | ") || requiredCategoryLabel(row.inputId);
}

