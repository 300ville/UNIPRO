function invalidateCalculationApprovals(){
  lastImportSnapshot = null;
  calculationRevision += 1;
  fingerprintCacheRevision = -1;
  invalidateReviewSignoffs();
  clearRedFlagOverride();
  state.printForReviewDisclaimer = false;
}

function invalidateStaleApprovals(){
  const fingerprint = calculationFingerprint();
  const reviewStale = (state.staffReviewChecked && state.staffReviewFingerprint !== fingerprint)
    || (state.managerReviewChecked && state.managerReviewFingerprint !== fingerprint)
    || (state.seniorManagerReviewChecked && state.seniorManagerReviewFingerprint !== fingerprint)
    || (state.partnerReviewChecked && state.partnerReviewFingerprint !== fingerprint);
  if(reviewStale) invalidateReviewSignoffs();
  if(state.redFlagOverrideChecked && state.redFlagOverrideFingerprint && state.redFlagOverrideFingerprint !== fingerprint){
    clearRedFlagOverride();
  }
}

function updateRedFlagOverride(){
  const checked = $("redFlagOverrideChecked") ? $("redFlagOverrideChecked").checked : false;
  const explanation = $("redFlagOverrideExplanation") ? $("redFlagOverrideExplanation").value : "";
  const changed = checked !== state.redFlagOverrideChecked
    || String(explanation) !== String(state.redFlagOverrideExplanation || "");
  if(changed) invalidateReviewSignoffs();
  state.redFlagOverrideChecked = checked;
  state.redFlagOverrideExplanation = explanation;
  if(changed){
    state.redFlagOverrideFingerprint = checked && String(explanation).trim() ? calculationFingerprint() : "";
  }
  renderCalcOnly();
}

function updateRedFlagOverrideExplanation(value){
  if(String(value) === String(state.redFlagOverrideExplanation || "")) return;
  invalidateReviewSignoffs();
  state.redFlagOverrideExplanation = value;
  state.redFlagOverrideFingerprint = state.redFlagOverrideChecked && String(value).trim() ? calculationFingerprint() : "";
}

