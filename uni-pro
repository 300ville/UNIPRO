function changeAmountBasis(value){
  if(!["tax","book"].includes(value) || value === state.amountBasis) return;
  if(state.rows.length && typeof confirm === "function" && !confirm("Changing between Tax and Book requires a new import. Clear the imported accounts and continue?")){
    setControls();
    return;
  }
  invalidateCalculationApprovals();
  normalizeLifoPools().forEach(pool => { pool.fsaBasisConfirmed = ""; });
  if(state.rows.length){
    state.rows = [];
    state.lastImport = null;
    state.importHistory = [];
    resetSourceDependentInputs();
    clearPendingImportUi(true);
  }
  state.amountBasis = value;
  state.bookTreatment = value === "book" ? "financialStatement" : "";
  clearBookTaxMethodConfirmation();
  if(value !== "book"){
    state.bookTreatment = "";
    state.financialStatementQualified = "";
    state.financialStatementMethodAdopted = "";
    state.financialStatementValuationExcluded = "";
    state.financialStatementGrossReceiptsEligible = "";
    state.fsaOpeningBasisConfirmed = "";
    state.fsaMethodChange = "";
    state.fsaMethodChangeReference = "";
    state.fsaEndingBasisConfirmed = "";
    state.rows.forEach(row => { row.fsaTaxAmount = ""; row.fsaBookEqualsTax = ""; row.fsaNegativeAdjustmentConfirmed = false; row.fsaAdditionalCostType = ""; row.fsaSpecialRuleReference = ""; });
  }
  if(pendingImportAnalysis) previewPastedRows();
  renderAll();
}

