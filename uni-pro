function csvSplit(line){
  const out = [];
  let cur = "";
  let q = false;

  for(let i=0;i<line.length;i++){
    const ch = line[i];
    if(ch === '"' && line[i+1] === '"'){
      cur += '"';
      i++;
    } else if(ch === '"'){
      q = !q;
    } else if(ch === "," && !q){
      out.push(cur);
      cur = "";
    } else {
      cur += ch;
    }
  }
  out.push(cur);
  return out;
}

function normalizeHeader(value){
  return String(value || "").toLowerCase().replace(/[^a-z0-9]+/g, " ").trim();
}

function findHeader(headers, candidates){
  for(const candidate of candidates){
    const c = normalizeHeader(candidate);
    const exact = headers.findIndex(h => h === c);
    if(exact >= 0) return exact;
  }
  for(const candidate of candidates){
    const c = normalizeHeader(candidate);
    const contains = headers.findIndex(h => h.includes(c));
    if(contains >= 0) return contains;
  }
  return -1;
}

function findExactHeader(headers,candidates){
  const normalized = candidates.map(normalizeHeader);
  return headers.findIndex(header => normalized.includes(header));
}

function findScopedHeader(headers,candidates,forbiddenTerms=[]){
  const normalized = candidates.map(normalizeHeader);
  const allowed = header => !forbiddenTerms.some(term => header.includes(normalizeHeader(term)));
  for(const candidate of normalized){
    const exact = headers.findIndex(header => header === candidate && allowed(header));
    if(exact >= 0) return exact;
  }
  for(const candidate of normalized){
    const contains = headers.findIndex(header => header.includes(candidate) && allowed(header));
    if(contains >= 0) return contains;
  }
  return -1;
}

function splitPasteLine(line){
  return line.includes("	") ? line.split("	") : csvSplit(line);
}

function normalizePasteCell(value){
  return String(value ?? "").replace(/\u00a0/g," ").replace(/[ \t]+/g," ").trim();
}

function splitMarkdownTableLine(line){
  let text = String(line || "").trim();
  if(text.startsWith("|")) text = text.slice(1);
  if(text.endsWith("|")) text = text.slice(0,-1);
  const cells = [];
  let cell = "";
  let escaped = false;
  for(const character of text){
    if(escaped){
      cell += character;
      escaped = false;
    }else if(character === "\\"){
      escaped = true;
    }else if(character === "|"){
      cells.push(normalizePasteCell(cell));
      cell = "";
    }else{
      cell += character;
    }
  }
  if(escaped) cell += "\\";
  cells.push(normalizePasteCell(cell));
  return cells;
}

function isMarkdownAlignmentCells(cells){
  const populated = cells.filter(Boolean);
  return populated.length >= 2 && populated.every(cell => /^:?-{1,}:?$/.test(cell));
}

function recoverFlatExcelRows(rows){
  if(rows.length !== 1 || rows[0].cells.length < 40) return rows;
  const cells = rows[0].cells;
  const likelyAccountAt = index => {
    const account = normalizePasteCell(cells[index]);
    const description = normalizePasteCell(cells[index + 1]);
    if(!account || !description || account.length > 40) return false;
    if(!/\d/.test(account) || !/^[A-Za-z0-9][A-Za-z0-9 ._\/-]*$/.test(account)) return false;
    if(/[(),$]/.test(account) || /^(?:19|20)\d{2}(?:[-/]\d{1,2})?/.test(account)) return false;
    if(!/[A-Za-z]/.test(description) || parseAmountResult(description).ok) return false;
    if(/^(?:client|engagement|period ending|trial balance|workpaper|group|subgroup|subtotal|total|grand total|sum of)/i.test(account)) return false;
    return true;
  };
  const positions = [];
  for(let index=0;index<cells.length-2;index++) if(likelyAccountAt(index)) positions.push(index);
  if(positions.length < 4) return rows;
  const deltaCounts = new Map();
  for(let index=1;index<positions.length;index++){
    const delta = positions[index] - positions[index-1];
    if(delta >= 3 && delta <= 300) deltaCounts.set(delta,(deltaCounts.get(delta) || 0) + 1);
  }
  const ranked = Array.from(deltaCounts.entries()).sort((left,right) => right[1]-left[1] || left[0]-right[0]);
  const width = ranked.length ? ranked[0][0] : 0;
  if(width < 3 || width > 300 || ranked[0][1] < 2) return rows;
  const remainderCounts = new Map();
  positions.forEach(position => remainderCounts.set(position % width,(remainderCounts.get(position % width) || 0) + 1));
  const dominant = Array.from(remainderCounts.entries()).sort((left,right) => right[1]-left[1])[0];
  if(!dominant || dominant[1] < Math.max(4,Math.floor(positions.length * .6))) return rows;
  const rebuilt = [];
  for(let start=0,line=1;start<cells.length;start+=width,line++){
    const rowCells = cells.slice(start,start+width);
    if(rowCells.some(Boolean)) rebuilt.push({text:rowCells.join("\t"),line,cells:rowCells,alignment:false,recovered:true});
  }
  return rebuilt;
}

function parsePasteGrid(text){
  const lines = String(text || "").split(/\r\n|[\n\r\u2028\u2029]/);
  const markdownLines = lines.filter(line => /^\s*\|/.test(line) && line.includes("|"));
  const isMarkdown = markdownLines.length >= 2;
  const rows = [];
  lines.forEach((raw,index) => {
    if(!raw.trim()) return;
    if(isMarkdown && !/^\s*\|/.test(raw)) return;
    const cells = (isMarkdown ? splitMarkdownTableLine(raw) : splitPasteLine(raw).map(normalizePasteCell));
    rows.push({text:raw,line:index+1,cells,alignment:isMarkdownAlignmentCells(cells)});
  });
  const recoveredRows = isMarkdown ? rows : recoverFlatExcelRows(rows);
  return {rows:recoveredRows,format:isMarkdown ? "Structured Markdown report" : (recoveredRows !== rows ? "Recovered Excel worksheet" : "Delimited source data"),isMarkdown};
}

function looksLikeSourceAccount(value){
  const account = normalizePasteCell(value);
  if(!account || account.length > 80 || account.includes(":")) return false;
  if(/^(?:group|subgroup|subtotal|total|grand total|client|engagement|period ending|trial balance|workpaper|account)(?:\s|:|\[|$)/i.test(account)) return false;
  if(/\btotal\b\s*$/i.test(account)) return false;
  if(/\d/.test(account)) return /^[A-Za-z0-9][A-Za-z0-9 ._\/-]*$/.test(account);
  return /^[A-Za-z][A-Za-z0-9._\/-]{1,29}(?:\s+[A-Za-z0-9._\/-]{1,12}){0,2}$/.test(account);
}

function structuralSourceRowReason(account,description,row){
  const first = normalizePasteCell(account);
  const second = normalizePasteCell(description);
  const combined = `${first} ${second}`.trim();
  if(row && row.alignment) return "Markdown alignment row";
  if(!combined) return "Blank spacer row";
  if(/^(?:client|engagement|period ending|trial balance|workpaper)\s*:/i.test(first)) return "Report metadata";
  if(/^group\s*:/i.test(first)) return "Group heading";
  if(/^subgroup\s*:/i.test(first)) return "Subgroup heading";
  if(/^(?:subtotal|total|grand total)(?:\s|:|\[|$)/i.test(first)) return "Subtotal or total";
  if(/^page\s+\d+/i.test(first)) return "Page heading";
  return "Report structure";
}

function finalPopulationControlLabel(account,description){
  const first = normalizePasteCell(account);
  const second = normalizePasteCell(description);
  const isFinalLabel = value => {
    const label = normalizeHeader(value);
    return /^(?:sum|total) of (?:all )?(?:account groups?|accounts?|detail accounts?)(?: total)?$/.test(label)
      || /^(?:grand total|trial balance total|total trial balance)$/.test(label);
  };
  const firstMatches = isFinalLabel(first);
  const secondMatches = isFinalLabel(second);
  if(!firstMatches && !secondMatches) return "";
  const other = normalizeHeader(firstMatches ? second : first);
  if(other && !/^(?:control|control total|summary|all accounts|all groups|population total|report total)$/.test(other)) return "";
  if(firstMatches) return first;
  if(secondMatches) return second;
  return "";
}

function structuredHeaderRow(gridRows){
  // Full-sheet Excel copies can contain report furniture, print titles, and
  // hidden helper rows before the actual table. Search the complete pasted
  // population, subject to a generous safety cap, instead of assuming the
  // header appears near the top.
  const limit = Math.min(gridRows.length,2000);
  for(let index=0;index<limit;index++){
    const row = gridRows[index];
    if(row.alignment) continue;
    const headers = row.cells.map(normalizeHeader);
    const accountIndex = findHeader(headers,["account number","gl account number","gl account","account","account code","acct number","acct"]);
    const descriptionIndex = findHeader(headers,["account description","gl description","account name","description","name"]);
    if(accountIndex >= 0 && descriptionIndex >= 0 && accountIndex !== descriptionIndex){
      return {row,index,accountIndex,descriptionIndex};
    }
  }
  return null;
}

function structuredReportPeriod(gridRows,headerIndex){
  for(let index=0;index<headerIndex;index++){
    const first = normalizePasteCell(gridRows[index].cells[0]);
    if(/^period ending\s*:/i.test(first)) return normalizePasteCell(gridRows[index].cells[1]);
  }
  return "";
}

function structuredReportSourceBasis(gridRows,headerIndex){
  const evidenceRows = gridRows.slice(0,headerIndex).filter(row => /^(?:trial balance|source basis|amount basis|report basis|workpaper)\s*:/i.test(normalizePasteCell(row.cells[0])));
  evidenceRows.sort((left,right) => (/^workpaper\s*:/i.test(normalizePasteCell(left.cells[0])) ? 1 : 0) - (/^workpaper\s*:/i.test(normalizePasteCell(right.cells[0])) ? 1 : 0));
  for(const row of evidenceRows){
    const normalized = normalizeHeader(row.cells.slice(0,3).join(" "));
    if(normalized.includes("federal tax") || normalized.includes("tax adjusted") || normalized.includes("tax trial balance") || /(?:^|\s)tax(?:\s|$)/.test(normalized)) return "tax";
    if(normalized.includes("book") || normalized.includes("financial statement")) return "book";
  }
  return "";
}

function periodYear(value){
  const years = String(value || "").match(/(?:19|20)\d{2}/g);
  return years && years.length ? years[years.length-1] : "";
}

function canonicalPeriodDate(value){
  const text = String(value || "").trim();
  let match = text.match(/^(\d{1,2})\/(\d{1,2})\/((?:19|20)\d{2})$/);
  if(match) return `${match[3]}-${String(Number(match[1])).padStart(2,"0")}-${String(Number(match[2])).padStart(2,"0")}`;
  match = text.match(/^((?:19|20)\d{2})-(\d{1,2})-(\d{1,2})$/);
  if(match) return `${match[1]}-${String(Number(match[2])).padStart(2,"0")}-${String(Number(match[3])).padStart(2,"0")}`;
  return "";
}

function structuredAmountColumnLabel(headerCells,secondaryCells,index){
  const primary = normalizePasteCell(headerCells[index]);
  const secondary = normalizePasteCell(secondaryCells[index]);
  if(primary && secondary && normalizeHeader(primary) !== normalizeHeader(secondary)) return `${primary} | ${secondary}`;
  return primary || secondary || `Column ${index + 1}`;
}

function structuredAmountColumnScore(label,parsedCount,accountRowCount,reportPeriod){
  const normalized = normalizeHeader(label);
  const primary = normalizeHeader(String(label || "").split("|")[0]);
  const compact = normalized.replace(/\s+/g,"");
  const primaryCompact = primary.replace(/\s+/g,"");
  let score = accountRowCount ? (parsedCount / accountRowCount) * 100 : 0;
  if(["source amount","client amount","amount","value"].includes(primary)) score += 420;
  if(state.amountBasis === "tax" && /(?:federal)?tax(?:adjusted)?(?:total|amount|balance)?/.test(compact)) score += 480;
  if(state.amountBasis === "book" && /(?:book|financialstatement|trialbalance)(?:total|amount|balance)?/.test(compact)) score += 480;
  if(/^(?:consol|consolidated)$/.test(primary)) score += 360;
  if(/(?:preconsol|preconsolidated)/.test(primaryCompact)) score += 220;
  if(/(?:1st|first|prior|previous|ppconsol)/.test(compact)) score -= 240;
  if(/^(?:eje|aje|je|jeref)$/.test(primaryCompact)) score -= 180;
  if(reportPeriod && normalizeHeader(label).includes(normalizeHeader(reportPeriod))) score += 90;
  return score;
}

function analyzeStructuredPastedData(text,grid,header,requestedAmountColumnKey="",requestedTaxAmountColumnKey=""){
  const rowsAfterHeader = grid.rows.slice(header.index + 1);
  const secondaryCandidate = rowsAfterHeader.find(row => !row.alignment);
  const secondaryRow = secondaryCandidate
    && !normalizePasteCell(secondaryCandidate.cells[header.accountIndex])
    && !normalizePasteCell(secondaryCandidate.cells[header.descriptionIndex])
    && secondaryCandidate.cells.some(cell => /^(?:\d{1,2}\/\d{1,2}\/\d{2,4}|\d{4}-\d{1,2}-\d{1,2})$/.test(normalizePasteCell(cell)))
      ? secondaryCandidate
      : null;
  const secondaryCells = secondaryRow ? secondaryRow.cells : [];
  const reportPeriod = structuredReportPeriod(grid.rows,header.index);
  const reportSourceBasis = structuredReportSourceBasis(grid.rows,header.index);
  const accountRows = rowsAfterHeader.filter(row => {
    const account = row.cells[header.accountIndex];
    const description = row.cells[header.descriptionIndex];
    if(finalPopulationControlLabel(account,description)) return false;
    return looksLikeSourceAccount(account);
  });
  const columnCount = Math.max(header.row.cells.length,...rowsAfterHeader.map(row => row.cells.length),0);
  const amountCandidates = [];
  for(let index=0;index<columnCount;index++){
    if(index === header.accountIndex || index === header.descriptionIndex) continue;
    if(!normalizePasteCell(header.row.cells[index]) && !normalizePasteCell(secondaryCells[index])) continue;
    const label = structuredAmountColumnLabel(header.row.cells,secondaryCells,index);
    const labelPrimary = normalizeHeader(String(label).split("|")[0]).replace(/\s+/g,"");
    if(/^(?:jeref|reference|ref|memo|note|quantity|units|count)$/.test(labelPrimary)) continue;
    let parsedCount = 0;
    let net = 0;
    let absolute = 0;
    accountRows.forEach(row => {
      const parsed = parseAmountResult(normalizePasteCell(row.cells[index]));
      if(!parsed.ok) return;
      parsedCount += 1;
      net += parsed.value;
      absolute += Math.abs(parsed.value);
    });
    if(!parsedCount) continue;
    amountCandidates.push({
      key:String(index),index,label,parsedCount,net,absolute,
      score:structuredAmountColumnScore(label,parsedCount,accountRows.length,reportPeriod)
    });
  }
  const candidateLabelCounts = amountCandidates.reduce((counts,candidate) => {
    const key = normalizeHeader(candidate.label);
    counts[key] = (counts[key] || 0) + 1;
    return counts;
  },{});
  amountCandidates.forEach(candidate => {
    if(candidateLabelCounts[normalizeHeader(candidate.label)] > 1) candidate.label = `${candidate.label} | Source column ${candidate.index + 1}`;
  });
  amountCandidates.sort((left,right) => right.score-left.score || right.parsedCount-left.parsedCount || left.index-right.index);
  const requested = amountCandidates.find(candidate => candidate.key === String(requestedAmountColumnKey || ""));
  const top = amountCandidates[0];
  const selected = requested || top || null;
  const recommendedAmountColumnKey = top ? top.key : "";
  const selectedHeaderKind = selected ? sourceAmountHeaderKind(selected.label) : "generic";
  const selectedSourceBasis = selectedHeaderKind === "generic" ? reportSourceBasis : selectedHeaderKind;
  const selectedPeriodMatch = selected ? String(selected.label).match(/(?:\d{1,2}\/\d{1,2}\/\d{2,4}|\d{4}-\d{1,2}-\d{1,2})/) : null;
  const selectedPeriod = selectedPeriodMatch ? selectedPeriodMatch[0] : reportPeriod;
  const candidatePeriodCompatible = candidate => {
    const match = String(candidate && candidate.label || "").match(/(?:\d{1,2}\/\d{1,2}\/\d{2,4}|\d{4}-\d{1,2}-\d{1,2})/);
    if(!match || !selectedPeriod) return true;
    const candidateDate = canonicalPeriodDate(match[0]);
    const selectedDate = canonicalPeriodDate(selectedPeriod);
    return candidateDate && selectedDate ? candidateDate === selectedDate : periodYear(match[0]) === periodYear(selectedPeriod);
  };
  const taxAmountCandidates = bookFederalTaxSupportActive() && selected
    ? amountCandidates.filter(candidate => candidate.key !== selected.key && sourceAmountHeaderKind(candidate.label) === "tax" && candidatePeriodCompatible(candidate))
    : [];
  const requestedTax = taxAmountCandidates.find(candidate => candidate.key === String(requestedTaxAmountColumnKey || ""));
  const selectedTax = requestedTax || taxAmountCandidates[0] || null;
  const recommendedTaxAmountColumnKey = taxAmountCandidates.length ? taxAmountCandidates[0].key : "";
  const needsTaxAmountSelection = false;
  const basisConflict = !!selected && !!selectedSourceBasis && !!state.amountBasis && selectedSourceBasis !== state.amountBasis;
  const selectedPeriodDate = canonicalPeriodDate(selectedPeriod);
  const setupPeriodDate = canonicalPeriodDate(state.taxYear);
  const periodConflict = !!selected && (selectedPeriodDate && setupPeriodDate
    ? selectedPeriodDate !== setupPeriodDate
    : !!periodYear(selectedPeriod) && !!periodYear(state.taxYear) && periodYear(selectedPeriod) !== periodYear(state.taxYear));
  const format = grid.isMarkdown ? "Structured Markdown report" : "Structured trial-balance report";
  const base = {
    rows:[],rejected:[],ignored:[],hasHeader:true,headerError:false,headerLine:header.row.line,secondaryHeaderLine:secondaryRow ? secondaryRow.line : null,
    net:0,absolute:0,duplicateGroups:0,amountColumnLabel:selected ? selected.label : "Select an amount column",
    amountCandidates,selectedAmountColumnKey:selected ? selected.key : "",recommendedAmountColumnKey,needsAmountSelection:!selected,
    taxAmountCandidates,selectedTaxAmountColumnKey:selectedTax ? selectedTax.key : "",recommendedTaxAmountColumnKey,needsTaxAmountSelection,
    taxAmountColumnLabel:selectedTax ? selectedTax.label : (bookFederalTaxSupportActive() ? "Enter federal tax amounts during account review" : "Not applicable"),
    sourceFormat:format,reportPeriod:selectedPeriod || reportPeriod,reportSourceBasis,selectedSourceBasis,basisConflict,periodConflict,
    detectedAccountRows:accountRows.length,controlChecks:[],controlFailures:[],structured:true
  };
  if(!selected){
    const detectedAccountLines = new Set(accountRows.map(row => row.line));
    grid.rows.forEach(row => {
      if(detectedAccountLines.has(row.line)) return;
      base.ignored.push({line:row.line,reason:row.line === header.row.line ? "Detected header row" : structuralSourceRowReason(row.cells[header.accountIndex],row.cells[header.descriptionIndex],row),text:row.text});
    });
    return base;
  }

  let currentGroup = "";
  let currentSubgroup = "";
  let groupDetailTotal = 0;
  let subgroupDetailTotal = 0;
  let grandDetailTotal = 0;
  let groupTaxDetailTotal = 0;
  let subgroupTaxDetailTotal = 0;
  let grandTaxDetailTotal = 0;
  const finalControlCandidates = [];
  grid.rows.forEach((item,index) => {
    const account = normalizePasteCell(item.cells[header.accountIndex]);
    const description = normalizePasteCell(item.cells[header.descriptionIndex]);
    if(index <= header.index || item === secondaryRow || item.alignment){
      base.ignored.push({line:item.line,reason:index === header.index ? "Detected header row" : structuralSourceRowReason(account,description,item),text:item.text});
      return;
    }
    const repeatedHeaders = item.cells.map(normalizeHeader);
    const repeatedAccountIndex = findHeader(repeatedHeaders,["account number","gl account","account","account code"]);
    const repeatedDescriptionIndex = findHeader(repeatedHeaders,["account description","account name","description","name"]);
    if(repeatedAccountIndex >= 0 && repeatedDescriptionIndex >= 0 && repeatedAccountIndex !== repeatedDescriptionIndex){
      const repeatedAmountHeader = normalizeHeader(item.cells[selected.index]);
      const selectedPrimaryHeader = normalizeHeader(String(selected.label).split("|")[0]);
      if(repeatedAccountIndex !== header.accountIndex || repeatedDescriptionIndex !== header.descriptionIndex || (repeatedAmountHeader && repeatedAmountHeader !== selectedPrimaryHeader)){
        base.rejected.push({line:item.line,reason:"A repeated header changed the report's column layout. Split the source into consistent sections or re-export it before importing.",text:item.text});
      }else{
        base.ignored.push({line:item.line,reason:"Repeated header row",text:item.text});
      }
      return;
    }
    if(/^group\s*:/i.test(account)){
      currentGroup = [account.replace(/^group\s*:\s*/i,"").trim(),description].filter(Boolean).join(" | ");
      currentSubgroup = "";
      groupDetailTotal = 0;
      subgroupDetailTotal = 0;
      groupTaxDetailTotal = 0;
      subgroupTaxDetailTotal = 0;
      base.ignored.push({line:item.line,reason:"Group heading",text:item.text});
      return;
    }
    if(/^subgroup\s*:/i.test(account)){
      currentSubgroup = [account.replace(/^subgroup\s*:\s*/i,"").trim(),description].filter(value => value && !/^none$/i.test(value)).join(" | ");
      subgroupDetailTotal = 0;
      subgroupTaxDetailTotal = 0;
      base.ignored.push({line:item.line,reason:"Subgroup heading",text:item.text});
      return;
    }
    if(/^subtotal(?:\s|:|\[|$)/i.test(account)){
      const control = parseAmountResult(normalizePasteCell(item.cells[selected.index]));
      if(control.ok) base.controlChecks.push({line:item.line,type:"Subgroup subtotal",label:[account,description].filter(Boolean).join(" | "),sourceAmount:control.value,detailAmount:subgroupDetailTotal,difference:subgroupDetailTotal-control.value});
      if(selectedTax){
        const taxControl = parseAmountResult(normalizePasteCell(item.cells[selectedTax.index]));
        if(taxControl.ok) base.controlChecks.push({line:item.line,type:"Subgroup subtotal · Federal tax",label:[account,description].filter(Boolean).join(" | "),sourceAmount:taxControl.value,detailAmount:subgroupTaxDetailTotal,difference:subgroupTaxDetailTotal-taxControl.value});
      }
      subgroupDetailTotal = 0;
      subgroupTaxDetailTotal = 0;
      base.ignored.push({line:item.line,reason:"Subtotal or total",text:item.text});
      return;
    }
    if(/^grand total(?:\s|:|\[|$)/i.test(account)){
      const control = parseAmountResult(normalizePasteCell(item.cells[selected.index]));
      const taxControl = selectedTax ? parseAmountResult(normalizePasteCell(item.cells[selectedTax.index])) : null;
      finalControlCandidates.push({line:item.line,type:"Grand total",label:[account,description].filter(Boolean).join(" | "),control,taxControl,text:item.text,ignoredReason:"Subtotal or total"});
      return;
    }
    const finalControlLabel = finalPopulationControlLabel(account,description);
    if(finalControlLabel){
      const control = parseAmountResult(normalizePasteCell(item.cells[selected.index]));
      const taxControl = selectedTax ? parseAmountResult(normalizePasteCell(item.cells[selectedTax.index])) : null;
      finalControlCandidates.push({line:item.line,type:"Final population total",label:finalControlLabel,control,taxControl,text:item.text,ignoredReason:"Final population control"});
      return;
    }
    if(/^total(?:\s|:|\[|$)/i.test(account)){
      const control = parseAmountResult(normalizePasteCell(item.cells[selected.index]));
      if(control.ok) base.controlChecks.push({line:item.line,type:"Group total",label:[account,description].filter(Boolean).join(" | "),sourceAmount:control.value,detailAmount:groupDetailTotal,difference:groupDetailTotal-control.value});
      if(selectedTax){
        const taxControl = parseAmountResult(normalizePasteCell(item.cells[selectedTax.index]));
        if(taxControl.ok) base.controlChecks.push({line:item.line,type:"Group total · Federal tax",label:[account,description].filter(Boolean).join(" | "),sourceAmount:taxControl.value,detailAmount:groupTaxDetailTotal,difference:groupTaxDetailTotal-taxControl.value});
      }
      groupDetailTotal = 0;
      subgroupDetailTotal = 0;
      groupTaxDetailTotal = 0;
      subgroupTaxDetailTotal = 0;
      base.ignored.push({line:item.line,reason:"Subtotal or total",text:item.text});
      return;
    }
    if(!looksLikeSourceAccount(account) || !description){
      const reason = structuralSourceRowReason(account,description,item);
      const possibleAmount = parseAmountResult(normalizePasteCell(item.cells[selected.index]));
      if(looksLikeSourceAccount(account) && !description){
        base.rejected.push({line:item.line,reason:"Account description is blank for this account row.",text:item.text});
      }else if(reason === "Report structure" && account && description && possibleAmount.ok){
        base.rejected.push({line:item.line,reason:"This numeric row was not recognized as either an account or a known heading/total. Review its account identifier before importing.",text:item.text});
      }else{
        base.ignored.push({line:item.line,reason,text:item.text});
      }
      return;
    }
    const amountText = normalizePasteCell(item.cells[selected.index]);
    const parsed = parseAmountResult(amountText);
    if(!parsed.ok){
      base.rejected.push({line:item.line,reason:parsed.blank ? `The selected amount column '${selected.label}' is blank for this account.` : `Source amount '${amountText}' is not valid.`,text:item.text});
      return;
    }
    const taxAmountText = selectedTax ? normalizePasteCell(item.cells[selectedTax.index]) : "";
    const parsedTax = selectedTax ? parseAmountResult(taxAmountText) : {ok:false,blank:true,value:0};
    if(selectedTax && !parsedTax.ok){
      base.rejected.push({line:item.line,reason:parsedTax.blank ? `The selected federal tax amount column '${selectedTax.label}' is blank for this account.` : `Federal tax amount '${taxAmountText}' is not valid.`,text:item.text});
      return;
    }
    const row = newRow(account,description,amountText,100,true,"",selectedPeriod || reportPeriod,"");
    row.sourceLineNumber = item.line;
    row.sourceAmountHeader = selected.label;
    row.sourceGroup = currentGroup;
    row.sourceSubgroup = currentSubgroup;
    row.sourceFormat = format;
    const contextualSuggestion = classifySourceAccountWithContext(account,description,[currentGroup,currentSubgroup],state.suggestionBasis);
    row.suggestedInputId = contextualSuggestion.inputId;
    row.confidence = contextualSuggestion.confidence;
    row.suggestionReason = contextualSuggestion.reason;
    syncBaseSuggestions(row,true);
    row.sourceAmountBasis = selectedSourceBasis || state.amountBasis;
    if(row.sourceAmountBasis === "book"){
      row.sourceBookHeader = selected.label;
      row.sourceBookAmount = parsed.value;
    }else if(row.sourceAmountBasis === "tax"){
      row.sourceTaxHeader = selected.label;
      row.sourceTaxAmount = parsed.value;
    }
    if(selectedTax){
      row.sourceTaxHeader = selectedTax.label;
      row.sourceTaxAmount = parsedTax.value;
    }
    base.rows.push(row);
    groupDetailTotal += parsed.value;
    subgroupDetailTotal += parsed.value;
    grandDetailTotal += parsed.value;
    if(selectedTax){
      groupTaxDetailTotal += parsedTax.value;
      subgroupTaxDetailTotal += parsedTax.value;
      grandTaxDetailTotal += parsedTax.value;
    }
  });
  const lastAcceptedSourceLine = base.rows.reduce((last,row) => Math.max(last,Number(row.sourceLineNumber || 0)),0);
  finalControlCandidates.forEach(candidate => {
    if(candidate.line < lastAcceptedSourceLine){
      base.rejected.push({line:candidate.line,reason:`The final population control '${candidate.label}' appears before the last account row. Move it to the bottom of the source population or correct the report layout.`,text:candidate.text});
      return;
    }
    if(!candidate.control.ok){
      base.rejected.push({line:candidate.line,reason:`The final population control '${candidate.label}' has no valid amount in '${selected.label}'.`,text:candidate.text});
      return;
    }
    base.controlChecks.push({line:candidate.line,type:candidate.type,label:candidate.label,sourceAmount:candidate.control.value,detailAmount:grandDetailTotal,difference:grandDetailTotal-candidate.control.value});
    if(selectedTax){
      if(!candidate.taxControl || !candidate.taxControl.ok){
        base.rejected.push({line:candidate.line,reason:`The final population control '${candidate.label}' has no valid amount in '${selectedTax.label}'.`,text:candidate.text});
        return;
      }
      base.controlChecks.push({line:candidate.line,type:`${candidate.type} · Federal tax`,label:candidate.label,sourceAmount:candidate.taxControl.value,detailAmount:grandTaxDetailTotal,difference:grandTaxDetailTotal-candidate.taxControl.value});
    }
    base.ignored.push({line:candidate.line,reason:candidate.ignoredReason,text:candidate.text});
  });
  base.controlFailures = base.controlChecks.filter(control => Math.abs(control.difference) >= SOURCE_CONTROL_EPSILON);
  base.net = base.rows.reduce((sum,row) => sum + mapped(row),0);
  base.absolute = base.rows.reduce((sum,row) => sum + Math.abs(mapped(row)),0);
  base.duplicateGroups = duplicateRowGroups(base.rows).length;
  return base;
}

function parsePaste(text){
  return analyzePastedData(text).rows;
}

function threeColumnStructuralReason(account,description,amountText){
  const first = normalizePasteCell(account);
  const second = normalizePasteCell(description);
  const combined = `${first} ${second}`.trim();
  if(!combined && !normalizePasteCell(amountText)) return "Blank row";
  if(!combined && /^(?:\d{1,2}\/\d{1,2}\/\d{2,4}|\d{4}-\d{1,2}-\d{1,2})$/.test(normalizePasteCell(amountText))) return "Date header";
  if(/^(?:client|engagement|period ending|trial balance|workpaper)\s*:/i.test(first)) return "Report metadata";
  if(/^group\s*:/i.test(first)) return "Group title";
  if(/^subgroup\s*:/i.test(first)) return "Subgroup title";
  if(/^(?:subtotal|total|grand total)(?:\s|:|\[|$)/i.test(first)) return "Subtotal or total";
  if(/^sum of (?:all )?(?:account groups?|accounts?|detail accounts?)/i.test(first)) return "Report control";
  if(/^net\s*\(?income\)?\s*(?:\/|or)?\s*\(?loss\)?/i.test(first)) return "Report control";
  if(/^page\s+\d+/i.test(first)) return "Page heading";
  return "";
}

function analyzeThreeColumnPastedData(text){
  const raw = String(text || "");
  const physicalLines = raw.split(/\r\n|[\n\r\u2028\u2029]/).filter(line => line.trim());
  let records = physicalLines.map((line,index) => ({line:index+1,text:line,cells:splitPasteLine(line).map(normalizePasteCell)}));
  if(records.length === 1 && records[0].cells.length > 3 && records[0].cells.length % 3 === 0){
    const flat = records[0].cells;
    records = [];
    for(let index=0;index<flat.length;index+=3){
      const cells = flat.slice(index,index+3);
      records.push({line:index/3+1,text:cells.join("\t"),cells});
    }
  }
  const empty = {rows:[],rejected:[],ignored:[],hasHeader:false,headerError:false,net:0,absolute:0,duplicateGroups:0,amountColumnLabel:"Amount",amountCandidates:[],selectedAmountColumnKey:"2",recommendedAmountColumnKey:"2",needsAmountSelection:false,taxAmountCandidates:[],selectedTaxAmountColumnKey:"",recommendedTaxAmountColumnKey:"",needsTaxAmountSelection:false,taxAmountColumnLabel:"Not applicable",sourceFormat:"Three-column account list",structured:false,reportPeriod:"",reportSourceBasis:state.amountBasis,selectedSourceBasis:state.amountBasis,basisConflict:false,periodConflict:false,detectedAccountRows:0,controlChecks:[],controlFailures:[]};
  if(!records.length) return empty;
  const first = records[0].cells.map(normalizeHeader);
  const hasHeader = first.length === 3
    && /^(?:account|account number|account code|gl account|acct)$/.test(first[0])
    && /^(?:description|account description|account name|name)$/.test(first[1])
    && !parseAmountResult(records[0].cells[2]).ok;
  const rows = [];
  const rejected = [];
  const ignored = hasHeader ? [{line:records[0].line,reason:"Column header",text:records[0].text}] : [];
  records.slice(hasHeader ? 1 : 0).forEach(item => {
    if(item.cells.length !== 3){
      rejected.push({line:item.line,reason:`Paste exactly three columns. This row contains ${item.cells.length}.`,text:item.text});
      return;
    }
    const [account,description,amountText] = item.cells;
    const normalizedAccount = normalizeHeader(account);
    const normalizedDescription = normalizeHeader(description);
    const repeatedHeader = /^(?:account|account number|account code|gl account|acct)$/.test(normalizedAccount)
      && /^(?:description|account description|account name|name)$/.test(normalizedDescription)
      && !parseAmountResult(amountText).ok;
    if(repeatedHeader){
      ignored.push({line:item.line,reason:"Repeated column header",text:item.text});
      return;
    }
    const structuralReason = threeColumnStructuralReason(account,description,amountText);
    if(structuralReason){
      ignored.push({line:item.line,reason:structuralReason,text:item.text});
      return;
    }
    if(!account || !description){
      rejected.push({line:item.line,reason:"Account and Description are required.",text:item.text});
      return;
    }
    const parsed = parseAmountResult(amountText);
    if(!parsed.ok){
      rejected.push({line:item.line,reason:parsed.blank ? "Amount is blank." : `Amount '${amountText}' is not valid.`,text:item.text});
      return;
    }
    const row = newRow(account,description,amountText,100,true,"","","");
    row.sourceLineNumber = item.line;
    row.sourceAmountHeader = "Amount";
    row.sourceAmountBasis = state.amountBasis;
    row.sourceFormat = "Three-column account list";
    row.sourceOriginalAccount = account;
    row.sourceOriginalDescription = description;
    row.sourceOriginalAmount = parsed.value;
    row.originalAccount = account;
    row.originalDescription = description;
    row.originalAmount = parsed.value;
    row.parseOk = true;
    rows.push(row);
  });
  return {...empty,rows,rejected,ignored,hasHeader,headerLine:hasHeader ? records[0].line : null,detectedAccountRows:rows.length,net:rows.reduce((sum,row)=>sum+mapped(row),0),absolute:rows.reduce((sum,row)=>sum+Math.abs(mapped(row)),0),duplicateGroups:duplicateRowGroups(rows).length};
}

function analyzePastedData(text,options={}){
  return analyzeThreeColumnPastedData(text);
  const requestedAmountColumnKey = typeof options === "string" ? options : String(options.amountColumnKey || "");
  const requestedTaxAmountColumnKey = typeof options === "object" ? String(options.taxAmountColumnKey || "") : "";
  const grid = parsePasteGrid(text);
